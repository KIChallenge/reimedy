      <metadaten titrvo="Satzung des Dachverbandes 2020" abkrvo="Satzung DVSV 2020" dokart="Satzung" titaen="Satzung des Dachverbandes 2020 StF" abkaen="Satzung DVSV 2020 StF " urheber="DVSV" beschdat="2020-03-18" pubdat="2020-04-08" ikra="2020-04-09" sichtbarkeit="p" gldart="PARA" gldnr="5" gldsort="80">
        <puborgane><puborgan puborg="avsv" nrpuborg="48" begseite="1" jahrgang="2020">avsv   Nr. 48/2020 , S.1</puborgan>
        
          </puborgane>
