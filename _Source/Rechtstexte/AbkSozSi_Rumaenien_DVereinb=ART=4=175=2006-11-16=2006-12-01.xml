<nutzdaten>
<abschnitt>
<ueberschrift widowctrl="1" keepwithnext="1" halign="c" level="1" typ="g1">ABSCHNITT III 
<br/>BESONDERE BESTIMMUNGEN</ueberschrift>
<ueberschrift widowctrl="1" keepwithnext="1" halign="c" level="2" typ="g2">Kapitel 1 
<br/>Krankheit und Mutterschaft</ueberschrift>
<ueberschrift widowctrl="1" keepwithnext="1" halign="c" level="3" typ="para">Zusammenrechnung der Versicherungszeiten</ueberschrift>
<absatz typ="satz" widowctrl="1" keepwithnext="0" halign="j">
<gldsym>Artikel 4</gldsym>
</absatz>
<absatz typ="abs" widowctrl="1" keepwithnext="0" halign="j">(1) Für die Anwendung des <rvolink ursprung="u" abkrvo="AbkSozSi Rumänien" verwart="d" gldart="ART" gldsort="80" gldnr="10" typ="e">Artikels 10</rvolink> des Abkommens durch einen Träger eines Vertragsstaates hat die betreffende Person eine Bescheinigung über die nach den Rechtsvorschriften des anderen Vertragsstaates erworbenen Versicherungszeiten vorzulegen. Legt die betreffende Person die Bescheinigung nicht vor, so kann der zuständige Träger den Träger des anderen Vertragsstaates um Ausstellung und Übersendung der Bescheinigung ersuchen.</absatz>
<absatz typ="abs" widowctrl="1" keepwithnext="0" halign="j">(2) Die Bescheinigung nach Absatz 1 ist auszustellen</absatz>
<absatz typ="satz" widowctrl="1" keepwithnext="0" halign="j">in der Republik Österreich</absatz>
<absatz typ="abs" widowctrl="1" keepwithnext="0" halign="j">vom Träger der Krankenversicherung;</absatz>
<absatz typ="satz" widowctrl="1" keepwithnext="0" halign="j">in Rumänien</absatz>
<absatz typ="abs" widowctrl="1" keepwithnext="0" halign="j">von der Nationalen Kasse für Pensionen und sonstige Sozialversicherungsansprüche.</absatz>
</abschnitt>
</nutzdaten>
