<abschnitt>
<ueberschrift level="3" halign="c" typ="para">Organe</ueberschrift>
<absatz typ="abs" halign="j">
<gldsym>§ 3.</gldsym> (1) Die Organe des Arbeitsmarktservice im Bereich der Bundesorganisation des Arbeitsmarktservice sind</absatz>
<liste>
<ziffernliste ebene="1">
<listelem>
<symbol stellen="2">1.</symbol>der Verwaltungsrat,</listelem>
<listelem>
<symbol stellen="2">2.</symbol>der Vorstand.</listelem>
</ziffernliste>
</liste>
<absatz typ="abs" halign="j">(2) Die Organe des Arbeitsmarktservice im Bereich der Landesorganisationen des Arbeitsmarktservice sind</absatz>
<liste>
<ziffernliste ebene="1">
<listelem>
<symbol stellen="2">1.</symbol>das Landesdirektorium,</listelem>
<listelem>
<symbol stellen="2">2.</symbol>der Landesgeschäftsführer.</listelem>
</ziffernliste>
</liste>
<absatz typ="abs" halign="j">(3) Die Organe des Arbeitsmarktservice im Bereich der regionalen Organisationen sind</absatz>
<liste>
<ziffernliste ebene="1">
<listelem>
<symbol stellen="2">1.</symbol>der Regionalbeirat,</listelem>
<listelem>
<symbol stellen="2">2.</symbol>der Leiter der regionalen Geschäftsstelle.</listelem>
</ziffernliste>
</liste>
</abschnitt>
</nutzdaten>
