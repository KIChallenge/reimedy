          <ueberschrift typ="para" halign="c" widowctrl="1" keepwithnext="0" level="1">Artikel VI <br/>Inkrafttreten und Vollziehung</ueberschrift><absatz typ="abs"><gldsym>Art. VI</gldsym></absatz>
        <absatz typ="abs" halign="j">(1) Dieses Bundesgesetz tritt mit 1. Juli 1990 in Kraft.</absatz>
          <absatz typ="abs" halign="j">(2) Mit der Vollziehung sind betraut:</absatz>
          <liste>
            <ziffernliste ebene="1">
              <listelem>
                <symbol stellen="2">1.</symbol>hinsichtlich Artikel I § 4, § 11 Abs. 1 Satz 1 und 2 sowie Abs. 2 und § 12 Abs. 2 der Bundesminister für Justiz;</listelem>
              <listelem>
                <symbol stellen="2">2.</symbol>hinsichtlich Artikel I § 11 Abs. 3 der Bundesminister für Finanzen;</listelem>
              <listelem>
                <symbol stellen="2">3.</symbol>hinsichtlich aller übrigen Bestimmungen dieses Bundesgesetzes der Bundesminister für Arbeit und Soziales.</listelem>
            </ziffernliste>
          </liste></abschnitt></nutzdaten>
