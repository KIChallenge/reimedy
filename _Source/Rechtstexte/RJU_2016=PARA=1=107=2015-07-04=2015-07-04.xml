      <metadaten gldart="PARA" gldsort="70" nichtanzeigen="n" titrvo="Richtlinien für die Durchführung und Auswertung der Jugendlichenuntersuchungen 2016" abkrvo="RJU 2016" dokart="RL DVSV" titaen="Richtlinien für die Durchführung und Auswertung der Jugendlichenuntersuchungen 2016 StF" abkaen="RJU 2016 StF" urheber="DVSV" beschdat="2015-06-09" pubdat="2015-07-04" ikra="2015-07-04" sichtbarkeit="p" gldnr="1">
