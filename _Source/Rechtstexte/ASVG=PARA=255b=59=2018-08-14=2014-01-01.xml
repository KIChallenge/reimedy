<durchfv><rvolink ursprung="u" abkrvo="RGZ 2005" verwart="d" typ="e">RGZ 2005</rvolink></durchfv><puborgane><puborgan puborg="BGBl." gldpuborg="I" nrpuborg="59" begseite="6" jahrgang="2018"/></puborgane></metadaten>
