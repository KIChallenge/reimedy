      <nutzdaten>
        <abschnitt nr="1" typ="ns" paperf="h" endnhier="true">
          <ueberschrift typ="para" halign="c" level="1">Auswertungen der Leistungsinformationen für Versicherte (LIVE)</ueberschrift>
          <absatz typ="abs" halign="j">
            <gldsym>§ 12.</gldsym> (1) Jährlich sind Auswertungen der Leistungsinformationen für Versicherte (<rvolink abkrvo="ASVG" verwart="d" typ="e" gldart="PARA" gldsort="80" gldnr="81" ursprung="u">§ 81</rvolink><nolink> ASVG</nolink> und <rvolink abkrvo="B-KUVG" verwart="d" typ="e" gldart="PARA" gldsort="80" gldnr="27" ursprung="u">§ 27</rvolink> BKUVG) aus der zentralen Leistungsdatenbank des Dachverbandes durchzuführen.</absatz>
          <absatz typ="abs" halign="j">(2) Die Auswertungen sind insbesondere alters­ und 
geschlechtsspezifisch zu gliedern.</absatz>
          <absatz typ="abs" halign="j">(3) Die Auswertungen sind spätestens bis zum 31. Oktober des folgenden Jahres durchzuführen.</absatz>
          
        </abschnitt>
