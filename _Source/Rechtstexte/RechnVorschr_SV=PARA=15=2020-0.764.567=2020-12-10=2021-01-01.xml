<nutzdaten>
<abschnitt>
<ueberschrift level="3" halign="c" typ="para">GLIEDERUNG IN DER SCHLUSSBILANZ</ueberschrift>
<absatz typ="abs" halign="j">
<gldsym>§ 15.</gldsym> In der Schlussbilanz sind folgende Posten gesondert auszuweisen:</absatz>
<absatz typ="satz" halign="j">A. Auf der Aktivseite:</absatz>
<liste>
<ziffernliste ebene="1">
<listelem>
<symbol stellen="2">I.</symbol>Anlagevermögen:</listelem>
</ziffernliste>
<ziffernliste ebene="2">
<listelem>
<symbol stellen="2">1.</symbol>Immobilien:</listelem>
</ziffernliste>
<literaliste ebene="3">
<listelem>
<symbol stellen="2">a)</symbol>unbebaute Grundstücke, </listelem>
<listelem>
<symbol stellen="2">b)</symbol>bebaute Grundstücke;</listelem>
</literaliste>
<ziffernliste ebene="2">
<listelem>
<symbol stellen="2">2.</symbol>Mobilien:</listelem>
</ziffernliste>
<literaliste ebene="3">
<listelem>
<symbol stellen="2">a)</symbol>Einrichtungen und Geräte,</listelem>
<listelem>
<symbol stellen="2">b)</symbol>Maschinen und Apparate,</listelem>
<listelem>
<symbol stellen="2">c)</symbol>Fahrzeuge;</listelem>
</literaliste>
<ziffernliste ebene="2">
<listelem>
<symbol stellen="2">3.</symbol>Darlehen und Hypothekardarlehen;</listelem>
<listelem>
<symbol stellen="2">4.</symbol>Wertpapiere;</listelem>
<listelem>
<symbol stellen="2">5.</symbol>sonstiges.</listelem>
</ziffernliste>
<ziffernliste ebene="1">
<listelem>
<symbol stellen="3">II.</symbol>Umlaufvermögen:</listelem>
</ziffernliste>
<ziffernliste ebene="2">
<listelem>
<symbol stellen="2">1.</symbol>Vorräte;</listelem>
<listelem>
<symbol stellen="2">2.</symbol>Beitragsforderungen:</listelem>
</ziffernliste>
<literaliste ebene="3">
<listelem>
<symbol stellen="2">a)</symbol>für eigene Rechnung, </listelem>
<listelem>
<symbol stellen="2">b)</symbol>für fremde Rechnung;</listelem>
</literaliste>
<ziffernliste ebene="2">
<listelem>
<symbol stellen="2">3.</symbol>Treuhandforderungen;</listelem>
<listelem>
<symbol stellen="2">4.</symbol>Ersatzforderungen;</listelem>
<listelem>
<symbol stellen="2">5.</symbol>sonstige Forderungen;</listelem>
<listelem>
<symbol stellen="2">6.</symbol>gebundene Einlagen bei Geldinstituten;</listelem>
<listelem>
<symbol stellen="2">7.</symbol>kurzfristige Einlagen:</listelem>
</ziffernliste>
<literaliste ebene="3">
<listelem>
<symbol stellen="2">a)</symbol>bei Geldinstituten, </listelem>
<listelem>
<symbol stellen="2">b)</symbol>sonstigen;</listelem>
</literaliste>
<ziffernliste ebene="2">
<listelem>
<symbol stellen="2">8.</symbol>Barbestände.</listelem>
</ziffernliste>
<ziffernliste ebene="1">
<listelem>
<symbol stellen="4">III.</symbol>Aktive Rechnungsabgrenzung.</listelem>
<listelem>
<symbol stellen="4">IV.</symbol>Ungedeckte Allgemeine Rücklage.</listelem></ziffernliste>
</liste>
<absatz typ="satz" halign="j">B. Auf der Passivseite:</absatz>
<liste>
<ziffernliste ebene="1">
<listelem>
<symbol stellen="2">I.</symbol>Reinvermögen:</listelem>
</ziffernliste>
<ziffernliste ebene="2">
<listelem>
<symbol stellen="2">1.</symbol>allgemeine Rücklage;</listelem>
<listelem>
<symbol stellen="2">2.</symbol>Leistungssicherungsrücklage;</listelem>
<listelem>
<symbol stellen="2">3.</symbol>besondere Rücklagen:</listelem>
</ziffernliste>
<literaliste ebene="3">
<listelem>
<symbol stellen="2">a)</symbol>Unterstützungsfonds,</listelem>
<listelem>
<symbol stellen="2">b)</symbol>Ersatzbeschaffungsrücklage,</listelem>
<listelem>
                <symbol stellen="3">c)</symbol>Innovations- und Zielsteuerungsfonds (gilt nur für die Österreichische Gesundheitskasse),</listelem>
              <listelem>
                <symbol stellen="2">d)</symbol>Jungfamilienfonds (gilt nur für die Sozialversicherungsanstalt der Selbständigen).</listelem></literaliste>
<ziffernliste ebene="1">
<listelem>
<symbol stellen="3">II.</symbol>Langfristige Verbindlichkeiten.</listelem>
<listelem>
<symbol stellen="4">III.</symbol>Wertberichtigungen:</listelem>
</ziffernliste>
<ziffernliste ebene="2">
<listelem>
<symbol stellen="2">1.</symbol>zum Anlagevermögen,</listelem>
<listelem>
<symbol stellen="2">2.</symbol>zum Umlaufvermögen.</listelem>
</ziffernliste>
<ziffernliste ebene="1">
<listelem>
<symbol stellen="3">IV.</symbol>Kurzfristige Verbindlichkeiten:</listelem>
</ziffernliste>
<ziffernliste ebene="2">
<listelem>
<symbol stellen="2">1.</symbol>Schulden an Beiträgen für fremde Rechnung:</listelem>
</ziffernliste>
<literaliste ebene="3">
<listelem>
<symbol stellen="2">a)</symbol>Treuhandschulden,</listelem>
<listelem>
<symbol stellen="2">b)</symbol>ausstehende fremde Beträge;</listelem>
</literaliste>
<ziffernliste ebene="2">
<listelem>
<symbol stellen="2">2.</symbol>unberichtigte Versicherungsleistungen;</listelem>
<listelem>
<symbol stellen="2">3.</symbol>sonstige Verbindlichkeiten.</listelem>
</ziffernliste>
<ziffernliste ebene="1">
<listelem>
<symbol stellen="2">V.</symbol>Passive Rechnungsabgrenzung.</listelem>
</ziffernliste>
</liste>
</abschnitt>
