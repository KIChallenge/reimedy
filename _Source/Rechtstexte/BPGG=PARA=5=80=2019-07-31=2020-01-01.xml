              <listelem>
                <symbol stellen="2"> </symbol>in Stufe 3 ...............................................  <rvolink ursprung="u" abkrvo="verändW" verwart="d" gldart="ZAHL" gldsort="140" gldnr="54" typ="e">451,80 Euro</rvolink>,</listelem>
              <listelem>
                <symbol stellen="2"> </symbol>in Stufe 4 ...............................................  <rvolink ursprung="u" abkrvo="verändW" verwart="d" gldart="ZAHL" gldsort="140" gldnr="54" typ="e">677,60 Euro</rvolink>,</listelem>
