<abschnitt nr="1" typ="ns" paperf="h" endnhier="true">
<absatz typ="abs" halign="j">
<gldsym>§ 10.</gldsym> (1) Als Verwaltungskosten für die Beitragseinhebung gelten</absatz>
<liste>
<ziffernliste ebene="1">
<listelem>
<symbol stellen="2">1.</symbol>für die Einhebung von Arbeitslosenversicherungsbeiträgen und Sonderbeiträgen gemäß <rvolink abkrvo="Einhebungsverordnung" verwart="d" typ="e" gldart="PARA" gldsort="70" gldnr="1" ursprung="u">§ 1</rvolink> die Verwaltungskosten der Träger der Krankenversicherung für den Melde-, Versicherungs- und Beitragsbereich;</listelem>
<listelem>
<symbol stellen="2">2.</symbol>für die Einhebung von Zuschlägen gemäß <rvolink abkrvo="Einhebungsverordnung" verwart="d" typ="e" gldart="PARA" gldsort="70" gldnr="2" ursprung="u">§ 2</rvolink> die entsprechenden Verwaltungskosten der Träger der Krankenversicherung.</listelem>
</ziffernliste>
</liste>
<absatz typ="abs" halign="j">(2) Die am 1. April 1998 zu entrichtenden Teilbeträge gemäß <rvolink abkrvo="Einhebungsverordnung" verwart="d" typ="e" gldart="PARA" gldsort="70" gldnr="6" ursprung="u">§ 6</rvolink> vermindern sich um die von den Trägern der Krankenversicherung nach dem 31. Dezember 1997</absatz>
<liste>
<ziffernliste ebene="1">
<listelem>
<symbol stellen="2">1.</symbol>von den abgeführten Beiträgen und</listelem>
<listelem>
<symbol stellen="2">2.</symbol>von den abgeführten Zuschlägen</listelem>
</ziffernliste>
<schluss typ="Abs">einbehaltenen Vergütungen.</schluss>
</liste>
<abstand halign="l"/>
</abschnitt>
