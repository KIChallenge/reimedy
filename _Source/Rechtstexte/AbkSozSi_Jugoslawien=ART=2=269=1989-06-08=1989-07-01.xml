<absatz typ="abs" halign="j">(1) Dieses Abkommen bezieht sich 
</absatz>
<liste>
<ziffernliste ebene="1">
<listelem>
<symbol>1.</symbol>in Österreich auf die Rechtsvorschriften über 
</listelem>
</ziffernliste>
<literaliste ebene="2">
<listelem>
<symbol>a)</symbol>die Krankenversicherung, 
</listelem>
<listelem>
<symbol>b)</symbol>die Unfallversicherung, 
</listelem>
<listelem>
<symbol>c)</symbol>die Pensionsversicherung, 
<nolink>
