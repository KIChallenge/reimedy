<uebrecht><rvolink ursprung="u" abkrvo="RVU" verwart="s" gldart="PARA" gldsort="70" gldnr="13" abs="5" pubdat="2013-10-03" ikra="2013-10-02" puborg="avsv" nrpuborg="93" jahrgang="2013" typ="e">§ 13 Abs. 5 RVU in der Fassung avsv Nr. 93/2013)</rvolink></uebrecht><anm>Zum Inkrafttreten: siehe <rvolink ursprung="u" abkrvo="RVU" verwart="s" gldart="PARA" gldsort="70" gldnr="13" abs="5" pubdat="2013-10-03" ikra="2013-10-02" puborg="avsv" nrpuborg="93" jahrgang="2013" typ="e">§ 13 Abs. 5 RVU in der Fassung avsv Nr. 93/2013</rvolink></anm><puborgane><puborgan puborg="avsv" nrpuborg="41" jahrgang="2025"/></puborgane></metadaten>
