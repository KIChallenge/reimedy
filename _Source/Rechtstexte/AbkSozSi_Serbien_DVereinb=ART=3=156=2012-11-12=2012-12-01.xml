      <metadaten nichtanzeigen="n" titrvo="Durchführungsvereinbarung Serbien" abkrvo="AbkSozSi Serbien DVereinb" dokart="SVAbk" titaen="Vereinbarung zur Durchführung des Abkommens zwischen der Republik Österreich und der Republik Serbien StF" abkaen="AbkSozSi Serbien DVereinb StF" urheber="Bund" pubdat="2012-11-12" ikra="2012-12-01" sichtbarkeit="p" gldart="ART" gldnr="3" gldsort="80">
        <schlagw><textelem>Serbien</textelem></schlagw><puborgane>
          <puborgan puborg="BGBl." gldpuborg="III" nrpuborg="156" jahrgang="2012">BGBl. III  Nr. 156/2012 </puborgan>
