<abschnitt>
<ueberschrift level="2" halign="c" typ="para">BEGINN UND ENDE DER AUFBEWAHRUNGSFRISTEN</ueberschrift>
<absatz typ="abs" halign="j">
<gldsym>§ 59.</gldsym> Die Aufbewahrungsfrist für die im 
<rvolink abkrvo="RechnVorschr SV" verwart="d" typ="e" gldart="PARA" gldsort="70" gldnr="58" abs="1" lit="a" ursprung="u">§ 58 Abs. 1 lit. a</rvolink>, 
<rvolink abkrvo="RechnVorschr SV" verwart="d" typ="e" gldart="PARA" gldsort="70" gldnr="58" abs="1" lit="g" ursprung="u">g</rvolink>, 
<rvolink abkrvo="RechnVorschr SV" verwart="d" typ="e" gldart="PARA" gldsort="70" gldnr="58" abs="1" lit="j" ursprung="u">j</rvolink>, 
<rvolink abkrvo="RechnVorschr SV" verwart="d" typ="e" gldart="PARA" gldsort="70" gldnr="58" abs="1" lit="l" ursprung="u">l</rvolink> und 
<rvolink abkrvo="RechnVorschr SV" verwart="d" typ="e" gldart="PARA" gldsort="70" gldnr="58" abs="1" lit="o" ursprung="u">o</rvolink> angeführten Unterlagen beginnt mit dem Ende des Geschäftsjahres auf das sie sich beziehen. Für die im 
<rvolink abkrvo="RechnVorschr SV" verwart="d" typ="e" gldart="PARA" gldsort="70" gldnr="58" abs="1" lit="b" ursprung="u">§ 58 Abs. 1 lit. b</rvolink>, 
<rvolink abkrvo="RechnVorschr SV" verwart="d" typ="e" gldart="PARA" gldsort="70" gldnr="58" abs="1" lit="c" ursprung="u">c</rvolink>, 
<rvolink abkrvo="RechnVorschr SV" verwart="d" typ="e" gldart="PARA" gldsort="70" gldnr="58" abs="1" lit="e" ursprung="u">e</rvolink>, 
<rvolink abkrvo="RechnVorschr SV" verwart="d" typ="e" gldart="PARA" gldsort="70" gldnr="58" abs="1" lit="f" ursprung="u">f</rvolink>, 
<rvolink abkrvo="RechnVorschr SV" verwart="d" typ="e" gldart="PARA" gldsort="70" gldnr="58" abs="1" lit="h" ursprung="u">h</rvolink>, 
<rvolink abkrvo="RechnVorschr SV" verwart="d" typ="e" gldart="PARA" gldsort="70" gldnr="58" abs="1" lit="k" ursprung="u">k</rvolink>, 
<rvolink abkrvo="RechnVorschr SV" verwart="d" typ="e" gldart="PARA" gldsort="70" gldnr="58" abs="1" lit="m" ursprung="u">m</rvolink> und 
<rvolink abkrvo="RechnVorschr SV" verwart="d" typ="e" gldart="PARA" gldsort="70" gldnr="58" abs="1" lit="n" ursprung="u">n</rvolink> angeführten Unterlagen beginnt die Aufbewahrungsfrist mit dem Ende des Geschäftsjahres, auf das sich die letzte Eintragung bezieht.</absatz>
</abschnitt>
