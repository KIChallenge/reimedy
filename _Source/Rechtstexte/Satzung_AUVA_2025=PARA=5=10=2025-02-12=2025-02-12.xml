          <ueberschrift typ="g1" halign="c" level="1">Informationsveranstaltungen<br/>(<rvolink abkrvo="ASVG" verwart="d" typ="e" gldart="PARA" gldsort="50" gldnr="453" abs="1" ziff="3" ursprung="u">§ 453 Abs. 1 Z 3</rvolink><nolink> ASVG</nolink>)</ueberschrift>
          <ueberschrift typ="para" halign="c" level="2"/><absatz typ="abs" halign="j">
            <gldsym>§ 5.</gldsym> (1) Die AUVA hält in regelmäßigen Abständen, mindestens einmal im Kalenderjahr, Informationsveranstaltungen für Dienstnehmer und Dienstgeber ab.</absatz>
          <absatz typ="abs" halign="j">(2) Informationsveranstaltungen können auch</absatz>
          <liste>
            <aufzaehlung ebene="1" art="normal">
              <listelem>
                <symbol stellen="2">1.</symbol>für Dienstnehmer und Dienstgeber getrennt,</listelem>
              <listelem>
                <symbol stellen="2">2.</symbol>für bestimmte Regionen (z. B. Landesstellen) oder</listelem>
              <listelem>
                <symbol stellen="2">3.</symbol>zu bestimmten Themenbereichen</listelem>
            </aufzaehlung>
            <schlussteil ebene="0" art="normal">abgehalten werden.</schlussteil>
          </liste>
        </abschnitt>
