      <nutzdaten>
        <abschnitt nr="1" typ="ns" paperf="h" endnhier="true">
          <ueberschrift typ="para" halign="c" level="3">Kostenerstattung für Privatrezepte</ueberschrift>
          <absatz typ="abs" halign="j">
            <gldsym>§ 44.</gldsym> Hat der/die Anspruchsberechtigte das Privatrezept nicht gemäß <rvolink abkrvo="MKO 2016" verwart="d" typ="e" gldart="PARA" gldsort="70" gldnr="43" ursprung="u">§ 43</rvolink> einem Kassenrezept gleichstellen lassen, erstattet die Kasse dem/der Anspruchsberechtigten die Kosten des bezahlten Heilmittels, wenn</absatz>
          <liste>
            <ziffernliste ebene="1">
              <listelem>
                <symbol stellen="2">1.</symbol>die Verordnung nach den Richtlinien über die ökonomische Verschreibweise von Heilmitteln und Heilbehelfen zulässig ist und</listelem>
              <listelem>
                <symbol stellen="2">2.</symbol>die Honorarnote (Rezept) der Kasse übergeben wird.</listelem>
            </ziffernliste>
          </liste>
        </abschnitt>
      </nutzdaten>
