      <metadaten nichtanzeigen="n" titrvo="Sozialversicherungsabkommen Indien" abkrvo="AbkSozSi Indien" dokart="SVAbk" urheber="Bund" beschdat="2013-03-21" pubdat="2015-05-06" ikra="2015-07-01" sichtbarkeit="p" titaen="Abkommen zwischen der Republik Österreich und der Republik Indien über soziale Sicherheit StF" abkaen="AbkSozSi Indien StF" gldart="ART" gldnr="2" gldsort="80">
        <schlagw><textelem>Indien</textelem></schlagw><puborgane><puborgan puborg="BGBl." gldpuborg="III" nrpuborg="60" begseite="1" jahrgang="2015">BGBl. III  Nr. 60/2015 , S.1</puborgan>
          
        </puborgane>
      </metadaten>
      <nutzdaten>
        <abschnitt nr="1" typ="ns" paperf="h" endnhier="true">
          <ueberschrift typ="para" halign="c" level="2">Artikel 2 <br/>Sachlicher Geltungsbereich</ueberschrift>
          
          <absatz typ="abs" halign="j">
            <gldsym>Art. 2</gldsym>
          </absatz><absatz typ="abs" halign="j" widowctrl="1" keepwithnext="0">1. Dieses Abkommen bezieht sich:</absatz><liste>
            
            <literaliste ebene="1">
              <listelem>
                <symbol stellen="2">a)</symbol>in Bezug auf Österreich</listelem>
              <listelem>
                <symbol stellen="2">i)</symbol>auf die Rechtsvorschriften über die Pensionsversicherung mit Ausnahme der Sondervorschriften für das Notariat und</listelem>
              <listelem>
                <symbol stellen="3">ii)</symbol>nur hinsichtlich des Abschnittes II auf die Rechtsvorschriften über die Kranken- und Unfallversicherung;</listelem>
              <listelem>
                <symbol stellen="2">b)</symbol>in Bezug auf Indien auf die Rechtsvorschriften über</listelem>
              <listelem>
                <symbol stellen="2">i)</symbol>die Alters- und Hinterbliebenenrente für Beschäftigte;</listelem>
              <listelem>
                <symbol stellen="3">ii)</symbol>die Rente für Beschäftigte bei dauerhafter und voller Invalidität.</listelem>
            </literaliste>
            
          </liste>
          
        <absatz typ="abs" halign="j" widowctrl="1" keepwithnext="0">2. Dieses Abkommen findet auch auf Rechtsvorschriften Anwendung, die die in Absatz 1 bezeichneten Rechtsvorschriften aufheben, ersetzen, ändern, ergänzen oder zusammenfassen.</absatz></abschnitt>
      </nutzdaten>
