<abschnitt>
<ueberschrift widowctrl="1" keepwithnext="1" halign="c" level="3" typ="para">Träger des Aufenthaltsortes</ueberschrift>
<absatz typ="satz" widowctrl="1" keepwithnext="0" halign="j">
<gldsym>Artikel 13</gldsym>
</absatz>
<absatz typ="abs" widowctrl="1" keepwithnext="0" halign="j">In den Fällen des <rvolink ursprung="u" abkrvo="AbkSozSi Bulgarien" verwart="d" gldart="ART" gldsort="80" gldnr="11" typ="e">Artikels 11</rvolink> werden die Sachleistungen gewährt</absatz>
<absatz typ="satz" widowctrl="1" keepwithnext="0" halign="j">in der Republik Österreich</absatz>
<absatz typ="satz" widowctrl="1" keepwithnext="0" halign="j">von der für den Aufenthaltsort der betreffenden Person in Betracht kommenden Gebietskrankenkasse,</absatz>
<absatz typ="satz" widowctrl="1" keepwithnext="0" halign="j">in der Republik Bulgarien</absatz>
<absatz typ="satz" widowctrl="1" keepwithnext="0" halign="j">von der Nationalen Krankenkasse und/oder dem Nationalen Versicherungsinstitut.</absatz>
</abschnitt>
