<nichtdoknovs><textelem>§ 289: BGBl. I Nr. 5/2001, Art. 4 Z 6 – 9. 1. 2001.</textelem></nichtdoknovs><puborgane><puborgan puborg="BGBl." gldpuborg="I" nrpuborg="5" jahrgang="2001"/>

