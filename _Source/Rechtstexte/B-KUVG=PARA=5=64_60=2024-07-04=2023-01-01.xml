<uebrecht><rvolink ursprung="u" abkrvo="B-KUVG" verwart="s" gldart="PARA" gldsort="70" gldnr="247" pubdat="2016-07-08" ikra="2016-07-09" puborg="BGBl." gldpuborg="I" nrpuborg="53" jahrgang="2016" typ="e">§ 247 idF  BGBl. I Nr. 53/2016</rvolink></uebrecht><anm>Beachte: <rvolink ursprung="u" abkrvo="B-KUVG" verwart="s" gldart="PARA" gldsort="70" gldnr="247" pubdat="2016-07-08" ikra="2016-07-09" puborg="BGBl." gldpuborg="I" nrpuborg="53" jahrgang="2016" typ="e">§ 247 idF  BGBl. I Nr. 53/2016</rvolink> (Anwendung auf Geburten, die nach dem 28. Februar 2017 eintreten).</anm><puborgane><puborgan puborg="BGBl." gldpuborg="I" nrpuborg="64" begseite="3" jahrgang="2024"/><puborgan puborg="BGBl." gldpuborg="I" nrpuborg="60" begseite="18" jahrgang="2022"/></puborgane></metadaten>
