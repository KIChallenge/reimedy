      <nutzdaten>
        <abschnitt nr="1" typ="ns" paperf="h" endnhier="true">
          <ueberschrift typ="g1" halign="c" level="1">ABSCHNITT  IV <br/>LEISTUNGSSTATISTIK</ueberschrift>
          <ueberschrift typ="para" halign="c" level="2"/>
          <absatz typ="abs" halign="j">
            <gldsym>§ 7.</gldsym> (1) Im Rahmen der Leistungsstatistik haben die Unfallversicherungsträger jene Statistiken zu erstellen, die der Erfassung der Leistungen dienen. Die Leistungsstatistik beinhaltet folgende Gruppen von Statistiken:</absatz>
          <liste>
            <aufzaehlung ebene="1" art="normal">
              <listelem>
                <symbol stellen="2">1.</symbol>Unfall-Statistik (<rvolink abkrvo="statWeis UV 2020" verwart="d" typ="e" gldart="PARA" gldsort="80" gldnr="8" bereich="BIS" bis="14" ursprung="u">§§ 8 bis 14</rvolink>)</listelem>
              <listelem>
                <symbol stellen="2">2.</symbol>Rentenstand-Statistik (<rvolink abkrvo="statWeis UV 2020" verwart="d" typ="e" gldart="PARA" gldsort="80" gldnr="15" bereich="BIS" bis="19" ursprung="u">§§ 15 bis 19</rvolink>)</listelem>
              <listelem>
                <symbol stellen="2">3.</symbol>Rentenneuzugang-Statistik (<rvolink abkrvo="statWeis UV 2020" verwart="d" typ="e" gldart="PARA" gldsort="80" gldnr="20" bereich="BIS" bis="22" ursprung="u">§§ 20 bis 22</rvolink>)</listelem>
              <listelem>
                <symbol stellen="2">4.</symbol>Sonstige Statistiken (<rvolink abkrvo="statWeis UV 2020" verwart="d" typ="e" gldart="PARA" gldsort="80" gldnr="23" bereich="BIS" bis="24" ursprung="u">§§ 23 bis 24</rvolink>)</listelem>
            </aufzaehlung>
          </liste>
          <absatz typ="abs" halign="j">(2) Spätester Vorlagetermin ist der 31. Mai des dem Berichtsjahr folgenden Jahres.</absatz>
        </abschnitt>
