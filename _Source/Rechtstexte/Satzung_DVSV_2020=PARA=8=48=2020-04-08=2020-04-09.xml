      <nutzdaten>
        <abschnitt nr="1" typ="ns" paperf="h" endnhier="true">
          <ueberschrift typ="para" halign="c" level="1">Geschäftsführung</ueberschrift>
          <absatz typ="abs" halign="j">
            <gldsym>§ 8.</gldsym> (1) Die Geschäfte des Dachverbandes werden von der Konferenz (<rvolink abkrvo="ASVG" verwart="d" typ="e" gldart="PARA" gldsort="80" gldnr="441c" ursprung="u">§ 441c</rvolink><nolink> ASVG</nolink>) geführt, soweit sie nicht ausdrücklich der Hauptversammlung zugewiesen sind (<rvolink abkrvo="ASVG" verwart="d" typ="e" gldart="PARA" gldsort="80" gldnr="441d" ursprung="u">§ 441d</rvolink><nolink> ASVG</nolink>).</absatz>
          <absatz typ="abs" halign="j">(2) Ob und welche Geschäftsführungsaufgaben an das Büro übertragen sind, wird durch den Anhang zur Geschäftsordnung der Konferenz (<rvolink abkrvo="ASVG" verwart="d" typ="e" gldart="PARA" gldsort="80" gldnr="456a" abs="3" ursprung="u">§ 456a Abs. 3</rvolink> und <rvolink abkrvo="ASVG" verwart="d" typ="e" gldart="PARA" gldsort="80" gldnr="456a" abs="5" ursprung="u">5</rvolink><nolink> ASVG</nolink>) bestimmt.</absatz>
        </abschnitt>
      </nutzdaten>
