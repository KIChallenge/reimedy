      <nutzdaten>
        <abschnitt nr="1" typ="ns" paperf="h" endnhier="true">
          <ueberschrift typ="para" halign="c" level="3" widowctrl="1">Artikel 14 <br/>Träger des Aufenthalts- oder Wohnortes</ueberschrift>
          
          <absatz typ="abs" halign="j">
            <gldsym>Art. 14</gldsym>
          </absatz><absatz typ="abs" halign="j">In den Fällen des <rvolink ursprung="u" abkrvo="AbkSozSi Serbien" verwart="d" gldart="ART" gldsort="80" gldnr="11" abs="1" typ="e">Artikels 11 Absatz 1</rvolink> des Abkommens und des <rvolink ursprung="u" abkrvo="AbkSozSi Serbien" verwart="d" gldart="ART" gldsort="80" gldnr="13" abs="2" typ="e">Artikels 13 Absatz 2</rvolink> des Abkommens werden die Leistungen gewährt</absatz>
          <liste>
            <literaliste ebene="2">
              <listelem>
                <symbol stellen="2">a)</symbol>in der Republik Österreich</listelem>
            </literaliste>
            <schluss typ="Lit">von der für den Aufenthalts- oder Wohnort der betreffenden Person in Betracht kommenden Gebietskrankenkasse,</schluss>
            <literaliste ebene="2">
              <listelem>
                <symbol stellen="2">b)</symbol>in der Republik Serbien</listelem>
            </literaliste>
            <schluss typ="Lit">von der für den Aufenthalts- oder Wohnort der betreffenden Person in Betracht kommenden Organisationseinheit des Krankenversicherungsträgers.</schluss>
          </liste>
          
        </abschnitt>
      </nutzdaten>
