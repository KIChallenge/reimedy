<abschnitt>
<absatz typ="abs" halign="j">
<gldsym>§ 50f.</gldsym> (1) § 8 Abs. 2 erster Satz und Abs. 3 erster Halbsatz in
der Fassung des Bundesgesetzes BGBl. Nr. 297/1995 tritt mit 1. Mai
1995 in Kraft.
  </absatz>
<absatz typ="abs" halign="j">(2) Die §§ 31 Abs. 1, 31a Abs. 5 und 6, 31b Abs. 2, 31c Abs. 1,
Abs. 2 und 3, 31e, 31g sowie 31h in der Fassung des Bundesgesetzes
BGBl. Nr. 297/1995 treten mit 1. August 1995 in Kraft.
  </absatz>
<absatz typ="abs" halign="j">(3) Die §§ 30b Abs. 1 erster Satz, 30c Abs. 3 erster Satz, 30e
Abs. 3, 30f Abs. 1, 30f Abs. 2 erster Satz, 30f Abs. 3 und 4, 30g
Abs. 1 und 2, 30j Abs. 1, 30k Abs. 1, 30m Abs. 3 und 5 sowie 30p
Abs. 1 dritter Satz in der Fassung des Bundesgesetzes BGBl. Nr.
297/1995 treten mit 1. September 1995 in Kraft.
  </absatz>
<absatz typ="abs" halign="j">(4) Die §§ 30c Abs. 4 und 30d Abs. 2 zweiter Satz treten mit
31. August 1995 außer Kraft.
</absatz>
</abschnitt>
