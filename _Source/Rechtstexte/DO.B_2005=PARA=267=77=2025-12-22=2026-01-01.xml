<abschnitt endnhier="true" nr="1" paperf="h" typ="ns">
					<ueberschrift typ="para" halign="c" level="2">Übergangsbestimmung zu <rvolink abkrvo="DO.B 2005" verwart="d" typ="e" gldart="PARA" gldsort="50" gldnr="22" abs="1" ursprung="u">§ 22 Abs. 1</rvolink></ueberschrift>
          <absatz typ="abs" halign="j">
            <gldsym>§ 267.</gldsym> (1) <rvolink abkrvo="DO.B 2005" verwart="d" typ="e" gldart="PARA" gldsort="50" gldnr="22" abs="1" ursprung="u">§ 22 Abs. 1</rvolink> ist auf Ärzte, die in einem Dienstverhältnis stehen und zuletzt vor dem 1. Jänner 2026 in den Dienst eines österreichischen Sozialversicherungsträgers eingetreten sind, nicht anzuwenden. Für diese Ärzte besteht ein erhöhter Kündigungsschutz, wenn der Arzt</absatz>
          
          
          
          
          
          
          
          
          
          
          
          
          
        
          <liste>
            <aufzaehlung ebene="1" art="normal">
              <listelem>
                <symbol stellen="2">1.</symbol>die österreichische Staatsbürgerschaft oder die Unionsbürgerschaft besitzt,</listelem>
              <listelem>
                <symbol stellen="2">2.</symbol>seit zwei Jahren eine auf mindestens „befriedigend“ lautende Gesamtbeurteilung der Dienstbeschreibung hat,</listelem>
              <listelem>
                <symbol stellen="2">3.</symbol>zehn Dienstjahre gemäß <rvolink abkrvo="DO.B 2005" verwart="d" typ="e" gldart="PARA" gldsort="50" gldnr="16" ursprung="u">§ 16</rvolink> zurückgelegt hat.</listelem>
            </aufzaehlung>
          </liste>
          <absatz typ="abs" halign="j">(2) <rvolink abkrvo="DO.B 2005" verwart="d" typ="e" gldart="PARA" gldsort="50" gldnr="22" abs="3" ursprung="u">§ 22 Abs. 3</rvolink> sowie die damit verbundenen Bestimmungen treten mit 31. Dezember 2030 außer Kraft.</absatz></abschnitt></nutzdaten>
