<tr h-start="0">
<td width="69" valign="top" style="padding:0cm 3.5pt 0cm 3.5pt" h-xval="1035">
<absatz typ="tabtext" halign="l"> </absatz>
</td>
<td width="583" valign="top" style="padding:0cm 3.5pt 0cm 3.5pt" h-xval="9780">
<absatz typ="tabtext">Krankenscheingebühr 2004</absatz>
</td>
</tr>
<tr h-start="0">
<td width="69" valign="top" style="padding:0cm 3.5pt 0cm 3.5pt" h-xval="1035">
<absatz typ="tabtext" halign="l"> </absatz>
</td>
<td width="583" valign="top" style="padding:0cm 3.5pt 0cm 3.5pt" h-xval="9780">
<absatz typ="tabtext">abzüglich vorläufige Krankenscheingebühr 2005 (Stand 15. 2. 2006)</absatz>
</td>
</tr>
</table>
<absatz typ="satz" widowctrl="1" keepwithnext="0" halign="j">Die Differenz ist den Gebietskrankenkassen mit Fälligkeit 27. Februar 2006 zu ersetzen.</absatz>
</abschnitt>
