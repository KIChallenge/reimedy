      <nutzdaten>
        <abschnitt nr="1" typ="ns" paperf="h" endnhier="false">
          <ueberschrift typ="para" halign="c" level="3">Behandlung mit kieferorthopädischen Behelfen</ueberschrift>
          <absatz typ="abs" halign="j">
            <gldsym>§ 21e.</gldsym> Die BVAEB leistet die Behandlung mit den im <rvolink abkrvo="Satzung BVAEB 2026" verwart="d" typ="e" gldart="ANH" gldsort="150" gldnr="2" ursprung="u">Anhang 2</rvolink> genannten kieferorthopädischen Behelfen, wenn durch sie</absatz>
          <liste>
            <ziffernliste ebene="1">
              <listelem>
                <symbol stellen="2">1.</symbol>eine kieferorthopädische Fehlstellung im Sinn des <rvolink abkrvo="Satzung BVAEB 2026" verwart="d" typ="e" gldart="PARA" gldsort="50" gldnr="21d" ursprung="u">§ 21d</rvolink> kurzfristig behoben werden kann oder</listelem>
              <listelem>
                <symbol stellen="2">2.</symbol>der Erfolg einer vorangegangenen Behandlung nach <rvolink abkrvo="Satzung BVAEB 2026" verwart="d" typ="e" gldart="PARA" gldsort="50" gldnr="21c" ursprung="u">§ 21c</rvolink> oder <rvolink abkrvo="Satzung BVAEB 2026" verwart="d" typ="e" gldart="PARA" gldsort="50" gldnr="21d" ursprung="u">§ 21d</rvolink> sichergestellt werden kann.</listelem>
            </ziffernliste>
            <schluss typ="Abs">Ist diese Behandlung nicht vertraglich geregelt und nicht in der Hauptbehandlung inkludiert, leistet die BVAEB den in <rvolink abkrvo="Satzung BVAEB 2026" verwart="d" typ="e" gldart="ANH" gldsort="150" gldnr="2" ursprung="u">Anhang 2</rvolink> genannten Zuschuss.</schluss>
          </liste>
        </abschnitt>
      </nutzdaten>
