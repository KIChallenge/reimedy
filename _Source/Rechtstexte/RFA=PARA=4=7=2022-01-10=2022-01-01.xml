<ueberschrift widowctrl="1" keepwithnext="1" halign="c" level="1" typ="para">Inhalt</ueberschrift>
<absatz typ="abs" halign="j">
            <gldsym>§ 4.</gldsym> (1) Die Führungskräfteausbildung besteht aus folgenden, verpflichtenden Teilen:</absatz>
<liste>
            <aufzaehlung ebene="3" art="normal">
              <listelem>
                <symbol stellen="1">-</symbol>einem Kickoff</listelem>
              <listelem>
                <symbol stellen="1">-</symbol>Modulen in Seminarform sowie</listelem>
              <listelem>
                <symbol stellen="1">-</symbol>einer Abschlussveranstaltung</listelem>
            </aufzaehlung>
          </liste>
<absatz typ="abs" halign="j">(2) Im Rahmen der Führungskräfteausbildung sind vier Module aus dem Bereich Management und Leadership sowie ein Modul aus dem Bereich Arbeits- und Dienstrecht zu absolvieren.</absatz>
</abschnitt>
