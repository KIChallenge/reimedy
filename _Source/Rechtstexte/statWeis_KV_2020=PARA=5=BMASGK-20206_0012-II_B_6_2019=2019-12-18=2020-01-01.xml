      <nutzdaten>
        <abschnitt nr="1" typ="ns" paperf="h" endnhier="true">
          <ueberschrift typ="para" halign="c" level="2">Ärztekostenstatistik</ueberschrift>
          <absatz typ="abs" halign="j">
            <gldsym>§ 5.</gldsym> (1) Im Rahmen der Ärztekosten-Statistik hat die Österreichischen Gesundheitskasse folgende Statistiken zu erstellen:</absatz>
          <liste>
            <aufzaehlung ebene="1" art="normal">
              <listelem>
                <symbol stellen="2">1.</symbol>Ärztekosten-Quartalsstatistik (<rvolink abkrvo="statWeis KV 2020" verwart="d" typ="e" gldart="PARA" gldsort="80" gldnr="6" ursprung="u">§ 6</rvolink>)</listelem>
              <listelem>
                <symbol stellen="2">2.</symbol>Ärztekosten-Quartalsstatistik / Mutter-Kind-Pass-Untersuchung (<rvolink abkrvo="statWeis KV 2020" verwart="d" typ="e" gldart="PARA" gldsort="80" gldnr="7" ursprung="u">§ 7</rvolink>)</listelem>
              <listelem>
                <symbol stellen="2">3.</symbol>Ärztekosten-Quartalsstatistik / Vorsorgeuntersuchung (<rvolink abkrvo="statWeis KV 2020" verwart="d" typ="e" gldart="PARA" gldsort="80" gldnr="8" ursprung="u">§ 8</rvolink>)</listelem>
              <listelem>
                <symbol stellen="2">4.</symbol>Ärztekosten-Jahresstatistik (<rvolink abkrvo="statWeis KV 2020" verwart="d" typ="e" gldart="PARA" gldsort="80" gldnr="9" ursprung="u">§ 9</rvolink>)</listelem>
              <listelem>
                <symbol stellen="2">5.</symbol>Ärztekosten-Jahresstatistik / Mutter-Kind-Pass-Untersuchung (<rvolink abkrvo="statWeis KV 2020" verwart="d" typ="e" gldart="PARA" gldsort="80" gldnr="10" ursprung="u">§ 10</rvolink>)</listelem>
              <listelem>
                <symbol stellen="2">6.</symbol>Ärztekosten-Jahresstatistik / Vorsorgeuntersuchung (<rvolink abkrvo="statWeis KV 2020" verwart="d" typ="e" gldart="PARA" gldsort="80" gldnr="11" ursprung="u">§ 11</rvolink>)</listelem>
            </aufzaehlung>
            <schlussteil ebene="1" art="normal">Die Versicherungsanstalt öffentlich Bediensteter, Eisenbahnen und Bergbau hat nur die Statistiken der Z 4 und 6 zu erstellen.</schlussteil>
          </liste>
          <absatz typ="abs" halign="j">(2) Für die Ärztekosten-Quartalsstatistiken (<rvolink abkrvo="statWeis KV 2020" verwart="d" typ="e" gldart="PARA" gldsort="80" gldnr="6" bereich="BIS" bis="8" ursprung="u">§§ 6 bis 8</rvolink>) gelten folgende Vorlagetermine:</absatz>
          <liste>
            <schlussteil ebene="1" art="normal">für das erste Abrechnungsquartal der 31. August des Berichtsjahres,</schlussteil>
            <schlussteil ebene="1" art="normal">für das zweite Abrechnungsquartal der 30. November des Berichtsjahres,</schlussteil>
            <schlussteil ebene="1" art="normal">für das dritte Abrechnungsquartal der 28. Februar des dem Berichtsjahr folgenden Jahres,</schlussteil>
            <schlussteil ebene="1" art="normal">für das vierte Abrechnungsquartal der 31. Mai des dem Berichtsjahr folgenden Jahres.</schlussteil>
          </liste>
          <absatz typ="abs" halign="j">(4) Für die Ärztekosten-Jahresstatistiken (<rvolink abkrvo="statWeis KV 2020" verwart="d" typ="e" gldart="PARA" gldsort="80" gldnr="9" bereich="BIS" bis="11" ursprung="u">§§ 9 bis 11</rvolink>) ist der späteste Vorlagetermin der 30. Juni des dem Berichtsjahr folgenden Jahres. </absatz>
        </abschnitt>
      </nutzdaten>
