<rvolink verwart="d" gldart="PARA" ursprung="p" lit="b" ziff="1" abs="1" gldnr="8" abkrvo="ASVG">§§ 8 Abs. 1 Z 1 lit. b</rvolink>, <rvolink verwart="d" gldart="PARA" ursprung="p" abs="7" gldnr="10" abkrvo="ASVG">10 Abs. 7</rvolink>, <rvolink verwart="d" gldart="PARA" ursprung="u" gldnr="21" abkrvo="ASVG" gldsort="70" typ="e">21</rvolink>, <rvolink verwart="d" gldart="PARA" ursprung="u" gldnr="22" abkrvo="ASVG" gldsort="70" typ="e">22</rvolink>, <rvolink verwart="d" gldart="PARA" ursprung="p" gldnr="32" abkrvo="ASVG">32</rvolink>, <rvolink verwart="d" gldart="PARA" ursprung="p" gldnr="38" abkrvo="ASVG">38</rvolink>, <rvolink verwart="d" gldart="PARA" ursprung="p" gldnr="40" abkrvo="ASVG">40</rvolink>,
<rvolink verwart="d" gldart="PARA" ursprung="p" gldnr="42" abkrvo="ASVG">42</rvolink>, <rvolink verwart="d" gldart="PARA" ursprung="p" gldnr="43" abkrvo="ASVG">43</rvolink>, <rvolink verwart="d" gldart="PARA" ursprung="p" abs="1" gldnr="60" abkrvo="ASVG">60 Abs. 1</rvolink> und <rvolink verwart="d" gldart="PARA" ursprung="p" abs="3" gldnr="60" abkrvo="ASVG">3</rvolink>, <rvolink verwart="d" gldart="PARA" ursprung="p" gldnr="61" abkrvo="ASVG">61</rvolink>, <rvolink verwart="d" gldart="PARA" ursprung="p" gldnr="62" abkrvo="ASVG">62</rvolink>, <rvolink verwart="d" gldart="PARA" ursprung="p" gldnr="64" abkrvo="ASVG">64</rvolink> mit der Maßgabe, daß im Abs. 2 an Stelle des nach 
