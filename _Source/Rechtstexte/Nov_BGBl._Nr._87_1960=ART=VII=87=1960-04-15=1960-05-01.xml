<abschnitt nr="1" typ="ns" paperf="h" endnhier="true">
          <ueberschrift typ="para" halign="c" widowctrl="1" keepwithnext="0" level="1">Artikel VII</ueberschrift>
          
          
          
          
        <absatz typ="abs"><gldsym>Art.VII</gldsym></absatz><absatz typ="abs" halign="j"> (1) Dieses Bundesgesetz tritt, soweit im folgenden nichts weiteres bestimmt wird, mit 1. Mai 1960 in Kraft.</absatz>
          
          
          
          <absatz typ="abs" halign="j">(2) Es treten in Kraft</absatz>
          <liste>
            <literaliste ebene="1">
              <listelem>
                <symbol stellen="2">a)</symbol>rückwirkend mit dem 1. April 1960 die Bestimmungen des Art. I Z 7, 8 und 12,</listelem>
              <listelem>
                <symbol stellen="2">b)</symbol>mit dem Beginn der Beitragsperiode Mai 1960 die Bestimmungen des Art. I Z 1 bis 4 und 16,</listelem>
              <listelem>
                <symbol stellen="2">c)</symbol>mit dem 1. Jänner 1961 die Bestimmungen des Art. I Z 13.</listelem>
            </literaliste>
          </liste></abschnitt></nutzdaten>
