      <metadaten nichtanzeigen="n" titrvo="Entgeltfortzahlungs-Zuschuss- und Differenzvergütungs-Verordnung" abkrvo="EFZ-DV-VO" dokart="V" titaen="1. Änderung der Entgeltfortzahlungs-Zuschuss- und Differenzvergütungs-Verordnung" abkaen="1. Änd EFZ-DV-VO" urheber="BMASGK" pubdat="2019-10-17" ikra="2020-01-01" sichtbarkeit="p" gldart="PARA" gldnr="6" gldsort="80">
        <anm>Rechtsgrundlage: § 53b Abs. 6 ASVG</anm>
      <puborgane><puborgan puborg="BGBl." gldpuborg="II" nrpuborg="304" begseite="1" jahrgang="2019"/></puborgane></metadaten>
      <nutzdaten>
        <abschnitt nr="1" typ="ns" paperf="h" endnhier="true">
          <ueberschrift typ="para" halign="c" level="1">Höhe der Differenzvergütung</ueberschrift>
          <absatz typ="abs" halign="j">
            <gldsym>§ 6.</gldsym> Bei gleichzeitigem Anspruch auf Zuschussleistung nach <rvolink abkrvo="EFZ-DV-VO" verwart="d" typ="e" gldart="PARA" gldsort="80" gldnr="4" ursprung="u">§ 4</rvolink> oder <rvolink abkrvo="EFZ-DV-VO" verwart="d" typ="e" gldart="PARA" gldsort="80" gldnr="5" ursprung="u">§ 5</rvolink> gebührt als Differenzvergütung nach <rvolink abkrvo="ASVG" verwart="d" typ="e" gldart="PARA" gldsort="80" gldnr="53b" abs="3" ursprung="u">§ 53b Abs. 3</rvolink><nolink> ASVG</nolink> das tatsächlich fortgezahlte Entgelt (mit Ausnahme der Sonderzahlungen) zuzüglich eines Zuschlages für die Sonderzahlungen in der Höhe von 16,68% abzüglich des nach <rvolink abkrvo="EFZ-DV-VO" verwart="d" typ="e" gldart="PARA" gldsort="80" gldnr="4" ursprung="u">§ 4</rvolink> oder <rvolink abkrvo="EFZ-DV-VO" verwart="d" typ="e" gldart="PARA" gldsort="80" gldnr="5" ursprung="u">§ 5</rvolink> ermittelten Zuschusses.</absatz>
        </abschnitt>
