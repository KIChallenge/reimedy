<nichtdoknovs><textelem>§ 35c: SRÄG 2010, 36. Nov., BGBl. I Nr. 62/2010, Art. 2 Z 8 – 1. 8. 2010.</textelem></nichtdoknovs><puborgane><puborgan puborg="BGBl." gldpuborg="I" nrpuborg="122" begseite="4" jahrgang="2011"/></puborgane></metadaten>
