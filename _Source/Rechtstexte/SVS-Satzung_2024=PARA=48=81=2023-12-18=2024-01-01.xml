      <metadaten titrvo="Satzung der Sozialversicherungsanstalt der Selbständigen 2024" abkrvo="SVS-Satzung 2024" dokart="Satzung" urheber="SVS" pubdat="2023-12-18" ikra="2024-01-01" sichtbarkeit="p" nichtanzeigen="n" titaen="Satzung der Sozialversicherungsanstalt der Selbständigen 2024 StF" abkaen="SVS-Satzung 2024 StF" beschdat="2024-12-12" gldart="PARA" gldnr="48" gldsort="50">
        <puborgane><puborgan puborg="avsv" nrpuborg="81" jahrgang="2023">avsv   Nr. 81/2023 </puborgan>
        
          </puborgane>
      </metadaten>
      <nutzdaten>
        <abschnitt nr="1" typ="ns" paperf="h" endnhier="true">
          <ueberschrift typ="para" halign="c" level="3">Dauer der Beitragspflicht, Vorschreibung, <br/>Fälligkeit und Entrichtung der Beiträge zur Höherversicherung <br/>(<rvolink abkrvo="ASVG" verwart="d" typ="e" gldart="PARA" gldsort="50" gldnr="78" abs="2" ursprung="u">§ 78 Abs. 2</rvolink><nolink> ASVG</nolink>)</ueberschrift>
          <absatz typ="abs" halign="j">
            <gldsym>§ 48.</gldsym> (1) Beitragspflicht besteht für die Dauer der Höherversicherung. <rvolink abkrvo="GSVG" verwart="d" typ="e" gldart="PARA" gldsort="50" gldnr="27" abs="3" ursprung="u">§ 27 Abs. 3</rvolink><nolink> GSVG</nolink> ist sinngemäß anzuwenden. Bei unterjährigem Beginn bzw. Ende der Höherversicherung ist der Beitrag nach <rvolink abkrvo="ASVG" verwart="d" typ="e" gldart="PARA" gldsort="50" gldnr="77" abs="4" ursprung="u">§ 77 Abs. 4</rvolink><nolink> ASVG</nolink> aliquot vorzuschreiben.</absatz>
          <absatz typ="abs" halign="j">(2) Die zusätzliche Bemessungsgrundlage nach <rvolink abkrvo="ASVG" verwart="d" typ="e" gldart="PARA" gldsort="50" gldnr="77" abs="4" ursprung="u">§ 77 Abs. 4</rvolink><nolink> ASVG</nolink> kann mit Wirkung ab Beginn des der Antragstellung folgenden Kalendervierteljahres verändert werden.</absatz>
          <absatz typ="abs" halign="j">(3) Für die Fälligkeit und Einzahlung der Beiträge ist <rvolink abkrvo="GSVG" verwart="d" typ="e" gldart="PARA" gldsort="50" gldnr="35" ursprung="u">§ 35</rvolink><nolink> GSVG</nolink> sinngemäß anzuwenden.</absatz>
        </abschnitt>
      </nutzdaten>
