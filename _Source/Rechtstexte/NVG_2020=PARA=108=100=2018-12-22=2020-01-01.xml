      <nutzdaten>
        <abschnitt nr="1" typ="ns" paperf="h" endnhier="true">
          <ueberschrift typ="para" halign="c" level="3">Berücksichtigung von Zeiten, die einem Überweisungsbetrag zugrunde liegen</ueberschrift>
          <absatz typ="abs" halign="j">
            <gldsym>§ 108.</gldsym> (1) Die in den Fällen des <rvolink abkrvo="NVG 2020" verwart="d" typ="e" gldart="PARA" gldsort="80" gldnr="69" abs="2" ursprung="u">§ 69 Abs. 2</rvolink> in einem Überweisungsbetrag berücksichtigten Versorgungszeiten gelten als Beitragszeiten im Sinne der <rvolink abkrvo="ASVG" verwart="d" typ="e" gldart="PARA" gldsort="80" gldnr="225" ursprung="u">§§ 225</rvolink> bzw. <rvolink abkrvo="ASVG" verwart="d" typ="e" gldart="PARA" gldsort="80" gldnr="226" ursprung="u">226</rvolink><nolink> ASVG</nolink>. <rvolink abkrvo="ASVG" verwart="d" typ="e" gldart="PARA" gldsort="80" gldnr="230" abs="1" ursprung="u">§ 230 Abs. 1</rvolink><nolink> ASVG</nolink> ist dabei nicht anzuwenden.</absatz>
          <absatz typ="abs" halign="j">(2) Die in den Fällen der <rvolink abkrvo="NVG" verwart="d" typ="e" gldart="PARA" gldsort="80" gldnr="94" abs="6" ursprung="u">§§ 94 Abs. 6</rvolink> und <rvolink abkrvo="NVG" verwart="d" typ="e" gldart="PARA" gldsort="80" gldnr="95" ursprung="u">95</rvolink> des Notarversicherungsgesetzes 1972 in der am 31. Dezember 2019 geltenden Fassung in einem Überweisungsbetrag berücksichtigten Beitragszeiten bzw. Dienstzeiten gelten als Versorgungszeiten im Sinne des <rvolink abkrvo="NVG 2020" verwart="d" typ="e" gldart="PARA" gldsort="80" gldnr="45" ursprung="u">§ 45</rvolink>.</absatz>
        </abschnitt>
      </nutzdaten>
