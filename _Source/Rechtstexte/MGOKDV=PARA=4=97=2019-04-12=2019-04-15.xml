      <nutzdaten>
        <abschnitt nr="1" typ="ns" paperf="h" endnhier="true">
          <ueberschrift typ="para" halign="c" level="1">Sitzungsunterlagen</ueberschrift>
          <absatz typ="abs" halign="j">
            <gldsym>§ 4.</gldsym> Sitzungsunterlagen dürfen von Sitzungsteilnehmern außerhalb ihrer Funktion nur dann verwendet werden,</absatz>
          <liste>
            <ziffernliste ebene="1">
              <listelem>
                <symbol stellen="2">1.</symbol>wenn es von der Konferenz genehmigt wurde oder</listelem>
              <listelem>
                <symbol stellen="2">2.</symbol>wenn es sich um Unterlagen handelt, die schon aus anderen Gründen außerhalb des Konferenzbereiches zugänglich sind.</listelem>
            </ziffernliste>
          </liste>
        </abschnitt>
