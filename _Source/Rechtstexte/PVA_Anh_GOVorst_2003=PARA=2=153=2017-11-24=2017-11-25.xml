      <nutzdaten>
        <abschnitt nr="1" typ="ns" paperf="h" endnhier="true">
          <ueberschrift typ="para" halign="c" level="3"> </ueberschrift><absatz typ="abs" halign="j">
            <gldsym>§ 2.</gldsym> Den Vorsitzenden der Landesstellenausschüsse werden folgende Angelegenheiten übertragen:</absatz>
          <absatz typ="abs" halign="j">(1) Die Vertretung der Anstalt nach außen in den ihrer Landesstelle gemäß <rvolink abkrvo="ASVG" verwart="d" typ="e" gldart="PARA" gldsort="80" gldnr="418" abs="3" ursprung="u">§ 418 Abs. 3</rvolink>, <rvolink abkrvo="ASVG" verwart="d" typ="e" gldart="PARA" gldsort="80" gldnr="418" abs="5" ursprung="u">5</rvolink> und <rvolink abkrvo="ASVG" verwart="d" typ="e" gldart="PARA" gldsort="80" gldnr="418" abs="6" ursprung="u">6</rvolink><nolink> ASVG</nolink> zugewiesenen Aufgaben sowie in den ihnen gemäß <rvolink abkrvo="PVA Anh GOVorst 2003" verwart="d" typ="e" gldart="PARA" gldsort="80" gldnr="14" ursprung="u">§ 14</rvolink> oder dem Landesstellenausschuss gemäß <rvolink abkrvo="PVA Anh GOVorst 2003" verwart="d" typ="e" gldart="PARA" gldsort="80" gldnr="13" ursprung="u">§ 13</rvolink> delegierten Angelegenheiten.</absatz>
          <absatz typ="abs" halign="j">(2) Im Falle einer Verhinderung der Vorsitzenden der Landesstellenausschüsse an einer zeitgerechten Ausübung sämtlicher ihnen übertragenen Obliegenheiten werden diese durch ihre Stellvertreter vertreten.</absatz>
        </abschnitt>
      </nutzdaten>
