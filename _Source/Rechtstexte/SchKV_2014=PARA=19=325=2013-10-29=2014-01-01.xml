                <symbol stellen="2">2.</symbol>zur Schlichtung und Entscheidung von Streitigkeiten nach den <rvolink abkrvo="ASVG" verwart="d" typ="e" gldart="PARA" gldsort="70" gldnr="348c" ursprung="u">§§ 348c</rvolink>, <rvolink abkrvo="ASVG" verwart="d" typ="e" gldart="PARA" gldsort="70" gldnr="348d" ursprung="u">348d</rvolink> und <rvolink abkrvo="ASVG" verwart="d" typ="e" gldart="PARA" gldsort="70" gldnr="348e" ursprung="u">348e</rvolink><nolink> ASVG</nolink>.</listelem>
