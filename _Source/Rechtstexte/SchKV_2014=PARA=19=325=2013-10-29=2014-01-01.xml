          <absatz typ="abs" halign="j">
            <gldsym>§ 19.</gldsym> Die Bundesschiedskommission ist zuständig:</absatz>
          <liste>
            <ziffernliste ebene="1">
              <listelem>
                <symbol stellen="2">1.</symbol>zur Festsetzung des Inhaltes eines aufgekündigten Gesamtvertrages für höchstens drei Monate;</listelem>
