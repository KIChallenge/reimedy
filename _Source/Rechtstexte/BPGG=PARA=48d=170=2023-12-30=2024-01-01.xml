<metadaten gldsort="70" indbr="66.03.11" gldart="PARA" berkz="PFLEGE; AN; SELB; " beschdat="2023-12-13" urheber="Bund" titrvo="Bundespflegegeldgesetz" gldnr="48d" ikra="2024-01-01" sichtbarkeit="p" abkrvo="BPGG" titaen="Dezembernovelle 170/2023" dokart="BG" abkaen="DezemberNov 170/2023" pubdat="2023-12-30" nichtanzeigen="n">


