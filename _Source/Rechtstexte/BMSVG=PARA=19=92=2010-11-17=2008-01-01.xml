      <nutzdaten>
        <abschnitt nr="1" typ="ns" paperf="h" endnhier="true">
          <ueberschrift typ="para" halign="c" level="3">Rechtsform und Geschäftsbeschränkungen</ueberschrift>
          <absatz typ="abs" halign="j">
            <gldsym>§ 19.</gldsym> (1) Das Betriebliche Vorsorgekassengeschäft darf nur von Aktiengesellschaften oder von Gesellschaften mit beschränkter Haftung betrieben werden.</absatz>
          <absatz typ="abs" halign="j">(2) BV-Kassen dürfen nur die in § 1 Abs. 1 Z 21 BWG angeführten Geschäftstätigkeiten ausüben.</absatz>
          <absatz typ="abs" halign="j">(3) BV-Kassen dürfen keine Beteiligungen an anderen Unternehmen halten, sofern diese Unternehmen nicht operative oder sonstige mit dem Betrieblichen Vorsorgekassengeschäft verbundene Aufgaben wahrnehmen.</absatz>
          <abstand halign="l"/>
        </abschnitt>
      </nutzdaten>
