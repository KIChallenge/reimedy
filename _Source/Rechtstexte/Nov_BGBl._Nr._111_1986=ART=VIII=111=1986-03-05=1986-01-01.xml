<ueberschrift typ="art" halign="c">Artikel VIII</ueberschrift><ueberschrift typ="para" halign="c">Inkrafttreten</ueberschrift></abschnitt><abschnitt>
<absatz typ="abs" halign="j"><gldsym>Art. VIII </gldsym></absatz>







<absatz typ="abs" halign="j">(1) Dieses Bundesgesetz tritt, soweit im folgenden nichts anderes bestimmt wird, am 1. Jänner 1986 in Kraft.</absatz>
          <absatz typ="abs" halign="j">(2) Es treten in Kraft:</absatz>
          <liste>
            <literaliste ebene="2">
              <listelem>
                <symbol stellen="2">a)</symbol>rückwirkend mit 1. Jänner 1984 Art. I Z 1 lit. b, 2 lit. a und c, 3, 5, 6, 8, 13, 14, 17, 18, 28, Art. II Z 1 und 5, Art. IV Z 1 lit. b und Art. VII Abs. 1 und 2;</listelem>
              <listelem>
                <symbol stellen="2">b)</symbol>rückwirkend mit 1. Jänner 1985 Art. I Z 25, Art. IV Z 7, 10 und Art. VII Abs. 3;</listelem>
              <listelem>
                <symbol stellen="2">c)</symbol>mit dem Beginn des Beitragszeitraumes Jänner 1986 Art. I Z 15 lit. a bis e, 16, 19 und 20;</listelem>
              <listelem>
                <symbol stellen="2">d)</symbol>mit dem Beginn des Beitragszeitraumes Juli 1987 Art. I Z 12 lit. b.</listelem>
            </literaliste>
          </liste></abschnitt>
</nutzdaten>
