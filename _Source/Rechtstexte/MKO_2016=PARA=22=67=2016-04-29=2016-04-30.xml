      <metadaten nichtanzeigen="n" titrvo="Musterkrankenordnung 2016" abkrvo="MKO 2016" dokart="MusterR" titaen="Musterkrankenordnung 2016 StF" abkaen="MKO 2016 StF" urheber="Hauptverband" beschdat="2016-04-19" pubdat="2016-04-29" ikra="2016-04-30" sichtbarkeit="p" gldart="PARA" gldnr="22" gldsort="70">
