      <metadaten nichtanzeigen="n" titrvo="Sozialversicherungsabkommen Montenegro 2011" abkrvo="AbkSozSi Montenegro 2011" dokart="SVAbk" titaen="Sozialversicherungsabkommen Montenegro 2011 Stammfassung" abkaen="AbkSozSi Montenegro 2011 StF" urheber="Bund" beschdat="2010-10-21" pubdat="2011-04-11" ikra="2011-06-01" sichtbarkeit="p" gldart="ART" gldnr="9" gldsort="80">
