      <metadaten titrvo="Satzung der Sozialversicherungsanstalt der Selbständigen 2024" abkrvo="SVS-Satzung 2024" dokart="Satzung" urheber="SVS" pubdat="2023-12-18" ikra="2024-01-01" sichtbarkeit="p" nichtanzeigen="n" titaen="Satzung der Sozialversicherungsanstalt der Selbständigen 2024 StF" abkaen="SVS-Satzung 2024 StF" beschdat="2024-12-12" gldart="PARA" gldnr="41" gldsort="50">
