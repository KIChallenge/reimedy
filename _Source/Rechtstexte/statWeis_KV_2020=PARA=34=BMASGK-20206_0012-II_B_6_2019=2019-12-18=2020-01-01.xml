      <nutzdaten>
        <abschnitt nr="1" typ="ns" paperf="h" endnhier="true">
          <ueberschrift typ="para" halign="c" level="2">Leistungsstatistik</ueberschrift>
          <absatz typ="abs" halign="j">
            <gldsym>§ 34.</gldsym> (1) Im Rahmen der Leistungsstatistik sind jene Statistiken zu erstellen, die für die Erfassung der Leistungen dienen. Die Leistungsstatistik beinhaltet folgende Gruppen von Statistiken:</absatz>
          <liste>
            <aufzaehlung ebene="1" art="normal">
              <listelem>
                <symbol stellen="2">1.</symbol>Ärztekosten-Jahresstatistik (<rvolink abkrvo="statWeis KV 2020" verwart="d" typ="e" gldart="PARA" gldsort="80" gldnr="35" ursprung="u">§ 35</rvolink> und <rvolink abkrvo="statWeis KV 2020" verwart="d" typ="e" gldart="PARA" gldsort="80" gldnr="36" ursprung="u">36</rvolink>)</listelem>
              <listelem>
                <symbol stellen="2">2.</symbol>Zahnhilfe-Statistik (<rvolink abkrvo="statWeis KV 2020" verwart="d" typ="e" gldart="PARA" gldsort="80" gldnr="37" ursprung="u">§ 37</rvolink>)</listelem>
              <listelem>
                <symbol stellen="2">3.</symbol>Heilmittel-Heilbehelfe-Statistik (<rvolink abkrvo="statWeis KV 2020" verwart="d" typ="e" gldart="PARA" gldsort="80" gldnr="38" ursprung="u">§ 38</rvolink>)</listelem>
              <listelem>
                <symbol stellen="2">4.</symbol>Spital-Statistik (<rvolink abkrvo="statWeis KV 2020" verwart="d" typ="e" gldart="PARA" gldsort="80" gldnr="39" ursprung="u">§ 39</rvolink>)</listelem>
              <listelem>
                <symbol stellen="2">5.</symbol>Sonstige Statistiken (<rvolink abkrvo="statWeis KV 2020" verwart="d" typ="e" gldart="PARA" gldsort="80" gldnr="40" bereich="BIS" bis="43" ursprung="u">§§ 40 bis 43</rvolink>)</listelem>
            </aufzaehlung>
          </liste>
          <absatz typ="abs" halign="j">(2) Sofern in den Leistungsstatistiken Aufwendungen angeführt sind, hat die Erfassung ohne Umsatzsteuer zu erfolgen.</absatz>
        </abschnitt>
      </nutzdaten>
