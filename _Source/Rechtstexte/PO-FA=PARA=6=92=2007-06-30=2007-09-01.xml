<nutzdaten>
<abschnitt>
<ueberschrift widowctrl="1" keepwithnext="0" halign="c" level="4" typ="para">Ansuchen um Zulassung</ueberschrift>
<absatz typ="abs" widowctrl="1" keepwithnext="0" halign="j">
<gldsym>§ 6.</gldsym> (1) Ansuchen um Zulassung zur Prüfung sind im Dienstweg (
<rvolink abkrvo="DO.A 2005" verwart="d" typ="e" gldart="PARA" gldsort="70" gldnr="23" abs="1" ursprung="u">§ 23 Abs. 1</rvolink> DO.A) einzubringen und von den Versicherungsträgern dem Hauptverband bis zu dem von ihm festgesetzten Zeitpunkt zu übermitteln.</absatz>
<absatz typ="abs" widowctrl="1" keepwithnext="0" halign="j">(2) Dem Verbandsvorstand obliegt:
</absatz>
<liste>
<ziffernliste ebene="1">
<listelem>
<symbol stellen="2">1.</symbol>die Genehmigung der von den Versicherungsträgern anberaumten Zulassungsprüfungen;</listelem>
<listelem>
<symbol stellen="2">2.</symbol>die Entscheidung über die Zulassung;</listelem>
<listelem>
<symbol stellen="2">3.</symbol>die Bestellung der Prüfer gemäß 
<rvolink abkrvo="PO-FA" verwart="d" typ="e" gldart="PARA" gldsort="70" gldnr="9" abs="7" ursprung="u">§ 9 Abs. 7</rvolink>;</listelem>
<listelem>
<symbol stellen="2">4.</symbol>die Entscheidung über Ansuchen gemäß 
<rvolink abkrvo="PO-FA" verwart="d" typ="e" gldart="PARA" gldsort="70" gldnr="8" abs="2" ursprung="u">§ 8 Abs. 2</rvolink>;</listelem>
<listelem>
<symbol stellen="2">5.</symbol>die Entscheidung gemäß 
<rvolink abkrvo="PO-FA" verwart="d" typ="e" gldart="PARA" gldsort="70" gldnr="8" abs="4" ursprung="p">§ 8 Abs. 4</rvolink>.</listelem>
</ziffernliste>
</liste>
</abschnitt>
</nutzdaten>
