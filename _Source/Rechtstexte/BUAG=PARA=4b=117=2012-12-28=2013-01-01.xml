<abschnitt>
<ueberschrift widowctrl="1" keepwithnext="1" level="2" halign="c" typ="para">Zusatzurlaub für Schichtarbeit</ueberschrift>



<absatz typ="abs" halign="j">
            <gldsym>§ 4b.</gldsym> Arbeitnehmer, die</absatz>
          <liste>
            <ziffernliste ebene="1">
              <listelem>
                <symbol stellen="2">1.</symbol>in Dreischichtarbeit oder</listelem>
              <listelem>
                <symbol stellen="2">2.</symbol>in Zweischichtformen oder –einteilungen, die im Schichtturnus eine tägliche Arbeitszeit von mehr als neun Stunden vorsehen,</listelem>
            </ziffernliste>
            <schluss typ="Abs">tätig sind, gebührt für je acht Wochen Schichtarbeit innerhalb der Anwartschaftsperiode (<rvolink abkrvo="BUAG" verwart="d" typ="e" gldart="PARA" gldsort="70" gldnr="4" abs="1" ursprung="u">§ 4 Abs. 1</rvolink>) ein zusätzlicher Urlaub von einem Arbeitstag. <rvolink abkrvo="BUAG" verwart="d" typ="e" gldart="PARA" gldsort="70" gldnr="4a" ursprung="u">§ 4a</rvolink> gilt sinngemäß.</schluss>
          </liste></abschnitt>
