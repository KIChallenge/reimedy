          <ueberschrift typ="para" halign="c" level="3">Informationsveranstaltungen</ueberschrift>
          <ueberschrift typ="para" halign="c">(<rvolink abkrvo="ASVG" verwart="d" typ="e" gldart="PARA" gldsort="80" gldnr="453" abs="1" ziff="3" ursprung="u">§ 453 Abs. 1 Z 3</rvolink><nolink> ASVG</nolink>)</ueberschrift><absatz typ="abs" halign="j">
            <gldsym>§ 4.</gldsym> (1) Die Kasse hält in Abständen von ... Informationsveranstaltungen für Versicherte und Dienstgeber/Dienstgeberinnen ab.</absatz>
          <absatz typ="abs" halign="j">(2) Informationsveranstaltungen können auch</absatz>
          <liste>
            <ziffernliste ebene="1">
              <listelem>
                <symbol stellen="2">1.</symbol>für Arbeitnehmer/innen oder Arbeitgeber/Arbeitgeberinnen getrennt,</listelem>
              <listelem>
                <symbol stellen="2">2.</symbol>für bestimmte Regionen des Zuständigkeitsbereichs der Kasse oder</listelem>
              <listelem>
                <symbol stellen="2">3.</symbol>für bestimmte Themenbereiche</listelem>
            </ziffernliste>
            <schluss typ="Abs">abgehalten werden.</schluss>
          </liste>
        </abschnitt>
