<abschnitt>
<ueberschrift level="1" halign="c" typ="para">ANHANG II (Artikel 3 Absatz 1) 
<br/>Rechtsvorschriften und Systeme, auf die sich das Abkommen bezieht</ueberschrift>
<absatz typ="abs" halign="j">
<gldsym>Anhang 2</gldsym>
</absatz>
<absatz typ="abs" halign="j">Spanien Rechtsvorschriften über </absatz>
<absatz typ="abs" halign="j">a) das Allgemeine System der Sozialen Sicherheit betreffend die folgenden Zweige: </absatz>
<absatz typ="abs" halign="j">1. Krankheit, Mutterschaft; </absatz>
<absatz typ="abs" halign="j">2. Alter; </absatz>
<absatz typ="abs" halign="j">3. Invalidität; </absatz>
<absatz typ="abs" halign="j">4. Tod und Hinterbliebene; </absatz>
<absatz typ="abs" halign="j">5. Arbeitsunfälle und Berufskrankheiten; </absatz>
<absatz typ="abs" halign="j">6. Familienbeihilfen; </absatz>
<absatz typ="abs" halign="j">7. Arbeitslosigkeit;</absatz>
<absatz typ="abs" halign="j">b) die Sondersysteme der Sozialen Sicherheit hinsichtlich der angeführten Zweige. </absatz>
</abschnitt>
