<metadaten gldart="ART" gldsort="80" titrvo="Nov BGBl. Nr. 162/1972" abkrvo="Nov BGBl. Nr. 162/1972" dokart="BG" titaen="Allgemeines SozialversicherungsG - 28. Novelle" abkaen="28. ASVGNov" urheber="Bund" pubdat="1972-06-09" ikra="1972-01-01" sichtbarkeit="p" gldnr="II" nichtanzeigen="n" beschdat="1972-04-26">



