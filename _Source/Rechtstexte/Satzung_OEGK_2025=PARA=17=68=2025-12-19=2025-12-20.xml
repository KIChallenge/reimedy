      <metadaten titrvo="Satzung der Österreichischen Gesundheitskasse 2025" abkrvo="Satzung OEGK 2025" dokart="Satzung" urheber="ÖGK" beschdat="2025-12-09" pubdat="2025-12-19" ikra="2025-12-20" sichtbarkeit="p" nichtanzeigen="n" titaen="Satzung der Österreichischen Gesundheitskasse 2025 StF" abkaen="Satzung ÖGK 2025 StF" gldart="PARA" gldnr="17" gldsort="50">
