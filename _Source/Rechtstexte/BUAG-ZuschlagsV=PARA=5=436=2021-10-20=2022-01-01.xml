<uebrecht><rvolink ursprung="u" abkrvo="BUAG-ZuschlagsV" verwart="s" gldart="PARA" gldsort="80" gldnr="6" abs="10" pubdat="2018-12-21" ikra="2018-12-22" puborg="BGBl." gldpuborg="II" nrpuborg="362" jahrgang="2018" typ="e">§ 6 Abs. 10 idF 362/2018</rvolink></uebrecht><puborgane><puborgan puborg="BGBl." gldpuborg="II" nrpuborg="436" begseite="1" jahrgang="2021"/></puborgane></metadaten>
