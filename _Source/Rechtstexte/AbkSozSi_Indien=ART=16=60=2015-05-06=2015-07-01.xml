          <ueberschrift typ="para" halign="c" level="2">Artikel 16 <br/>Verbindungsstellen</ueberschrift>
          
          <absatz typ="abs" halign="j">
            <gldsym>Art. 16</gldsym>
          </absatz><absatz typ="abs" halign="j">Die zuständigen Behörden der Vertragsstaaten haben zur Erleichterung der Durchführung dieses Abkommens, insbesondere zu Herstellung einer einfachen und raschen Verbindung zwischen den beiderseits in Betracht kommenden Stellen, Verbindungsstellen zu errichten.</absatz>
          
        </abschnitt>
