<abschnitt nr="1" typ="ns" paperf="h" endnhier="true">
          <ueberschrift typ="para" halign="c" widowctrl="1" keepwithnext="0" level="1">ARTIKEL IV <br/>Inkrafttreten</ueberschrift><absatz typ="abs"><gldsym>Art. IV</gldsym></absatz>
        
          
          <absatz typ="abs" halign="j">(1) Dieses Bundesgesetz tritt, soweit im folgenden nichts anderes bestimmt wird, am 1. Jänner 1980 in Kraft.</absatz>
          <absatz typ="abs" halign="j">(2) Es treten in Kraft:</absatz>
          <liste>
            <literaliste ebene="1">
              <listelem>
                <symbol stellen="2">a)</symbol>rückwirkend mit dem 1. Jänner 1973 die Bestimmung des Art. III Abs. 3;</listelem>
              <listelem>
                <symbol stellen="2">b)</symbol>rückwirkend mit dem 1. Jänner 1977 die Bestimmung des Art. III Abs. 4;</listelem>
              <listelem>
                <symbol stellen="2">c)</symbol>rückwirkend mit dem 1. Jänner 1979 die Bestimmungen des Art. I Z 3 lit. a und b, 4 lit. a, b und c, 5, 8 lit. a, 9 lit. b und 18 bis 20;</listelem>
              <listelem>
                <symbol stellen="2">d)</symbol>mit dem 1. April 1980 die Bestimmung des Art. I Z 1.</listelem>
            </literaliste>
          </liste></abschnitt></nutzdaten>
