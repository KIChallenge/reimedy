<abschnitt>
<ueberschrift level="4" halign="c" typ="para">Leistungen </ueberschrift>
<absatz typ="abs" halign="j">
<gldsym>§ 75.</gldsym> Als Leistungen der Krankenversicherung sind nach Maßgabe der Bestimmungen dieses Bundesgesetzes zu gewähren: 
</absatz>
<liste>
<ziffernliste ebene="1">
<listelem>
<symbol>1.</symbol>Zur Früherkennung von Krankheiten: Jugendlichenuntersuchungen und Vorsorge(Gesunden)untersuchungen (<rvolink abkrvo="BSVG" gldnr="81" ursprung="p" gldart="PARA" verwart="d">§§ 
81</rvolink> und <rvolink abkrvo="BSVG" gldnr="82" ursprung="p" gldart="PARA" verwart="d">82</rvolink>); 
</listelem>
<listelem>
<symbol>2.</symbol>aus dem Versicherungsfall der Krankheit: Krankenbehandlung einschließlich jener im Rahmen der Hospiz- und Palliativversorgung (<rvolink typ="e" gldsort="70" abkrvo="BSVG" gldnr="83" bis="87" ursprung="u" gldart="PARA" bereich="BIS" verwart="d">§§ 83 bis 87</rvolink>), erforderlichenfalls medizinische Hauskrankenpflege (<rvolink abkrvo="BSVG" gldnr="94" ursprung="p" gldart="PARA" verwart="d">§ 94</rvolink>) oder Anstaltspflege (<rvolink typ="e" gldsort="70" abkrvo="BSVG" gldnr="89" bis="93" ursprung="u" gldart="PARA" bereich="BIS" verwart="d">§§ 89 bis 93</rvolink>);</listelem>
<listelem>
<symbol>3.</symbol>aus dem Versicherungsfall der Mutterschaft: Mutterschaftsleistungen (<rvolink typ="e" gldnr="97" gldsort="70" gldart="PARA" verwart="d" abkrvo="BSVG" ursprung="u">§§ 97</rvolink> und 
<rvolink typ="e" gldnr="98" gldsort="70" gldart="PARA" verwart="d" abkrvo="BSVG" ursprung="u">98</rvolink>).
</listelem>
<listelem>
<symbol>4.</symbol><i>(Anm.: aufgehoben durch BGBl. I Nr. 84/2009)</i></listelem>
</ziffernliste>
</liste>
</abschnitt>
