      <nutzdaten>
        <abschnitt nr="1" typ="ns" paperf="h" endnhier="true">
          <ueberschrift typ="para" halign="c" level="2">Alters-Morbiditäts-Statistik</ueberschrift>
          <absatz typ="abs" halign="j">
            <gldsym>§ 22.</gldsym> (1) Für die Erstellung der Alters-Morbiditäts-Statistik sind die <wwwlink ursprung="u" url="/fs/Formular_KL51_ab_2020.pdf" gldart="KEIN" typ="e">Formular KL51</wwwlink>, <wwwlink ursprung="u" url="/fs/Formular_KL511_ab_2020.pdf" gldart="KEIN" typ="e">KL511</wwwlink> und <wwwlink ursprung="u" url="/fs/Formular_KL512_ab_2020.pdf" gldart="KEIN" typ="e">KL512</wwwlink> zu verwenden.</absatz>
          <absatz typ="abs" halign="j">(2) Das <wwwlink ursprung="u" url="/fs/Formular_KL51_ab_2020.pdf" gldart="KEIN" typ="e">Formular KL51</wwwlink> ist für versicherungspflichtige Erwerbstätige insgesamt, das <wwwlink ursprung="u" url="/fs/Formular_KL511_ab_2020.pdf" gldart="KEIN" typ="e">Formular KL511</wwwlink> für Arbeiter und das <wwwlink ursprung="u" url="/fs/Formular_KL512_ab_2020.pdf" gldart="KEIN" typ="e">Formular KL512</wwwlink> für Angestellte zu erstellen. Das Alter ergibt sich aus der Differenz zwischen dem Berichtsjahr und dem Geburtsjahr.</absatz>
        </abschnitt>
      </nutzdaten>
