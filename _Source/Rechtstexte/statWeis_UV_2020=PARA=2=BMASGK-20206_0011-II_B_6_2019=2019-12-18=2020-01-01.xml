      <nutzdaten>
        <abschnitt nr="1" typ="ns" paperf="h" endnhier="true">
          <ueberschrift typ="para" halign="c" level="2">Verpflichtung zur Erstellung von Statistiken</ueberschrift>
          <absatz typ="abs" halign="j">
            <gldsym>§ 2.</gldsym> Die Allgemeine Unfallversicherungsanstalt, die Versicherungsanstalt öffentlich Bediensteter, Eisenbahnen und Bergbau als Unfallversicherungsträger getrennt nach den beiden in <rvolink abkrvo="B-KUVG" verwart="d" typ="e" gldart="PARA" gldsort="80" gldnr="117" ursprung="u">§ 117</rvolink><nolink> B-KUVG</nolink> angesprochenen Versichertengruppen und die Sozialversicherungsanstalt der Selbständigen als Unfallversicherungsträger getrennt nach den Versicherten a) des <nolink>ASVG</nolink> zuzüglich <nolink>FSVG</nolink> und b) des <nolink>BSVG</nolink> haben statistische Nachweisungen für folgende Bereiche zu erstellen: </absatz>
          <liste>
            <aufzaehlung ebene="1" art="normal">
              <listelem>
                <symbol stellen="2">1.</symbol>Monatsstatistik (<rvolink abkrvo="statWeis UV 2020" verwart="d" typ="e" gldart="PARA" gldsort="80" gldnr="3" bereich="BIS" bis="4" ursprung="u">§§ 3 bis 4</rvolink>)</listelem>
              <listelem>
                <symbol stellen="2">2.</symbol>Versichertenstatistik (<rvolink abkrvo="statWeis UV 2020" verwart="d" typ="e" gldart="PARA" gldsort="80" gldnr="5" bereich="BIS" bis="6" ursprung="u">§§ 5 bis 6</rvolink>)</listelem>
              <listelem>
                <symbol stellen="2">3.</symbol>Leistungsstatistik (<rvolink abkrvo="statWeis UV 2020" verwart="d" typ="e" gldart="PARA" gldsort="80" gldnr="7" bereich="BIS" bis="24" ursprung="u">§§ 7 bis 24</rvolink>)</listelem>
            </aufzaehlung>
          </liste>
        </abschnitt>
      </nutzdaten>
