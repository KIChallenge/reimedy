          <absatz typ="abs"><gldsym>Art. IV</gldsym></absatz><absatz typ="abs" halign="j">(1) Dieses Bundesgesetz tritt, soweit nichts anderes bestimmt wird, am 1. Juli 1970 in Kraft.</absatz>
          <absatz typ="abs" halign="j">(2) Es treten in Kraft:</absatz>
          <liste>
            <literaliste ebene="1">
              <listelem>
                <symbol stellen="2">a)</symbol>die Bestimmungen des Art. I Z 1 lit. a, 10 lit. a, 14 und des Art. II mit 1. Jänner 1970;</listelem>
              <listelem>
                <symbol stellen="2">b)</symbol>die Bestimmungen des Art. I Z 1 lit. b, 2 bis 4, 6 und 11 bis 13 mit 1. Jänner 1971.</listelem>
            </literaliste>
          </liste></abschnitt>
