          <ueberschrift typ="para" halign="c" level="2" widowctrl="1">Artikel 27 <br/>Verbindungsstellen</ueberschrift>
          <absatz typ="abs" halign="j">
            <gldsym>Art. 27</gldsym>
          </absatz><absatz typ="satz" halign="j">Die zuständigen Behörden haben in der Vereinbarung nach <rvolink ursprung="u" abkrvo="AbkSozSi Montenegro 2011" verwart="d" gldart="ART" gldsort="80" gldnr="26" abs="1" typ="e">Artikel 26 Absatz 1</rvolink> zur Erleichterung der Durchführung dieses Abkommens, insbesondere zur Herstellung einer einfachen und raschen Verbindung zwischen den beiderseits in Betracht kommenden Trägern, Verbindungsstellen zu errichten.</absatz>
          
        </abschnitt>
