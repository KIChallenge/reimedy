      <metadaten nichtanzeigen="n" titrvo="Betriebliches Mitarbeiter- und SelbstständigenvorsorgeG" abkrvo="BMSVG" dokart="BG" titaen="Pensionsfonds-ÜberleitungsG" abkaen="PF-ÜG" urheber="Bund" pubdat="2013-01-10" ikra="2013-01-01" sichtbarkeit="p" gldart="PARA" gldnr="70" gldsort="70" beschdat="2012-12-05">
        
      <puborgane><puborgan puborg="BGBl." gldpuborg="I" nrpuborg="4" begseite="7" jahrgang="2013"/></puborgane></metadaten>
      <nutzdaten>
        <abschnitt nr="1" typ="ns" paperf="h" endnhier="true">
          <ueberschrift typ="para" halign="c" level="3">Verwaltungskosten</ueberschrift>
          <absatz typ="abs" halign="j">
            <gldsym>§ 70.</gldsym> Werden die Beiträge durch einen Sozialversicherungsträger eingehoben (<rvolink abkrvo="BMSVG" verwart="d" typ="e" gldart="PARA" gldsort="70" gldnr="64" abs="4" ursprung="u">§ 64 Abs. 4 bis 6</rvolink>), so ist <rvolink abkrvo="BMSVG" verwart="d" typ="e" gldart="PARA" gldsort="70" gldnr="26" ursprung="u">§ 26</rvolink> anzuwenden, wobei der in <rvolink abkrvo="BMSVG" verwart="d" typ="e" gldart="PARA" gldsort="70" gldnr="26" abs="5" ursprung="u">§ 26 Abs. 5</rvolink> geregelte Kostenersatz dem jeweiligen Sozialversicherungsträger (<rvolink abkrvo="BMSVG" verwart="d" typ="e" gldart="PARA" gldsort="70" gldnr="64" ursprung="u">§ 64</rvolink>) zusteht. Abweichend vom ersten Satz sind die Verwaltungskosten hinsichtlich der Beitragseinhebung, Veranlagung und Verwaltung der Beiträge von Rechtsanwälten in einem Rahmenvertrag zwischen dem Österreichischen Rechtsanwaltskammertag und der jeweiligen BV-Kasse festzulegen, wobei die Verwaltungskosten für alle Rechtsanwälte, die vom Rahmenvertrag erfasst werden, prozentmäßig gleich sein müssen.</absatz>
          
        </abschnitt>
      </nutzdaten>
