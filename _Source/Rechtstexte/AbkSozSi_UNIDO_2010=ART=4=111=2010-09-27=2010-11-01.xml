            <gldsym>Art. 4</gldsym>
          </absatz>
          <absatz typ="abs" halign="j">Angestellte können geltend machen:</absatz>
          <liste>
            <betragliste typ="ziffer">
              <listelem>
                <symbol stellen="2">1.</symbol>das Recht nach <rvolink ursprung="u" abkrvo="AbkSozSi UNIDO 2010" verwart="d" gldart="ART" gldsort="80" gldnr="2" abs="1" typ="e">Artikel 2 Absatz 1</rvolink> binnen drei Monaten nach dem Beginn der Beschäftigung bei der UNIDO oder binnen drei Monaten nach einer durchgehenden dreijährigen Beschäftigung bei der UNIDO,</listelem>
