      <nutzdaten>
        <abschnitt nr="1" typ="ns" paperf="h" endnhier="true">
          <ueberschrift typ="g1min" halign="c" level="1">ABSCHNITT IV <br/>FINANZIELLE BESTIMMUNGEN</ueberschrift>
          <ueberschrift typ="para" halign="c" level="2">Artikel 16 <br/>Kostenerstattung</ueberschrift>
          <absatz typ="abs" halign="j">
            <gldsym>Art. 16</gldsym>
          </absatz><absatz typ="abs" halign="j">(1) Für die Durchführung des <rvolink ursprung="u" abkrvo="AbkSozSi Montenegro 2011" verwart="d" gldart="ART" gldsort="80" gldnr="15" typ="e">Artikels 15</rvolink> und des <rvolink ursprung="u" abkrvo="AbkSozSi Montenegro 2011" verwart="d" gldart="ART" gldsort="80" gldnr="16" abs="4" typ="e">Artikels 16 Absatz 4</rvolink> des Abkommens ist der Anspruch auf Erstattung der Kosten von Sachleistungen von dem nach <rvolink ursprung="u" abkrvo="AbkSozSi Montenegro 2011" verwart="d" gldart="ART" gldsort="80" gldnr="14" typ="e">Artikel 14</rvolink> des Abkommens in Betracht kommenden Träger nach Abschluss des Leistungsfalles oder für jedes Kalendervierteljahr geltend zu machen.</absatz>
          <absatz typ="abs" halign="j">(2) Der zuständige Träger hat die Kosten nach Absatz 1 binnen zwei Monaten nach Eingang der Forderung zu erstatten.</absatz>
          <abstand halign="l"/>
        </abschnitt>
