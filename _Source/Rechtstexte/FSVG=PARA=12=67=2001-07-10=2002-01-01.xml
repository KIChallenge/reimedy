<metadaten pubdat="2001-07-10" abkaen="SV-WUBG" dokart="BG" titaen="Sozialversicherungs-Währungsumstellungs-BegleitG" abkrvo="FSVG" sichtbarkeit="p" ikra="2002-01-01" fassung="8" gldnr="12" titrvo="Freiberuflich Selbständigen-Sozialversicherungsgesetz" urheber="Bund" beschdat="2001-06-06" berkz="KVL; UVL; PVL; SELB;" gldart="PARA" indbr="66.02.06" gldsort="70">


