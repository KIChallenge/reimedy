<metadaten titrvo="Verordnung (EWG) 574/72 über die Durchführung der Verordnung (EWG) 1408/72" abkrvo="WandArb-DurchfV 574/1972" dokart="V Eur" celex="32008R0101" titaen="Kunsttext WandArb-DurchfV 574/1972 idF 101/2008" abkaen="Kunsttext WandArb-DurchfV 574/1972 idF 101/2008" urheber="Europ Rat" beschdat="2008-02-04" pubdat="2008-02-05" ikra="2008-02-25" sichtbarkeit="p" gldart="ANH" gldnr="8" gldsort="140" nichtanzeigen="n">
<anm>Die Verordnung (EG) Nr. 987/2009 löste am 1. Mai 2010 die Verordnung (EWG) Nr. 574/1972 ab. Die Verordnung (EWG) Nr. 574/1972 bleibt jedoch gemäß <rvolink ursprung="u" abkrvo="EG-Koord-DurchfV 987/2009" verwart="d" gldart="ART" gldsort="80" gldnr="96" typ="e">Artikel 96</rvolink> der Verordnung (EG) Nr. 987/2009 für bestimmte Sachverhalte weiterhin anwendbar, u. a. für Staatsangehörige von Drittstaaten, für das Abkommen über den Europäischen Wirtschaftsraum und für die Beziehungen zur Schweiz.</anm><puborgane>
<puborgan puborg="ABl." gldpuborg="L" nrpuborg="101" stkpuborg="31" begseite="15" jahrgang="2008"/>
</puborgane>
</metadaten>
