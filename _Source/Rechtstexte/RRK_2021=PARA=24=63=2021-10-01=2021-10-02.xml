      <nutzdaten>
        <abschnitt nr="1" typ="ns" paperf="h" endnhier="true">
          <ueberschrift typ="g2" halign="c" level="2">Unterabschnitt 5</ueberschrift>
          <ueberschrift typ="para" halign="c" level="3">Vorzeitige Einstellung von Maßnahmen</ueberschrift>
          <absatz typ="abs" halign="j">
            <gldsym>§ 24.</gldsym> Maßnahmen gemäß den <rvolink abkrvo="RRK 2021" verwart="d" typ="e" gldart="PARA" gldsort="50" gldnr="12" ursprung="u">§§ 12</rvolink>, <rvolink abkrvo="RRK 2021" verwart="d" typ="e" gldart="PARA" gldsort="50" gldnr="12a" ursprung="u">12a</rvolink>, <rvolink abkrvo="RRK 2021" verwart="d" typ="e" gldart="PARA" gldsort="50" gldnr="12b" ursprung="u">12b</rvolink>, <rvolink abkrvo="RRK 2021" verwart="d" typ="e" gldart="PARA" gldsort="50" gldnr="12c" ursprung="u">12c</rvolink>, <rvolink abkrvo="RRK 2021" verwart="d" typ="e" gldart="PARA" gldsort="50" gldnr="14" ursprung="u">14</rvolink>, <rvolink abkrvo="RRK 2021" verwart="d" typ="e" gldart="PARA" gldsort="50" gldnr="15" ursprung="u">15</rvolink> und <rvolink abkrvo="RRK 2021" verwart="d" typ="e" gldart="PARA" gldsort="50" gldnr="16" ursprung="u">16</rvolink> können ganz oder teilweise vorzeitig eingestellt werden, wenn</absatz>
          <liste>
            <aufzaehlung ebene="1" art="normal">
              <listelem>
                <symbol stellen="2">1.</symbol>sich die Undurchführbarkeit herausstellt,</listelem>
              <listelem>
                <symbol stellen="2">2.</symbol>die leistungsempfangende Person durch ihr Verhalten die ordnungsgemäße Durchführung vereitelt oder</listelem>
              <listelem>
                <symbol stellen="2">3.</symbol>sich die Angaben oder Unterlagen über die Einkommens- oder Vermögensverhältnisse als unvollständig oder unrichtig erweisen.</listelem>
            </aufzaehlung>
          </liste>
        </abschnitt>
