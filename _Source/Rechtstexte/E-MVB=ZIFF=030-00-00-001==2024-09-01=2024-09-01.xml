<ueberschrift level="2" keepwithnext="1" widowctrl="1" halign="c" typ="g2">Dachverband der Sozialversicherungsträger <br/>(<rvolink ursprung="u" gldnr="30" gldsort="50" gldart="PARA" typ="e" verwart="d" abkrvo="ASVG">§ 30</rvolink><nolink> ASVG</nolink>)</ueberschrift>
<ueberschrift typ="para" halign="c" level="3">Dachverband der Sozialversicherungsträger</ueberschrift>
<absatz typ="satz" halign="j">Die in den <rvolink abkrvo="ASVG" verwart="d" typ="e" gldart="PARA" gldsort="50" gldnr="23" ursprung="u">§§ 23 bis 25</rvolink><nolink> ASVG</nolink> bezeichneten Versicherungsträger und die Träger der im <rvolink abkrvo="ASVG" verwart="d" typ="e" gldart="PARA" gldsort="50" gldnr="2" abs="2" ursprung="u">§ 2 Abs. 2</rvolink><nolink> ASVG</nolink> bezeichneten Sonderversicherungen gehören dem Dachverband der Sozialversicherungsträger (kurz Dachverband) an. Die Obliegenheiten des Dachverbandes sind in <rvolink abkrvo="ASVG" verwart="d" typ="e" gldart="PARA" gldsort="50" gldnr="30" abs="2" ursprung="u">§ 30 Abs. 2</rvolink><nolink> ASVG</nolink> geregelt.</absatz>
</abschnitt>
