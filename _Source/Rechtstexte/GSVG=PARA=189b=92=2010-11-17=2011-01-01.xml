<abschnitt nr="1" typ="ns" paperf="h" endnhier="true">
          
          
          
          
          
          <ueberschrift typ="para" halign="c" level="3">Aufgaben</ueberschrift>
          <absatz typ="abs" halign="j">
            <gldsym>§ 189b.</gldsym> Das Servicezentrum hat insbesondere folgende Aufgaben:</absatz>
          <liste>
            <ziffernliste ebene="1">
              <listelem>
                <symbol stellen="2">1.</symbol>Erteilung von Auskünften über</listelem>
            </ziffernliste>
            <literaliste ebene="2">
              <listelem>
                <symbol stellen="2">a)</symbol>bestehende Versicherungsverhältnisse und deren Rechtswirkungen;</listelem>
              <listelem>
                <symbol stellen="2">b)</symbol>die beitragsrechtlichen Auswirkungen von Versicherungsverhältnissen;</listelem>
              <listelem>
                <symbol stellen="2">c)</symbol>das Versichertenservice der zuständigen Sozialversicherungsträger und das Service des Künstler -Sozialversicherungsfonds;</listelem>
              <listelem>
                <symbol stellen="2">d)</symbol>das Meldeverfahren aus dem jeweiligen Versicherungsverhältnis;</listelem>
              <listelem>
                <symbol stellen="2">e)</symbol>die Anspruchsvoraussetzungen für Leistungen aus der Sozialversicherung;</listelem>
              <listelem>
                <symbol stellen="2">f)</symbol>allgemeine Angelegenheiten des Verfahrens vor dem Sozialversicherungsträger und dem Künstler-Sozialversicherungsfonds;</listelem>
              <listelem>
                <symbol stellen="2">g)</symbol>Anträge auf Leistungen aus der Arbeitslosenversicherung;</listelem>
            </literaliste>
            <ziffernliste ebene="1">
              <listelem>
                <symbol stellen="2">2.</symbol>Unterstützung bezüglich der Melde- und Auskunftspflichten nach den <rvolink abkrvo="GSVG" verwart="d" typ="e" gldart="PARA" gldsort="70" gldnr="18" bereich="BIS" bis="22" ursprung="u">§§ 18 bis 22</rvolink>;</listelem>
              <listelem>
                <symbol stellen="2">3.</symbol>Entgegennahme und Weiterleitung von Anträgen auf alle Arten von Leistungen der Sozialversicherung, auf freiwillige Versicherung, auf Rückerstattung von Beiträgen, auf Differenzbeitragsvorschreibung, auf Feststellung der Versicherungszeiten und auf Feststellung der Versicherungspflicht;</listelem>
              <listelem>
                <symbol stellen="2">4.</symbol>Entgegennahme und Weiterleitung von Anträgen nach dem K-SVFG.</listelem>
            </ziffernliste>
          </liste>
          
        </abschnitt></nutzdaten>
