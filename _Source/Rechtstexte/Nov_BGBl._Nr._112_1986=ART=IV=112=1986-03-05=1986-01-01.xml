<abschnitt nr="1" typ="ns" paperf="h" endnhier="true">
          <ueberschrift typ="para" halign="c" widowctrl="1" keepwithnext="0" level="1">Artikel IV  <br/>Inkrafttreten</ueberschrift><absatz typ="abs"><gldsym>Art. IV</gldsym></absatz>
        
          
          
          
          
          
          <absatz typ="abs" halign="j">(1) Dieses Bundesgesetz tritt, soweit im folgenden nichts anderes bestimmt wird, am 1. Jänner 1986 in Kraft.</absatz>
          <absatz typ="abs" halign="j">(2) Es treten in Kraft:</absatz>
          <liste>
            <literaliste ebene="1">
              <listelem>
                <symbol stellen="2">a)</symbol>rückwirkend mit 1. Jänner 1984 Art. I Z 22 lit. a und Art. III Abs. 4;</listelem>
              <listelem>
                <symbol stellen="2">b)</symbol>rückwirkend mit 1. Jänner 1985 Art. I Z 5, 6 lit. a, 23 lit. b, 29, 30, 31 und Art. III Abs. 1 bis 3;</listelem>
              <listelem>
                <symbol stellen="2">c)</symbol>mit 1. Juli 1986 Art. I Z 40 und Art. II Abs. 11;</listelem>
              <listelem>
                <symbol stellen="2">d)</symbol>mit 1. Jänner 1987 Art. I Z 1 lit. a und c.</listelem>
            </literaliste>
          </liste></abschnitt></nutzdaten>
