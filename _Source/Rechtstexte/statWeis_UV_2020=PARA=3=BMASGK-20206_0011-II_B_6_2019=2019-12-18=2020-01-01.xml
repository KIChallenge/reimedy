      <metadaten nichtanzeigen="n" titrvo="Weisungen für die statistischen Nachweisungen der Unfallversicherungsträger 2020" abkrvo="statWeis UV 2020" dokart="Weisung" titaen="Statistische Weisungen für die Unfallversicherung 2020 StF" abkaen="statWeis UV 2020 StF" urheber="BMASGK" pubdat="2019-12-18" ikra="2020-01-01" sichtbarkeit="p" gldart="PARA" gldsort="80" gldnr="3">
        <puborgane><puborgan puborg="Erlass" nrpuborg="BMASGK-20206/0011-II/B/6/2019">Erlass   Nr. BMASGK-20206/0011-II/B/6/2019</puborgan>
          
