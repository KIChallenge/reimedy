      <nutzdaten>
        <abschnitt nr="1" typ="ns" paperf="h" endnhier="true">
          <ueberschrift typ="g1" halign="c" level="1">ABSCHNITT  II <br/>MONATSSTATISTIK</ueberschrift>
          <ueberschrift typ="para" halign="c" level="2"/>
          <absatz typ="abs" halign="j">
            <gldsym>§ 3.</gldsym> Im Rahmen der Monatsstatistik (<rvolink abkrvo="statWeis UV 2020" verwart="d" typ="e" gldart="PARA" gldsort="80" gldnr="4" ursprung="u">§ 4</rvolink>) haben die Unfallversicherungsträger alle für den Berichtsmonat in einer Daueranweisung stehenden Renten zuzüglich jener Renten, die für zwei oder mehrere Monate periodisch angewiesen werden, sowie die als Gesamtvergütung (<rvolink abkrvo="ASVG" verwart="d" typ="e" gldart="PARA" gldsort="80" gldnr="209" abs="2" ursprung="u">§ 209 Abs. 2</rvolink><nolink> ASVG</nolink>) ausbezahlten Renten nachzuweisen. Renten, die gemäß <nolink>§ 5</nolink>, BGBl. Nr. 177/1948, für Rechnung des Dienstgebers zur Auszahlung gelangen, sind nicht einzubeziehen.</absatz>
        </abschnitt>
      </nutzdaten>
