      <metadaten nichtanzeigen="n" titrvo="Schiedskommissionsverordnung 2010" abkrvo="SchKV 2014" dokart="V" titaen="Schiedskommissionsverordnung 2010 StF" abkaen="SchKV 2014 StF" urheber="BMG" pubdat="2013-10-29" ikra="2014-01-01" sichtbarkeit="p" gldart="PARA" gldnr="16" gldsort="70">
        <schlagw><textelem>Rechtsgrundlage: §§ 343a Abs. 3, 343b Abs. 3, 343d, 344, 345, 347 Abs. 4, 348f und 351 ASVG</textelem></schlagw><puborgane><puborgan puborg="BGBl." gldpuborg="II" nrpuborg="325" jahrgang="2013">BGBl. II  Nr. 325/2013 </puborgan>
        
          </puborgane>
