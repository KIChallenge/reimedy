<abschnitt nr="1" typ="ns" paperf="h" endnhier="true">
          <ueberschrift typ="para" halign="c" widowctrl="1" keepwithnext="0" level="1">Artikel IV <br/>Inkrafttreten</ueberschrift><absatz typ="abs"><gldsym>Art. IV</gldsym></absatz>
        
          
          
          
          
          
          
          
          
          
          <absatz typ="abs" halign="j">(1) Dieses Bundesgesetz tritt, soweit im folgenden nichts anderes bestimmt wird, am 1. Jänner 1988 in Kraft.</absatz>
          <absatz typ="abs" halign="j">(2) Es treten in Kraft:</absatz>
          <liste>
            <ziffernliste ebene="1">
              <listelem>
                <symbol stellen="2">1.</symbol>rückwirkend mit 1. Jänner 1986 Art. III Abs. 4;</listelem>
              <listelem>
                <symbol stellen="2">2.</symbol>rückwirkend mit 1. Juli 1986 Art. III Abs. 2;</listelem>
              <listelem>
                <symbol stellen="2">3.</symbol>rückwirkend mit 1. Jänner 1987 Art. I Z 5 lit. b und Z 31 und Art. III Abs. 1.</listelem>
            </ziffernliste>
          </liste>
          
        </abschnitt></nutzdaten>
