<nutzdaten>
<abschnitt>
<ueberschrift level="3" halign="c" typ="para">Artikel 13 
<br/>Träger des Aufenthaltsortes</ueberschrift>
<absatz typ="abs" halign="j">In den Fällen des Artikels 11 werden die Sachleistungen gewährt</absatz>
<absatz typ="satz" halign="j">in der Tschechischen Republik</absatz>
<absatz typ="abs" halign="j">von der für den Aufenthaltsort der betreffenden Person in Betracht kommenden Gesundheitsversicherungsanstalt,</absatz>
<absatz typ="satz" halign="j">in der Republik Österreich</absatz>
<absatz typ="abs" halign="j">von der für den Aufenthaltsort der betreffenden Person in Betracht kommenden Gebietskrankenkasse.</absatz>
</abschnitt>
