<uebrecht> <rvolink abkrvo="KBGG" ursprung="u" verwart="s" gldart="PARA" gldsort="50" gldnr="50" abs="38" typ="e" pubdat="2023-07-19" ikra="2023-07-20" puborg="BGBl." gldpuborg="I" nrpuborg="82" jahrgang="2023">§ 50 Abs. 38 idF 82/2023</rvolink><rvolink abkrvo="KBGG" ursprung="u" verwart="s" gldart="PARA" gldsort="50" gldnr="50" abs="37" typ="e" pubdat="2023-07-19" ikra="2023-07-20" puborg="BGBl." gldpuborg="I" nrpuborg="82" jahrgang="2023">§ 50 Abs. 37 idF 82/2023</rvolink><rvolink ursprung="u" abkrvo="KBGG" verwart="s" gldart="PARA" gldsort="50" gldnr="50" abs="31" pubdat="2022-10-31" ikra="2022-11-01" puborg="BGBl." gldpuborg="I" nrpuborg="174" jahrgang="2022" typ="e">§ 50 Abs. 31 idF 174/2022</rvolink><rvolink ursprung="u" abkrvo="KBGG" verwart="s" gldart="PARA" gldsort="50" gldnr="50" abs="30" pubdat="2022-10-31" ikra="2022-11-01" puborg="BGBl." gldpuborg="I" nrpuborg="174" jahrgang="2022" typ="e">§ 50 Abs. 30 idF 174/2022</rvolink><rvolink ursprung="u" abkrvo="KBGG" verwart="s" gldart="PARA" gldsort="70" gldnr="50" abs="16" pubdat="2016-07-08" ikra="2016-07-09" puborg="BGBl." gldpuborg="I" nrpuborg="53" jahrgang="2016" typ="e">§ 50 Abs. 16 idF 53/2016</rvolink></uebrecht><puborgane><puborgan puborg="BGBl." gldpuborg="I" nrpuborg="82" begseite="12" jahrgang="2023"/></puborgane></metadaten>
