      <uebrecht><textelem>Zur Aufhebung der Verbindlicherklärung in allen Bestimmungen vgl.</textelem><aenlink ursprung="u" abkaen="7. Änd MKO 2016" gldart="ZIFF" ziff="1" puborg="avsv" nrpuborg="161" jahrgang="2019">Z 1 avsv Nr. 161/2019</aenlink></uebrecht><puborgane><puborgan puborg="avsv" nrpuborg="161" jahrgang="2019"/></puborgane></metadaten>
      <nutzdaten>
        <abschnitt nr="1" typ="ns" paperf="h" endnhier="true">
          <ueberschrift typ="g1" halign="c" level="1">1. Teil <br/>Einführungsbestimmungen zur <nolink>Musterkrankenordnung</nolink> 2016</ueberschrift>
          <ueberschrift typ="para" halign="c" level="2">Grundlage und Geltungsbereich</ueberschrift>
          <absatz typ="abs" halign="j">
            <gldsym>§ 1.</gldsym> (1) Die <nolink>Musterkrankenordnung</nolink> wird vom Dachverband der Sozialversicherungsträger nach <rvolink abkrvo="ASVG" verwart="d" typ="e" gldart="PARA" gldsort="70" gldnr="456" abs="2" ursprung="u">§  456 Abs. 2</rvolink><nolink> ASVG</nolink> aufgestellt.</absatz>
          <absatz typ="abs" halign="j">(2) Sie gilt für alle im Dachverband der Sozialversicherungsträger zusammengefassten Krankenversicherungsträger.</absatz>
        </abschnitt>
