      <nutzdaten>
        <abschnitt nr="1" typ="ns" paperf="h" endnhier="true">
          <ueberschrift typ="para" halign="c" level="1">Wirksamkeitsbeginn</ueberschrift>
          <absatz typ="abs" halign="j">
            <gldsym>§ 7.</gldsym> (1) Diese Verordnung tritt in Kraft:</absatz>
          <liste>
            <ziffernliste ebene="1">
              <listelem>
                <symbol stellen="2">1.</symbol>mit 1. April 2019 für die Mitglieder der Überleitungsausschüsse nach den §§ 538v ASVG, 49 SVSG und 168c B-KUVG sowie für die Mitglieder der Verwaltungsräte nach den §§ 538x Abs. 2 und 538y Abs. 2 ASVG;</listelem>
              <listelem>
                <symbol stellen="2">2.</symbol>mit 15. April 2019 für die Mitglieder der Überleitungskonferenz nach § 538z Abs. 1 ASVG;</listelem>
              <listelem>
                <symbol stellen="2">3.</symbol>mit 1. Jänner 2020 für alle übrigen Mitglieder der Verwaltungskörper.</listelem>
            </ziffernliste>
          </liste>
          <absatz typ="abs" halign="j">(2) Die Verordnung BGBl. II Nr. 75/2014 tritt mit Ablauf des 31. Dezember 2019 außer Kraft.</absatz>
        </abschnitt>
