      <nutzdaten>
        <abschnitt nr="1" typ="ns" paperf="h" endnhier="true">
          <ueberschrift typ="g2" halign="c" level="2">4. Abschnitt <br/>Schutzbestimmungen</ueberschrift>
          
          <ueberschrift typ="para" halign="c" level="3">Haftungsverhältnisse</ueberschrift>
          <absatz typ="abs" halign="j">
            <gldsym>§ 34.</gldsym> (1) Zur Sicherstellung oder zur Hereinbringung von Verbindlichkeiten, die von der BV-Kasse für das der von ihr verwalteten Veranlagungsgemeinschaft zugeordnete Vermögen wirksam begründet wurden, kann nur auf dieses Exekution geführt werden.</absatz>
          <absatz typ="abs" halign="j">(2) Zur Sicherstellung oder Hereinbringung von Verbindlichkeiten, die von der BV-Kasse nicht für das der von ihr verwalteten Veranlagungsgemeinschaft zugeordnete Vermögen begründet wurden, kann auf dieses nicht Exekution geführt werden.</absatz>
          <abstand halign="l"/>
        </abschnitt>
      </nutzdaten>
