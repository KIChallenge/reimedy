<abschnitt nr="1" typ="ns" paperf="h" endnhier="true">
          <ueberschrift typ="para" halign="c" widowctrl="1" keepwithnext="0" level="1">Artikel IX <br/>Inkrafttreten</ueberschrift><absatz typ="abs"><gldsym>Art. IX</gldsym></absatz>
        <absatz typ="abs" halign="j">(1) Dieses Bundesgesetz tritt, soweit im folgenden nichts anderes bestimmt wird, mit 1. Juli 1990 in Kraft.</absatz>
          <absatz typ="abs" halign="j">(2) Es treten in Kraft:</absatz>
          <liste>
            <ziffernliste ebene="1">
              <listelem>
                <symbol stellen="2">1.</symbol>rückwirkend mit 1. Jänner 1988 Art. IV Z 1 lit. b, Z 3, Z 4, Z 10 und Z 12;</listelem>
              <listelem>
                <symbol stellen="2">2.</symbol>rückwirkend mit 1. Jänner 1990 Art. I Z 21, Z 25 und Z 26, Art. II Z 7, Art. III Z 4, Art. IV Z 11 und Z 14 lit. c und Art. V Z 15 lit. a;</listelem>
              <listelem>
                <symbol stellen="2">3.</symbol>mit 1. Jänner 1991 Art. I Z 1, Z 2 lit. a, Z 4, Z 12, Z 13 und Z 18 und Art. V Z 12.</listelem>
            </ziffernliste>
          </liste>
          <absatz typ="abs" halign="j">(3) Verordnungen auf Grund dieses Bundesgesetzes können bereits ab dem seiner Kundmachung folgenden Tag erlassen werden.</absatz></abschnitt></nutzdaten>
