<metadaten pubdat="2007-12-28" abkaen="GesWAnpG" dokart="BG" titaen="GesundheitswesenAnpassungsG - 33. Novelle" abkrvo="BSVG" sichtbarkeit="p" ikra="2008-01-01" gldnr="91" titrvo="Bauern-Sozialversicherungsgesetz" urheber="Bund" beschdat="2007-12-04" berkz="KVL; UVL; PVL; VMB; SELB; " gldart="PARA" indbr="66.02.04" gldsort="70" nichtanzeigen="n">
