      <metadaten gldart="PARA" gldsort="70" titrvo="Sozialversicherungs-Internetkundmachungsverordnung 2016" abkrvo="SV-InternetKV 2016" dokart="V" urheber="DVSV" beschdat="2015-11-17" pubdat="2015-11-25" ikra="2016-01-01" sichtbarkeit="p" nichtanzeigen="n" titaen="Sozialversicherungs-Internetkundmachungsverordnung 2016 StF" abkaen="SV-InternetKV 2016 StF" gldnr="1">
        <anm>Für im Internet gesichert kundzumachende Bildmarken für Amtssignaturen der Sozialversicherungsträger und des Hauptverbandes ergibt sich die gleiche Fundstelle aus der Amtssignatur - Fundstellenkundmachung (<rvolink ursprung="u" abkrvo="AmtSigFundstK 2016" verwart="d" gldart="KEIN" gldsort="0" typ="e">AmtSigFundstK 2016</rvolink>) avsv Nr. 209/2015.</anm><puborgane><puborgan puborg="avsv" nrpuborg="208" jahrgang="2015">avsv   Nr. 208/2015 </puborgan>
        
          </puborgane>
      </metadaten>
      <nutzdaten>
        <abschnitt endnhier="true" nr="1" paperf="h" typ="ns">
          <ueberschrift halign="c" typ="para" level="1">Internetadresse</ueberschrift>
          <absatz halign="j" typ="abs">
            <gldsym>§ 1.</gldsym> (1) Die von den Sozialversicherungsträgern und dem Hauptverband nach den Sozialversicherungsgesetzen im Internet zu verlautbarenden Rechtsvorschriften und anderen Veröffentlichungen sind unter der Internetadresse</absatz>
        
          <absatz typ="satz" widowctrl="1" keepwithnext="0" halign="c">
<b><wwwlink ursprung="u" url="https://www.ris.bka.gv.at/" gldart="KEIN" typ="e">www.ris.bka.gv.at</wwwlink></b>
</absatz>
          <liste>
            <schluss typ="Abs">zur Abfrage bereit zu halten. </schluss>
          </liste>
          <absatz halign="j" typ="abs">(2) Diese Adresse ist bei jeder amtlichen Verlautbarung außerhalb des rechtsverbindlichen Textes zu nennen.</absatz>
        </abschnitt></nutzdaten>
