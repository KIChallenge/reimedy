      <metadaten nichtanzeigen="n" titrvo="Krankenordnung der Österreichischen Gesundheitskasse 2025" abkrvo="KrankenO OEGK 2025" dokart="KrankenO" titaen="Krankenordnung der Österreichischen Gesundheitskasse 2025 Stammfassung" abkaen="KrankenO OEGK 2025 StF" urheber="ÖGK" beschdat="2025-12-09" pubdat="2025-12-19" ikra="2025-12-20" sichtbarkeit="p" gldart="PARA" gldnr="27" gldsort="50">
