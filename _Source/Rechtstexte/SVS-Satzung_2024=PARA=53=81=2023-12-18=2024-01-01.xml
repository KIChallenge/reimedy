      <nutzdaten>
        <abschnitt nr="1" typ="ns" paperf="h" endnhier="true">
          <ueberschrift typ="para" halign="c" level="4">Anfall der Versehrtenrente für teilversicherte selbständig erwerbstätige und für selbstversicherte Personen <br/>(<rvolink abkrvo="ASVG" verwart="d" typ="e" gldart="PARA" gldsort="50" gldnr="204" abs="3" ursprung="u">§ 204 Abs. 3</rvolink><nolink> ASVG</nolink>)</ueberschrift>
          <absatz typ="abs" halign="j">
            <gldsym>§ 53.</gldsym> Den nach <rvolink abkrvo="ASVG" verwart="d" typ="e" gldart="PARA" gldsort="50" gldnr="7" ziff="3" lit="c" ursprung="u">§ 7 Z 3 lit. c</rvolink><nolink> ASVG</nolink> teilversicherten öffentlichen Verwaltern und den nach den <rvolink abkrvo="ASVG" verwart="d" typ="e" gldart="PARA" gldsort="50" gldnr="8" ursprung="u">§§ 8</rvolink> und <rvolink abkrvo="ASVG" verwart="d" typ="e" gldart="PARA" gldsort="50" gldnr="19" ursprung="u">19</rvolink><nolink> ASVG</nolink> Unfallversicherten, für die die SVS gemäß <rvolink abkrvo="ASVG" verwart="d" typ="e" gldart="PARA" gldsort="50" gldnr="28" ziff="2" ursprung="u">§ 28 Z 2</rvolink><nolink> ASVG</nolink> sachlich zuständig ist, wird die Versehrtenrente oder an deren Stelle das Versehrtengeld ab dem 29. Tag nach dem Eintritt des Versicherungsfalles gewährt, wenn der Lebensunterhalt der versehrten Person gefährdet ist.</absatz>
        </abschnitt>
