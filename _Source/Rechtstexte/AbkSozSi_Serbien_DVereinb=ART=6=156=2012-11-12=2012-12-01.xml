      <nutzdaten>
        <abschnitt nr="1" typ="ns" paperf="h" endnhier="true">
          <ueberschrift typ="art" halign="c" level="3">Artikel 6 <br/>Erstattung bei Nichteinhaltung des vorgesehenen Verfahrens</ueberschrift>
          
          <absatz typ="abs" halign="j">
            <gldsym>Art. 6</gldsym>
          </absatz><absatz typ="abs" halign="j">(1) Die entstandenen Aufwendungen sind auf Antrag der betreffenden Person vom zuständigen Träger nach den für den in <rvolink ursprung="u" abkrvo="AbkSozSi Serbien" verwart="d" gldart="ART" gldsort="80" gldnr="14" typ="e">Artikel 14</rvolink> des Abkommens bezeichneten Träger maßgebenden Sätzen zu erstatten, sofern die im <rvolink ursprung="u" abkrvo="AbkSozSi Serbien DVereinb" verwart="d" gldart="ART" gldsort="80" gldnr="5" typ="e">Artikel 5</rvolink> vorgesehenen Verfahrensregelungen für die Anwendung des <rvolink ursprung="u" abkrvo="AbkSozSi Serbien" verwart="d" gldart="ART" gldsort="80" gldnr="11" typ="e">Artikels 11</rvolink> des Abkommens nicht eingehalten werden konnten.</absatz>
          <absatz typ="abs" halign="j">(2) Der in <rvolink ursprung="u" abkrvo="AbkSozSi Serbien" verwart="d" gldart="ART" gldsort="80" gldnr="14" typ="e">Artikel 14</rvolink> des Abkommens bezeichnete Träger hat dem zuständigen Träger auf dessen Verlangen die erforderlichen Auskünfte mit dem dafür vorgesehenen Formblatt zu erteilen.</absatz>
        </abschnitt>
      </nutzdaten>
