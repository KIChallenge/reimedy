<metadaten gldart="PARA" gldsort="70" titrvo="Dienstordnung C für die Arbeiter bei den Sozialversicherungsträgern Österreichs 2005" abkrvo="DO.C 2005" dokart="DO" titaen="98. Änderung der Dienstordnung C für die Arbeiter bei den Sozialversicherungsträgern Österreichs 2005" abkaen="98. Änd DO. C 2005" urheber="DVSV" beschdat="2024-12-17" pubdat="2024-12-18" ikra="2025-01-01" sichtbarkeit="p" gldnr="254" nichtanzeigen="n">

