<nutzdaten>
<abschnitt>
<ueberschrift level="4" halign="c" typ="para">Artikel 12 
<br/>Träger des Aufenthaltsortes</ueberschrift>
<absatz typ="abs" halign="j">In den Fällen des Artikels 11 werden die Sachleistungen gewährt</absatz>
<absatz typ="abs" halign="j">in der Republik Österreich</absatz>
<absatz typ="abs" halign="j">von der für den Aufenthaltsort der betreffenden Person in Betracht kommenden Gebietskrankenkasse,</absatz>
<absatz typ="abs" halign="j">in der Slowakischen Republik</absatz>
<absatz typ="abs" halign="j">von der Allgemeinen Gesundheitsversicherungsanstalt oder der nach den slowakischen Rechtsvorschriften bestimmten Einrichtung.</absatz>
</abschnitt>
</nutzdaten>
