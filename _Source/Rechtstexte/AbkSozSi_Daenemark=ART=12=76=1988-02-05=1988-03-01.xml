<absatz typ="abs" widowctrl="1" keepwithnext="0" halign="j">
<gldsym>Artikel 12 </gldsym>
</absatz>
<absatz typ="abs" widowctrl="1" keepwithnext="0" halign="j">In den Fällen des Artikels 11 Absatz 1 zweiter Satz sind die Leistungen zu gewähren </absatz>
<absatz typ="abs" widowctrl="1" keepwithnext="0" halign="j">in Österreich</absatz>
<absatz typ="abs" widowctrl="1" keepwithnext="0" halign="j">von der für den Aufenthaltsort der betreffenden</absatz>
<absatz typ="abs" widowctrl="1" keepwithnext="0" halign="j">Person zuständigen Gebietskrankenkasse,</absatz>
<absatz typ="abs" widowctrl="1" keepwithnext="0" halign="j">in Dänemark</absatz>
<absatz typ="abs" widowctrl="1" keepwithnext="0" halign="j">von den für den Aufenthaltsort der betreffenden</absatz>
<absatz typ="abs" widowctrl="1" keepwithnext="0" halign="j">Person in Betracht kommenden Gesundheitseinrichtungen</absatz>
<absatz typ="abs" widowctrl="1" keepwithnext="0" halign="j">des Landkreises oder der Gemeinde.</absatz>
</abschnitt>
