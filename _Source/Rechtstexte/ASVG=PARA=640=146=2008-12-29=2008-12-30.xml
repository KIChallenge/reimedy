<abschnitt nr="1" typ="ns" paperf="h" endnhier="true">
<ueberschrift typ="para" halign="c" level="3">Anpassung der Leistungen aus der Unfallversicherung und der Ausgleichszulagenrichtsätze für das Kalenderjahr 2009</ueberschrift>
<absatz typ="abs" halign="j">
<gldsym>§ 640.</gldsym> Abweichend von den <rvolink abkrvo="ASVG" verwart="d" typ="e" gldart="PARA" gldsort="70" gldnr="108g" abs="1" ursprung="u">§§ 108g Abs. 1</rvolink> und <rvolink abkrvo="ASVG" verwart="d" typ="e" gldart="PARA" gldsort="70" gldnr="293" abs="2" ursprung="u">293 Abs. 2</rvolink> sind die Renten aus der Unfallversicherung, die Bemessungsgrundlagen nach den <rvolink abkrvo="ASVG" verwart="d" typ="e" gldart="PARA" gldsort="70" gldnr="77" abs="4" ursprung="u">§§ 77 Abs. 4</rvolink>, <rvolink abkrvo="ASVG" verwart="d" typ="e" gldart="PARA" gldsort="70" gldnr="181" abs="1" ursprung="u">181 Abs. 1</rvolink>, <rvolink abkrvo="ASVG" verwart="d" typ="e" gldart="PARA" gldsort="70" gldnr="181" ziff="1" ursprung="u" abs="2">Abs. 2 Z 1</rvolink> und <rvolink abkrvo="ASVG" verwart="d" typ="e" gldart="PARA" gldsort="70" gldnr="181" ziff="2" ursprung="u" abs="1">2</rvolink> sowie <rvolink abkrvo="ASVG" verwart="d" typ="e" gldart="PARA" gldsort="70" gldnr="181" abs="6" ursprung="u">Abs. 6</rvolink> und <rvolink abkrvo="ASVG" verwart="d" typ="e" gldart="PARA" gldsort="70" gldnr="2" abs="181b" lit="a" ursprung="u">181b lit. a</rvolink>, <rvolink abkrvo="ASVG" verwart="d" typ="e" gldart="PARA" gldsort="70" gldnr="181b" lit="b" ursprung="u">b</rvolink> und <rvolink abkrvo="ASVG" verwart="d" typ="e" gldart="PARA" gldsort="70" gldnr="181b" lit="c" ursprung="u">c</rvolink> sowie die Beträge nach <rvolink abkrvo="ASVG" verwart="d" typ="e" gldart="PARA" gldsort="70" gldnr="212" abs="3" ursprung="u">§ 212 Abs. 3</rvolink> und die Ausgleichszulagenrichtsätze für das Kalenderjahr 2009 nicht mit dem <rvolink abkrvo="verändW" verwart="d" typ="e" gldart="ZAHL" gldsort="130" ursprung="u" gldnr="16">Anpassungsfaktor</rvolink>, sondern mit dem Faktor 1,034 zu vervielfachen.</absatz>
</abschnitt>
