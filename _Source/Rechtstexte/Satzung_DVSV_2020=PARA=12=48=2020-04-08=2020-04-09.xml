        <abschnitt nr="1" typ="ns" paperf="h" endnhier="true">
          <ueberschrift typ="para" halign="c" level="1">Büro</ueberschrift>
          <absatz typ="abs" halign="j">
            <gldsym>§ 12.</gldsym> (1) Die unmittelbare Durchführung der Aufgaben des Dachverbandes obliegt dem Büro des Dachverbandes (<rvolink abkrvo="ASVG" verwart="d" typ="e" gldart="PARA" gldsort="80" gldnr="441e" ursprung="u">§ 441e</rvolink><nolink> ASVG</nolink>) nach den Beschlüssen und Weisungen der Konferenz.</absatz>
          <absatz typ="abs" halign="j">(2) Dem Büro obliegt die organisatorische Betreuung der Verwaltungskörper.</absatz>
        </abschnitt>
