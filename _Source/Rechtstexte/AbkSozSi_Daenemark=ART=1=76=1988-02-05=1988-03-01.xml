<metadaten gldart="ART" gldsort="80" titrvo="Abkommen zwischen der Republik Österreich und dem Königreich Dänemark über Soziale Sicherheit" abkrvo="AbkSozSi Dänemark" dokart="SVAbk" titaen="Abkommen zwischen der Republik Österreich und dem Königreich Dänemark über Soziale Sicherheit StF" abkaen="AbkSozSi Dänemark StF" urheber="Bund" beschdat="1987-06-16" pubdat="1988-02-05" ikra="1988-03-01" sichtbarkeit="p" gldnr="1">
