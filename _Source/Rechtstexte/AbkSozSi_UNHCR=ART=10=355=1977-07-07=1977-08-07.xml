<absatz typ="satz" halign="j" widowctrl="1" keepwithnext="0">
<gldsym>Artikel 10</gldsym>
</absatz>
<absatz typ="abs" halign="j" widowctrl="1" keepwithnext="0">Angestellte können</absatz>
<liste>
<ziffernliste ebene="1">
<listelem>
<symbol stellen="2">1.</symbol>das Recht nach Art. 2 Abs. 1 und 2 nur binnen drei Monaten ab Beschäftigungsbeginn,</listelem>
<listelem>
<symbol stellen="2">2.</symbol>das Recht nach Art. 3 Abs. 4 nur binnen zwei Wochen nach ihrer Verständigung von der Aufnahme in den Pensionsfonds,</listelem>
</ziffernliste>
</liste>
<liste>
<schluss typ="Abs">bei der Wiener Gebietskrankenkasse für Arbeiter und Angestellte schriftlich geltend machen.</schluss>
</liste>
