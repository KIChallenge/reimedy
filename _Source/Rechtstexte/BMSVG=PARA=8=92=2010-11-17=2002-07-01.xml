        <abschnitt nr="1" typ="ns" paperf="h" endnhier="true">
          <ueberschrift typ="para" halign="c" level="3">Verfügungs- und Exekutionsbeschränkungen</ueberschrift>
          <absatz typ="abs" halign="j">
            <gldsym>§ 8.</gldsym> Die Abtretung oder Verpfändung von Abfertigungsanwartschaften im Sinne des <rvolink abkrvo="BMSVG" verwart="d" typ="e" gldart="PARA" gldsort="70" gldnr="3" ziff="3" ursprung="u">§ 3 Z 3</rvolink> ist rechtsunwirksam, soweit der Anwartschaftsberechtigte darüber nicht als Abfertigungsanspruch verfügen kann. Für die Pfändung gilt die <nolink>Exekutionsordnung</nolink> (EO), RGBl. Nr. 79/1896.</absatz>
          <abstand halign="l"/>
        </abschnitt>
      </nutzdaten>
