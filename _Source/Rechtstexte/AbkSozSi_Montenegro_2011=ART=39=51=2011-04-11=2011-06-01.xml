      <nutzdaten>
        <abschnitt nr="1" typ="ns" paperf="h" endnhier="true">
          <ueberschrift typ="para" halign="c" level="2" widowctrl="1">Artikel 39 <br/>Außer-Kraft-Treten</ueberschrift>
          <absatz typ="abs" halign="j">
            <gldsym>Art. 39</gldsym>
          </absatz><absatz typ="abs" halign="j">(1) Mit In-Kraft-Treten dieses Abkommens zwischen der Republik Österreich und Montenegro ist im Verhältnis zwischen den beiden Vertragsstaaten das Abkommen zwischen der Republik Österreich und der Bundesrepublik Jugoslawien über soziale Sicherheit<super>1</super>, unterzeichnet am 5. Juni 1998 in Belgrad, nicht mehr anzuwenden.</absatz>
          
          <absatz typ="abs" halign="j">(2) Die Bestimmungen des Abkommens vom 5. Juni 1998 gelten für noch nicht abgeschlossene Verfahren und für erworbene Ansprüche weiter.</absatz>
          <abstand halign="l"/>
          <abstand halign="l"/><abstand halign="l"/><absatz typ="satz" halign="j">
            <super>1</super> Kundgemacht in BGBl. III Nr. 100/2002 idF BGBl. III Nr. 124/2007 und BGBl. III Nr. 22/2009.</absatz>
          
        </abschnitt>
