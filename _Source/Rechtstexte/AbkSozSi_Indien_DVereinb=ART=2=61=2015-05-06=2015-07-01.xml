      <nutzdaten>
        <abschnitt nr="1" typ="ns" paperf="h" endnhier="true">
          <ueberschrift typ="para" halign="c" level="2">Artikel 2 <br/>Verbindungsstellen</ueberschrift>
          
          <absatz typ="abs" halign="j">
            <gldsym>Art. 2</gldsym>
          </absatz><absatz typ="abs" halign="j">(1) Verbindungsstellen nach <rvolink ursprung="u" abkrvo="AbkSozSi Indien" verwart="d" gldart="ART" gldsort="80" gldnr="16" typ="e">Artikel 16</rvolink> des Abkommens sind:</absatz>
          <abstand/><absatz typ="abs" halign="j" widowctrl="1" keepwithnext="0">in der Republik Österreich</absatz>
          <abstand/><absatz typ="abs" halign="j" widowctrl="1" keepwithnext="0">- der Hauptverband der österreichischen Sozialversicherungsträger;</absatz>
          <abstand/><absatz typ="abs" halign="j" widowctrl="1" keepwithnext="0">in der Republik Indien</absatz>
          <abstand/><absatz typ="abs" halign="j" widowctrl="1" keepwithnext="0">- die Einrichtung des Altersvorsorgefonds (Employees’ Provident Fund Organisation).</absatz>
          <abstand/><absatz typ="abs" halign="j">(2) Die zuständigen Behörden können einander schriftlich Änderungen der Namen der Verbindungsstellen und zuständigen Stellen mitteilen, ohne dass dies eine Änderung der Durchführungsvereinbarung erforderlich macht.</absatz>
        </abschnitt>
      </nutzdaten>
