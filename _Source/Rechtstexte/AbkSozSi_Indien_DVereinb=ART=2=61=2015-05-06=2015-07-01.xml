      <metadaten nichtanzeigen="n" titrvo="Durchführungsvereinbarung Indien" abkrvo="AbkSozSi Indien DVereinb" dokart="SVAbk" urheber="Bund" pubdat="2015-05-06" ikra="2015-07-01" sichtbarkeit="p" titaen="Vereinbarung zur Durchführung des Abkommens zwischen der Republik Österreich und der Republik Indien über soziale Sicherheit StF" abkaen="AbkSozSi Indien DVereinb StF" gldart="ART" gldnr="2" gldsort="80">
        <schlagw><textelem>Indien</textelem></schlagw><puborgane><puborgan puborg="BGBl." gldpuborg="III" nrpuborg="61" begseite="1" jahrgang="2015">BGBl. III  Nr. 61/2015 , S.1</puborgan>
          
        </puborgane>
