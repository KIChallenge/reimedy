<abschnitt nr="1" typ="ns" paperf="h" endnhier="true">
          <ueberschrift typ="para" halign="c" widowctrl="1" keepwithnext="0" level="1">Artikel VIII <br/>Inkrafttreten</ueberschrift><absatz typ="abs"><gldsym>Art. VIII</gldsym></absatz>
        <absatz typ="abs" halign="j">(1) Diese Bundesgesetz tritt, soweit im folgenden nichts anderes bestimmt wird, mit 1. Jänner 1984 in Kraft.</absatz>
          <absatz typ="abs" halign="j">(2) Es treten in Kraft:</absatz>
          <liste>
            <literaliste ebene="2">
              <listelem>
                <symbol stellen="2">a)</symbol>mit dem Beginn des Beitragszeitraumes Jänner 1984 Art. I Z 1 und 2 und Art. VII Z 3;</listelem>
              <listelem>
                <symbol stellen="2">b)</symbol>mit dem 1. April 1984 Art. I Z 6 lit. a, b und d und 10 und Art. II Z 16 und 17.</listelem>
            </literaliste>
          </liste>
          <absatz typ="abs" halign="j">(3) Die Bestimmungen des Art. II Z 5 lit. a und Z 11 lit. a <i>(Anm.: §§ <rvolink ursprung="u" abkrvo="ASVG" verwart="s" gldart="PARA" gldsort="70" gldnr="253b" pubdat="1983-12-13" ikra="1984-01-01" puborg="BGBl." nrpuborg="590" jahrgang="1983" typ="e">253b</rvolink>, <rvolink ursprung="u" abkrvo="ASVG" verwart="s" gldart="PARA" gldsort="70" gldnr="276b" pubdat="1983-12-13" ikra="1984-01-01" puborg="BGBl." nrpuborg="590" jahrgang="1983" typ="e">276b</rvolink>)</i> treten mit Ablauf des 31. Dezember 1986 mit der Maßgabe außer Kraft, daß sie auf Leistungsansprüche, die bis zu diesem Zeitpunkt entstanden sind, weiterhin anzuwenden sind.</absatz></abschnitt></nutzdaten>
