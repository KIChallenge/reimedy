<nutzdaten>
<abschnitt>
<ueberschrift widowctrl="1" keepwithnext="1" halign="c" level="1" typ="g1">ABSCHNITT II 
<br/>Abgrenzung der Aufgabenbereiche</ueberschrift>
<ueberschrift widowctrl="1" keepwithnext="1" halign="c" level="2" typ="para">Aufgaben des Obmannes des Versicherungsträgers</ueberschrift>
<absatz typ="abs" widowctrl="1" keepwithnext="0" halign="j">
<gldsym>§ 4.</gldsym> (1) Dem Obmann des Versicherungsträgers obliegen:
</absatz>
<liste>
<ziffernliste ebene="1">
<listelem>
<symbol stellen="2">1.</symbol>die Anberaumung der Lehrgänge (
<rvolink abkrvo="Prüfungsordnung Grundausbildung" verwart="d" typ="e" gldart="PARA" gldsort="70" gldnr="8" abs="1" ursprung="p">§ 8 Abs. 1</rvolink> erster Satz) und die Festsetzung der Termine der mündlichen Prüfungen;</listelem>
<listelem>
<symbol stellen="2">2.</symbol>die Entscheidung über die Zulassung der Kandidaten zur Grundausbildung mit Abschlussprüfung;</listelem>
<listelem>
<symbol stellen="2">3.</symbol>die Bestellung des Kommissionsvorsitzenden (
<rvolink abkrvo="Prüfungsordnung Grundausbildung" verwart="d" typ="e" gldart="PARA" gldsort="70" gldnr="1" abs="3" ursprung="p">§ 1 Abs. 3</rvolink>);</listelem>
<listelem>
<symbol stellen="2">4.</symbol>die Bestellung der Prüfer (
<rvolink abkrvo="Prüfungsordnung Grundausbildung" verwart="d" typ="e" gldart="PARA" gldsort="70" gldnr="1" abs="4" ursprung="p">§ 1 Abs. 4</rvolink> erster Satz) und der Berichterstatter (
<rvolink abkrvo="Prüfungsordnung Grundausbildung" verwart="d" typ="e" gldart="PARA" gldsort="70" gldnr="7" abs="1" ursprung="u">§ 7 Abs. 1</rvolink>);</listelem>
<listelem>
<symbol stellen="2">5.</symbol>die Zuordnung der Prüfungsgegenstände an die Prüfer (
<rvolink abkrvo="Prüfungsordnung Grundausbildung" verwart="d" typ="e" gldart="PARA" gldsort="70" gldnr="14" abs="3" ursprung="u">§ 14 Abs. 3</rvolink>);</listelem>
<listelem>
<symbol stellen="2">6.</symbol>die Entscheidung über Ansuchen gemäß 
<rvolink abkrvo="Prüfungsordnung Grundausbildung" verwart="d" typ="e" gldart="PARA" gldsort="70" gldnr="11" abs="2" ursprung="u">§ 11 Abs. 2</rvolink> und 
<rvolink abkrvo="Prüfungsordnung Grundausbildung" verwart="d" typ="e" gldart="PARA" gldsort="70" gldnr="11" abs="5" ursprung="u">5</rvolink>.</listelem>
</ziffernliste>
</liste>
<absatz typ="abs" widowctrl="1" keepwithnext="0" halign="j">(2) Die in Abs. 1 Z 1 bis 6 angeführten Aufgaben können dem Büro übertragen werden.</absatz>
</abschnitt>
</nutzdaten>
