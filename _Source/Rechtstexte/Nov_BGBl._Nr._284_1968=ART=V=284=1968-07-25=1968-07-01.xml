<abschnitt nr="1" typ="ns" paperf="h" endnhier="true">
          <ueberschrift typ="para" halign="c" widowctrl="1" keepwithnext="0" level="1">Artikel V</ueberschrift><absatz typ="abs"><gldsym>Art. V</gldsym></absatz>
        
          
          
          <absatz typ="abs" halign="j">(1) Dieses Bundesgesetz tritt, soweit nichts anderes bestimmt wird, am 1. Juli 1968 in Kraft.</absatz>
          <absatz typ="abs" halign="j">(2) Es treten in Kraft:</absatz>
          <liste>
            <literaliste ebene="2">
              <listelem>
                <symbol stellen="2">a)</symbol>die Bestimmungen des Art. I Z 4, 9, 10 und 15 rückwirkend mit 1. Juli 1967,</listelem>
              <listelem>
                <symbol stellen="2">b)</symbol>die Bestimmungen des Art. I Z 7 und Art. III rückwirkend mit 1. Jänner 1968,</listelem>
              <listelem>
                <symbol stellen="2">c)</symbol>die Bestimmung des Art. I Z 3 mit 1. Jänner 1969.</listelem>
            </literaliste>
          </liste></abschnitt></nutzdaten>
