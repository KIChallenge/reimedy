<metadaten gldsort="70" indbr="66.03.11" gldart="PARA" berkz="PFLEGE; " urheber="Bund" titrvo="Bundespflegegeldgesetz" gldnr="21g" ikra="2026-05-20" sichtbarkeit="p" abkrvo="BPGG" titaen="Mainovelle 32/2026" dokart="BG" abkaen="MaiNov 32/2026" pubdat="2026-05-19" nichtanzeigen="n" beschdat="2026-04-23">


<uebrecht><rvolink ursprung="u" abkrvo="BPGG" verwart="s" gldart="PARA" gldsort="70" gldnr="48d" pubdat="2013-07-30" ikra="2014-01-01" puborg="BGBl." gldpuborg="I" nrpuborg="138" jahrgang="2013" typ="e" abs="2">§ 48d Ab. 2 idF 138/2013</rvolink><rvolink ursprung="u" abkrvo="BPGG" verwart="s" gldart="PARA" gldsort="70" gldnr="48d" pubdat="2013-07-30" ikra="2014-01-01" puborg="BGBl." gldpuborg="I" nrpuborg="138" jahrgang="2013" typ="e" abs="3">§ 48d Ab. 3 idF 138/2013</rvolink></uebrecht><puborgane><puborgan puborg="BGBl." gldpuborg="I" nrpuborg="32" begseite="1" jahrgang="2026"/></puborgane></metadaten>
