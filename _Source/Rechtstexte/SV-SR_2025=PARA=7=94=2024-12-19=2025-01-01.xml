      <metadaten titrvo="Sicherheitsrichtlinie für die gesetzliche Sozialversicherung (SV-Sicherheitsrichtlinie 2025)" abkrvo="SV-SR 2025" dokart="RL DVSV" urheber="DVSV" beschdat="2024-12-18" pubdat="2024-12-19" ikra="2025-01-01" sichtbarkeit="p" nichtanzeigen="n" titaen="Sicherheitsrichtlinie für die gesetzliche Sozialversicherung (SV-Sicherheitsrichtlinie 2025) StF" abkaen="SV-SR 2025 StF" gldart="PARA" gldnr="7" gldsort="50">
