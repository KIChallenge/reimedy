      <metadaten nichtanzeigen="n" titrvo="Satzung des Pensionsinstitutes der Linz AG 2024" abkrvo="Satzung PI Linz AG 2024" dokart="Satzung" titaen="Satzung des Pensionsinstitutes der Linz AG 2024 StF" abkaen="Satzung PI Linz AG 2024 StF" urheber="PI Linz" beschdat="2024-10-09" pubdat="2024-10-28" ikra="2024-10-29" sichtbarkeit="p" gldart="PARA" gldnr="13" gldsort="50">
