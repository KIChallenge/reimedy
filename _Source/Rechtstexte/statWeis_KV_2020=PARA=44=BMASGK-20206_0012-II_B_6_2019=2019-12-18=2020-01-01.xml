          <ueberschrift typ="para" halign="c" level="2">Verpflichtung zur Erstellung von Statistiken</ueberschrift>
          <absatz typ="abs" halign="j">
            <gldsym>§ 44.</gldsym> Die Sozialversicherungsanstalt der Selbständigen als Krankenversicherungsträger hat für ihren Rechenkreis gemäß <rvolink abkrvo="RechnVorschr SV" verwart="d" typ="e" gldart="PARA" gldsort="80" gldnr="4" abs="3" lit="b" ursprung="u">§ 4 Abs. 3 lit. b</rvolink> RV („Landwirtschaft“) statistische Nachweisungen für folgende Bereiche zu erstellen:</absatz>
          <liste>
            <aufzaehlung ebene="1" art="normal">
              <listelem>
                <symbol stellen="2">1.</symbol>Versichertenstatistik (<rvolink abkrvo="statWeis KV 2020" verwart="d" typ="e" gldart="PARA" gldsort="80" gldnr="45" ursprung="u">§ 45</rvolink>)</listelem>
              <listelem>
                <symbol stellen="2">2.</symbol>Leistungsstatistik (<rvolink abkrvo="statWeis KV 2020" verwart="d" typ="e" gldart="PARA" gldsort="80" gldnr="46" bereich="BIS" bis="53" ursprung="u">§§ 46 bis 53</rvolink>)</listelem>
            </aufzaehlung>
          </liste>
        </abschnitt>
