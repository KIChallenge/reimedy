<absatz typ="abs" widowctrl="1" keepwithnext="0" halign="j">Dieses Abkommen gilt
</absatz>
<liste>
<literaliste ebene="1">
<listelem>
<symbol stellen="2">a)</symbol>für Personen, für die die Rechtsvorschriften eines oder beider Vertragsstaaten gelten oder galten;</listelem>
<listelem>
<symbol stellen="2">b)</symbol>für andere Personen, soweit diese ihre Rechte von den in Buchstabe a bezeichneten Personen ableiten.</listelem>
</literaliste>
</liste>
