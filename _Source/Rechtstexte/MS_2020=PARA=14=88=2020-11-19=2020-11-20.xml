      <nutzdaten>
        <abschnitt nr="1" typ="ns" paperf="h" endnhier="true">
          <ueberschrift typ="art" halign="c" level="2">3. Abschnitt – Leistungsrecht</ueberschrift>
          <ueberschrift typ="para" halign="c" level="3">Wartezeit für Selbstversicherte</ueberschrift>
          <ueberschrift typ="para" halign="c">(<rvolink abkrvo="ASVG" verwart="d" typ="e" gldart="PARA" gldsort="80" gldnr="124" abs="1" ursprung="u">§ 124 Abs. 1</rvolink><nolink> ASVG</nolink>)</ueberschrift><absatz typ="abs" halign="j">
            <gldsym>§ 14.</gldsym> Selbstversicherte nach <rvolink abkrvo="ASVG" verwart="d" typ="e" gldart="PARA" gldsort="80" gldnr="16" ursprung="u">§ 16</rvolink><nolink> ASVG</nolink> haben erst nach einer Wartezeit von sechs Monaten unmittelbar vor Eintritt des Versicherungsfalles Anspruch auf Kassenleistungen. Dies gilt nicht</absatz>
          <liste>
            <ziffernliste ebene="1">
              <listelem>
                <symbol stellen="2">1.</symbol>für die Personen, die in <rvolink abkrvo="ASVG" verwart="d" typ="e" gldart="PARA" gldsort="80" gldnr="16" abs="2" ursprung="u">§ 16 Abs. 2</rvolink><nolink> ASVG</nolink> genannt sind, wenn ihre Beiträge von der Beitragsgrundlage nach <rvolink abkrvo="ASVG" verwart="d" typ="e" gldart="PARA" gldsort="80" gldnr="76" abs="1" ziff="2" ursprung="u">§ 76 Abs. 1 Z 2</rvolink> erster Halbsatz ASVG (begünstigte Beitragsgrundlage für Studenten/Studentinnen) berechnet werden,</listelem>
              <listelem>
                <symbol stellen="2">2.</symbol>für die in <rvolink abkrvo="ASVG" verwart="d" typ="e" gldart="PARA" gldsort="80" gldnr="16" abs="2a" ursprung="u">§ 16 Abs. 2a</rvolink> und <rvolink abkrvo="ASVG" verwart="d" typ="e" gldart="PARA" gldsort="80" gldnr="16" abs="2b" ursprung="u">2b</rvolink><nolink> ASVG</nolink> bezeichneten Personen sowie</listelem>
              <listelem>
                <symbol stellen="2">3.</symbol>für Personen, bei denen nach <rvolink abkrvo="ASVG" verwart="d" typ="e" gldart="PARA" gldsort="80" gldnr="124" abs="2" ursprung="u">§ 124 Abs. 2</rvolink><nolink> ASVG</nolink> das Erfordernis der Erfüllung der Wartezeit entfällt.</listelem>
            </ziffernliste>
          </liste>
        </abschnitt>
      </nutzdaten>
