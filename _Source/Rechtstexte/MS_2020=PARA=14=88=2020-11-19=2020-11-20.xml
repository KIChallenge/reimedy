      <metadaten titrvo="Mustersatzung 2020" abkrvo="MS 2020" dokart="MusterR" urheber="DVSV" sichtbarkeit="p" nichtanzeigen="n" titaen="Mustersatzung 2020 StF" abkaen="MS 2020 StF" beschdat="2020-10-21" pubdat="2020-11-19" ikra="2020-11-20" gldart="PARA" gldnr="14" gldsort="80">
        <puborgane><puborgan puborg="avsv" nrpuborg="88" jahrgang="2020">avsv   Nr. 88/2020 </puborgan>
        
          </puborgane>
