<gldsym>Artikel 1</gldsym>
</absatz>
<absatz typ="abs" halign="j">Für die Anwendung dieser Verordnung</absatz>
<liste>
<literaliste ebene="1">
<listelem>
<symbol stellen="2">a)</symbol>bezeichnet der Begriff „Verordnung“ die Verordnung (EWG) Nr. 1408/71;</listelem>
<listelem>
<symbol stellen="2">b)</symbol>bezeichnet der Begriff „Durchführungsverordnung“ diese Verordnung;</listelem>
<listelem>
<symbol stellen="2">c)</symbol>gelten die in Artikel 1 der Verordnung festgelegten Begriffsbestimmungen.</listelem>
</literaliste>
</liste>
