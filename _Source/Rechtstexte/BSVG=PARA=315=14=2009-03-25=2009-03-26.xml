<abschnitt nr="1" typ="ns" paperf="h" endnhier="true">
<ueberschrift typ="para" halign="c" level="3">Neufestsetzung des Schutzbetrages bei der Witwen(Witwer)pension</ueberschrift>
<absatz typ="abs" halign="j">
<gldsym>§ 315.</gldsym> (1) Rückwirkend mit 1. November 2008 werden ersetzt:</absatz>
<liste>
<ziffernliste ebene="1">
<listelem>
<symbol stellen="2">1.</symbol>im § 136 Abs. 6 der Ausdruck „1 667,97 €“ jeweils durch den Ausdruck „1 671,20 €“ und</listelem>
<listelem>
<symbol stellen="2">2.</symbol>im § 136 Abs. 6 in der am 30. September 2000 in Geltung gestandenen Fassung der Ausdruck „1 412,41 €“ jeweils durch den Ausdruck „1 415,14 €“.</listelem>
</ziffernliste>
</liste>
<absatz typ="abs" halign="j">(2) Die in Abs. 1 Z 1 und 2 jeweils zweitgenannten Beträge sind erstmals ab 1. Jänner 2010 mit dem <rvolink abkrvo="verändW" verwart="d" typ="e" gldart="ZAHL" gldsort="130" gldnr="16" ursprung="u">Anpassungsfaktor</rvolink> (§ 45) zu vervielfachen.</absatz>
</abschnitt>
