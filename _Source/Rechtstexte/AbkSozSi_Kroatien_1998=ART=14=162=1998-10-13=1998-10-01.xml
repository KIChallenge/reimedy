<ueberschrift level="4" halign="c" typ="para">Träger des Aufenthalts- oder Wohnortes</ueberschrift>
<absatz typ="abs" halign="j">In den Fällen des Artikels 11 Absatz 1 und des Artikels 13 Absatz 1 zweiter Satz werden die Leistungen gewährt</absatz>
<absatz typ="satz" halign="j">in Kroatien</absatz>
<table h-maxcols="2">
<tr h-start="0">
<td width="19" h-xval="285"/>
<td width="756" h-xval="11625">
<absatz typ="tabtext" halign="l">von der örtlich zuständigen Außenstelle der Kroatischen Anstalt für Krankenversicherung</absatz>
</td>
</tr>
</table>
<absatz typ="satz" halign="j">in Österreich</absatz>
<table h-maxcols="2">
<tr h-start="0">
<td width="19" h-xval="285"/>
<td width="752" h-xval="11565">
<absatz typ="tabtext" halign="l">von der für den Aufenthalts- oder Wohnort der betreffenden Person in Betracht kommenden Gebietskrankenkasse.</absatz>
</td>
</tr>
</table>
</abschnitt>
