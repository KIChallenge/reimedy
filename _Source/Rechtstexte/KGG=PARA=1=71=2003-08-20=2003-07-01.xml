<abschnitt>
<ueberschrift level="1" halign="c" typ="g1">Abschnitt 1 
<br/>Leistungsarten </ueberschrift>
<absatz typ="abs" halign="j">
<gldsym>§ 1.</gldsym> Als Karenzgeldleistungen werden nach Maßgabe dieses
Bundesgesetzes gewährt: </absatz>
<liste>
<ziffernliste ebene="1">
<listelem>
<symbol stellen="2">1.</symbol>das Karenzgeld;
  </listelem>
<listelem>
<symbol stellen="2">2.</symbol>die Teilzeitbeihilfe für unselbständig Erwerbstätige;</listelem>
<listelem>
<symbol>3.</symbol>der Zuschuß zum Karenzgeld oder zur Teilzeitbeihilfe;
  </listelem>
<listelem>
<symbol>4.</symbol>die Wiedereinstellungsbeihilfe.
</listelem>
</ziffernliste>
</liste>
</abschnitt>
