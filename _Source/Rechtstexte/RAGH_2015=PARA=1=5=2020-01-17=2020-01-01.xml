      <metadaten gldart="PARA" gldsort="70" nichtanzeigen="n" titrvo="Richtlinien über die AuftraggeberInnenhaftung 2015" abkrvo="RAGH 2015" dokart="RL DVSV" titaen="SV-OG Anpassungsverlautbarung" abkaen="SV-OG AnpVerl" urheber="DVSV" beschdat="2020-01-14" pubdat="2020-01-17" ikra="2020-01-01" sichtbarkeit="p" gldnr="1">
        
      <puborgane><puborgan puborg="avsv" nrpuborg="5" jahrgang="2020" begseite="8"/></puborgane></metadaten>
      <nutzdaten>
        <abschnitt endnhier="true" nr="1" paperf="h" typ="ns">
          <ueberschrift halign="c" typ="para" level="1">Geltungsbereich</ueberschrift>
          <absatz halign="j" typ="abs">
            <gldsym>§ 1.</gldsym> Diese Richtlinien gelten für die Aufteilung der Haftungsbeträge nach <rvolink abkrvo="ASVG" verwart="d" typ="e" gldart="PARA" gldsort="70" gldnr="67a" abs="5" ursprung="u">§ 67a Abs. 5</rvolink> <nolink>und</nolink> <rvolink abkrvo="ASVG" verwart="d" typ="e" gldart="PARA" gldsort="70" gldnr="67a" abs="5a" ursprung="u">Abs. 5a</rvolink><nolink> ASVG</nolink> und die Beteiligung der Österreichischen Gesundheitskasse, der Versicherungsanstalt für Eisenbahnen und Bergbau und der Sozialversicherungsanstalt der gewerblichen Wirtschaft an der Finanzierung des Dienstleistungszentrums samt Kostenersatz nach <rvolink abkrvo="ASVG" verwart="d" typ="e" gldart="PARA" gldsort="70" gldnr="67c" abs="1" ursprung="u">§ 67c Abs. 1</rvolink> vorletzter Satz <nolink>ASVG</nolink>. Sie sind gemäß <rvolink abkrvo="ASVG" verwart="d" typ="e" gldart="PARA" gldsort="80" gldnr="30" abs="3" ursprung="u">§ 30 Abs. 3</rvolink><nolink> ASVG</nolink> für die Österreichische Gesundheitskasse, die Versicherungsanstalt für Eisenbahnen und Bergbau sowie die Sozialversicherungsanstalt der gewerblichen Wirtschaft verbindlich.</absatz>
        </abschnitt>
      </nutzdaten>
