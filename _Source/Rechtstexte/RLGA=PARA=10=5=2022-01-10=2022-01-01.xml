      <nutzdaten>
        <abschnitt nr="1" typ="ns" paperf="h" endnhier="true">
          <ueberschrift typ="para" halign="c" level="3">Pflichtmodule</ueberschrift>
          <absatz typ="abs" halign="j">
            <gldsym>§ 10.</gldsym> (1) Die vier Pflichtmodule umfassen folgende Gebiete im Umfang aller Sozialversicherungsgesetze:</absatz>
          <liste>
            <aufzaehlung ebene="1" art="normal">
              <listelem>
                <symbol stellen="2">1.</symbol>Krankenversicherung,</listelem>
              <listelem>
                <symbol stellen="2">2.</symbol>Unfallversicherung,</listelem>
              <listelem>
                <symbol stellen="2">3.</symbol>Pensionsversicherung und</listelem>
              <listelem>
                <symbol stellen="2">4.</symbol>Grundzüge der österreichischen Sozialversicherung einschließlich der rechtlichen Rahmenbedingungen.</listelem>
            </aufzaehlung>
          </liste>
          <absatz typ="abs" halign="j">(2) Die Dauer eines Pflichtmoduls beträgt 16 Unterrichtseinheiten, wovon mind. 8 Unterrichtseinheiten in Präsenz abzuhalten sind. Entsprechende Lernunterlagen sind zur Verfügung zu stellen.</absatz>
        </abschnitt>
      </nutzdaten>
