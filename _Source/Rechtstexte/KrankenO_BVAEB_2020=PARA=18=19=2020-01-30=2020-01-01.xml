      <nutzdaten>
        <abschnitt nr="1" typ="ns" paperf="h" endnhier="true">
          <ueberschrift typ="para" halign="c" level="3">Klinisch-psychologische Diagnostik</ueberschrift>
          <absatz typ="abs" halign="j">
            <gldsym>§ 18.</gldsym> (1) Klinisch-psychologische Diagnostik kann außer in einer Vertragseinrichtung (<rvolink abkrvo="KrankenO BVAEB 2020" verwart="d" typ="e" gldart="PARA" gldsort="80" gldnr="14" abs="1" ursprung="u">§ 14 Abs. 1</rvolink>) bei einem*einer zur selbständigen Berufsausübung berechtigten klinischen Vertragspsychologen*Vertragspsychologin als Sachleistung auf Rechnung der BVAEB in Anspruch genommen werden. <rvolink abkrvo="KrankenO BVAEB 2020" verwart="d" typ="e" gldart="PARA" gldsort="80" gldnr="14" abs="3" ursprung="u">§ 14 Abs. 3</rvolink> und <rvolink abkrvo="KrankenO BVAEB 2020" verwart="d" typ="e" gldart="PARA" gldsort="80" gldnr="14" abs="4" ursprung="u">4</rvolink> gilt sinngemäß.</absatz>
          <absatz typ="abs" halign="j">(2) Für die Inanspruchnahme eines klinischen Psychologen*einer klinischen Psychologin erforderlich ist eine Verordnung (Zuweisung) durch</absatz>
          <liste>
            <ziffernliste ebene="1">
              <listelem>
                <symbol stellen="2">1.</symbol>einen Arzt*eine Ärztin, </listelem>
              <listelem>
                <symbol stellen="2">2.</symbol>einen Psychotherapeuten*eine Psychotherapeutin,</listelem>
              <listelem>
                <symbol stellen="2">3.</symbol>eine Vertragseinrichtung oder </listelem>
              <listelem>
                <symbol stellen="2">4.</symbol>eine eigene Einrichtung eines Versicherungsträgers.</listelem>
            </ziffernliste>
          </liste>
        </abschnitt>
