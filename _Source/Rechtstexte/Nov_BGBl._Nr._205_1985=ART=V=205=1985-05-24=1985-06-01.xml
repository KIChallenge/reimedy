          <ueberschrift typ="para" halign="c" widowctrl="1" keepwithnext="0" level="1">Artikel V</ueberschrift><absatz typ="abs"><gldsym>Art. V</gldsym></absatz>
        <absatz typ="abs" halign="j">(1) Dieses Bundesgesetz tritt, soweit im folgenden nichts anderes bestimmt wird, mit 1. Juni 1985 in Kraft.</absatz>
          <absatz typ="abs" halign="j">(2) Es treten in Kraft:</absatz>
          <liste>
            <literaliste ebene="1">
              <listelem>
                <symbol stellen="2">a)</symbol>rückwirkend mit 1. Jänner 1985 Art. I Z 3, Art. II Z l und Art. III Z l;</listelem>
              <listelem>
                <symbol stellen="2">b)</symbol>mit dem Beginn des Beitragszeitraumes Juni 1985 Art. I Z 1 und 2.</listelem>
            </literaliste>
