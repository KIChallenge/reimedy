      <nutzdaten>
        <abschnitt nr="1" typ="ns" paperf="h" endnhier="true">
          <ueberschrift typ="para" halign="c" level="4">Vergütung zahnärztlicher Behandlungen</ueberschrift>
          <absatz typ="abs" halign="j">
            <gldsym>§ 40.</gldsym> (1) Zur Vergütung eingereichte Honorarnoten über zahnärztliche Behandlungen haben insbesondere folgende Angaben über die erbrachten Leistungen zu enthalten:</absatz>
          <liste>
            <aufzaehlung ebene="1" art="normal">
              <listelem>
                <symbol stellen="3">1. </symbol>genaue Angaben über Art und Anzahl der erbrachten Leistungen (Diagnose, Therapie, erbrachte Einzelleistungen),</listelem>
              <listelem>
                <symbol stellen="3">2. </symbol>genaue Bezeichnung der behandelten oder ersetzen Zähne (Zahnbild),</listelem>
              <listelem>
                <symbol stellen="2">3.</symbol>das Datum (den Behandlungszeitraum), an dem die einzelnen Leistungen erbracht wurden,</listelem>
              <listelem>
                <symbol stellen="2">4.</symbol>bei Zahnersatz und kieferorthopädischen Behandlungen</listelem>
            </aufzaehlung>
            <aufzaehlung ebene="2" art="normal">
              <listelem>
                <symbol stellen="2">a)</symbol>Angaben über den Zahnstatus,</listelem>
              <listelem>
                <symbol stellen="2">b)</symbol>Unterlagen über die erfolgte Bewilligung.</listelem>
            </aufzaehlung>
            <aufzaehlung ebene="1" art="normal">
              <listelem>
                <symbol stellen="2">5.</symbol>Bei kieferorthopädischen Behandlungen sind zusätzlich folgende Unterlagen vorzulegen:</listelem>
            </aufzaehlung>
            <aufzaehlung ebene="2" art="normal">
              <listelem>
                <symbol stellen="2">a)</symbol>(digitales) Anfangsmodell (dreidimensional getrimmtes Modell),</listelem>
              <listelem>
                <symbol stellen="2">b)</symbol>intraorales Foto (Oberkiefer und Unterkiefer occlusal sowie rechts, frontal und links),</listelem>
              <listelem>
                <symbol stellen="2">c)</symbol>extraorales Foto (seitlich, frontal, frontal lächelnd),</listelem>
              <listelem>
                <symbol stellen="2">d)</symbol>Bissregistrat,</listelem>
              <listelem>
                <symbol stellen="2">e)</symbol>Panoramaröntgen,</listelem>
              <listelem>
                <symbol stellen="2">f)</symbol>laterales Fernröntgen,</listelem>
              <listelem>
                <symbol stellen="2">g)</symbol>Behandlungsplan inkl. Erfolgsannahme,</listelem>
              <listelem>
                <symbol stellen="2">h)</symbol>Behandlungsplan mit Feststellung IOTN 4 und 5,</listelem>
              <listelem>
                <symbol stellen="2">i)</symbol>Therapievorschlag mit Angabe der Gerätebezeichnung und ob abnehmbar oder festsitzend,</listelem>
              <listelem>
                <symbol stellen="2">j)</symbol>Angabe, ob das Gerät kosmetische Funktionen aufweist,</listelem>
              <listelem>
                <symbol stellen="2">k)</symbol>(digitales) Endmodell.</listelem>
            </aufzaehlung>
          </liste>
          <absatz typ="abs" halign="j">(2) <rvolink abkrvo="SVS-KrankenO 2024" verwart="d" typ="e" gldart="PARA" gldsort="50" gldnr="19" ursprung="u">§ 19</rvolink> sowie <rvolink abkrvo="SVS-KrankenO 2024" verwart="d" typ="e" gldart="PARA" gldsort="50" gldnr="38" ursprung="u">§ 38</rvolink> gelten sinngemäß.</absatz>
        </abschnitt>
