      <nutzdaten>
        <abschnitt nr="1" typ="ns" paperf="h" endnhier="true">
          <ueberschrift typ="para" halign="c" level="1">Pflegegeldstatistik </ueberschrift><absatz typ="abs" halign="j"><gldsym>§ 13.</gldsym> (1) Im Rahmen der Pfegegeldstatistik sind aus der Pflegegeldinformation des Dachverbandes (PFIF) monatliche Statistiken zu erstellen:</absatz>
          <liste>
            <aufzaehlung ebene="1" art="normal">
              <listelem>
                <symbol stellen="2">1.</symbol>Auswertungen über die Zahl der Anspruchsberechtigten, Bezieher und Anweisungsbeträge (<rvolink abkrvo="statWeis SV 2020" verwart="d" typ="e" gldart="PARA" gldsort="80" gldnr="14" ursprung="u">§ 14</rvolink>)</listelem>
              <listelem>
                <symbol stellen="2">2.</symbol>Auswertungen über die Pflegegeldbewegung (<rvolink abkrvo="statWeis SV 2020" verwart="d" typ="e" gldart="PARA" gldsort="80" gldnr="15" ursprung="u">§ 15</rvolink>)</listelem>
              <listelem>
                <symbol stellen="2">3.</symbol>Ergänzende Auswertungen zu den Anspruchsberechtigten (<rvolink abkrvo="statWeis SV 2020" verwart="d" typ="e" gldart="PARA" gldsort="80" gldnr="16" ursprung="u">§ 16</rvolink>)</listelem>
            </aufzaehlung>
          </liste>
          <absatz typ="abs" halign="l">(2) Die Auswertungen nach Abs.1 sind spätestens am 15. des dem Berichtsmonat folgenden Monats durchzuführen.</absatz>
          
        </abschnitt>
      </nutzdaten>
