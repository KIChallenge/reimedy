      <nutzdaten>
        <abschnitt nr="1" typ="ns" paperf="h" endnhier="true">
          <ueberschrift typ="para" halign="c" level="4">Eintritt des Versicherungsfalles</ueberschrift>
          <absatz typ="abs" halign="j">
            <gldsym>§ 89.</gldsym> Der Versicherungsfall gilt als eingetreten:</absatz>
          <liste>
            <ziffernliste ebene="1">
              <listelem>
                <symbol stellen="2">1.</symbol>bei Dienstunfällen mit dem Unfallereignis;</listelem>
              <listelem>
                <symbol stellen="2">2.</symbol>bei Berufskrankheiten mit dem Beginn der Krankheit (<rvolink abkrvo="B-KUVG" verwart="d" typ="e" gldart="PARA" gldsort="70" gldnr="53" ziff="1" ursprung="u" abs="1">§ 53 Abs. 1 Z 1</rvolink>) oder, wenn dies für den Versicherten günstiger ist, mit dem Beginn der Minderung der Erwerbsfähigkeit (<rvolink abkrvo="B-KUVG" verwart="d" typ="e" gldart="PARA" gldsort="70" gldnr="101" ursprung="u">§ 101</rvolink>).</listelem>
            </ziffernliste>
          </liste>
        </abschnitt>
