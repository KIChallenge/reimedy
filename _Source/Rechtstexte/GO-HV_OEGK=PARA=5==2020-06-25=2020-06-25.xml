          <ueberschrift typ="para" halign="c" level="1">Sitzungsunterlagen</ueberschrift>
          <absatz typ="abs" halign="j">
            <gldsym>§ 5.</gldsym> Sitzungsunterlagen dürfen von Sitzungsteilnehmern außerhalb ihrer Funktion nur dann verwendet werden,</absatz>
          <liste>
            <aufzaehlung ebene="1" art="normal">
              <listelem>
                <symbol stellen="2">1.</symbol>wenn es von der Hauptversammlung genehmigt wurde oder</listelem>
              <listelem>
                <symbol stellen="2">2.</symbol>wenn es sich um Unterlagen handelt, die schon aus anderen Gründen außerhalb des Hauptversammlungsbereiches zugänglich sind.</listelem>
            </aufzaehlung>
          </liste>
        </abschnitt>
