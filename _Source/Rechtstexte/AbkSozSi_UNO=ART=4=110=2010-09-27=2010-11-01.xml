        <abschnitt nr="2" typ="ns" paperf="h" endnhier="true">
          <ueberschrift typ="para" halign="c" level="2">Artikel 4</ueberschrift>
          <absatz typ="abs" halign="j">
            <gldsym>Art. 4</gldsym>
          </absatz>
          <absatz typ="abs" halign="j">Angestellte können geltend machen:</absatz>
          <liste>
            <ziffernliste ebene="1">
              <listelem>
                <symbol stellen="2">1.</symbol>das Recht nach <rvolink ursprung="u" abkrvo="AbkSozSi UNO" verwart="d" gldart="ART" gldsort="80" gldnr="2" abs="1" typ="e">Artikel 2 Absatz 1</rvolink> binnen drei Monaten nach dem Beginn der Beschäftigung bei den Vereinten Nationen oder binnen drei Monaten nach einer durchgehenden dreijährigen Beschäftigung bei den Vereinten Nationen,</listelem>
              <listelem>
                <symbol stellen="2">2.</symbol>das Recht nach <rvolink ursprung="u" abkrvo="AbkSozSi UNO" verwart="d" gldart="ART" gldsort="80" gldnr="3" abs="3" typ="e">Artikel 3 Absatz 3</rvolink> vor ihrer Entsendung,</listelem>
              <listelem>
                <symbol stellen="2">3.</symbol>das Recht nach <rvolink ursprung="u" abkrvo="AbkSozSi UNO" verwart="d" gldart="ART" gldsort="80" gldnr="3" abs="4" typ="e">Artikel 3 Absatz 4</rvolink>binnen einem Monat nach dem Ende ihrer Entsendung,</listelem>
              <listelem>
                <symbol stellen="2">4.</symbol>das Recht nach <rvolink ursprung="u" abkrvo="AbkSozSi UNO" verwart="d" gldart="ART" gldsort="80" gldnr="3" abs="5" typ="e">Artikel 3 Absatz 5</rvolink> binnen drei Monaten nach der Aufnahme in den Pensionsfonds oder binnen drei Monaten nach einer durchgehenden dreijährigen Beschäftigung bei den Vereinten Nationen.</listelem>
            </ziffernliste>
          </liste>
        </abschnitt>
