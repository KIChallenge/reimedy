<uebrecht><rvolink ursprung="u" abkrvo="SV-EG" verwart="s" gldart="PARA" gldsort="70" pubdat="2011-12-27" ikra="2011-12-28" puborg="BGBl." gldpuborg="I" nrpuborg="122" jahrgang="2011" typ="e" gldnr="9j" abs="2">§ 9j Abs. 2 idF BGBl. I Nr. 122/2011</rvolink></uebrecht><puborgane><puborgan puborg="BGBl." gldpuborg="I" nrpuborg="122" begseite="8" jahrgang="2011"/></puborgane></metadaten>
