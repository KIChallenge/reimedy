<rvolink ursprung="u" abkrvo="GSVG" verwart="d" gldart="PARA" gldsort="70" gldnr="276" abs="14" pubdat="1998-08-18" ikra="1998-08-19" puborg="BGBl." gldpuborg="I" nrpuborg="139" jahrgang="1998" typ="e">§ 276 Abs. 14 GSVG</rvolink>
