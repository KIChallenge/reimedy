<uebrecht><rvolink ursprung="u" abkrvo="Verlaengerung bestimmter Zeiträume nach dem ASVG, dem GSVG, dem BSVG und dem B-KUVG iZm COVID-19" verwart="d" typ="e">Verlängerung bestimmter Zeiträume nach dem ASVG, dem GSVG, dem BSVG und dem B-KUVG iZm COVID-19</rvolink></uebrecht><puborgane><puborgan puborg="BGBl." gldpuborg="I" nrpuborg="69" begseite="5" jahrgang="2023"/></puborgane></metadaten>
