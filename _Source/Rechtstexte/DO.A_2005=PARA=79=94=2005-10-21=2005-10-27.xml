<ueberschrift widowctrl="1" keepwithnext="1" halign="c" level="2" typ="para">Leistungen</ueberschrift>
<absatz typ="abs" widowctrl="1" keepwithnext="0" halign="j">
<gldsym>§ 79. </gldsym>(1) Leistungen nach diesem Pensionsrecht sind:
</absatz>
<liste>
<ziffernliste ebene="1">
<listelem>
<symbol stellen="2">1.</symbol>die Pension (
<rvolink abkrvo="DO.A 2005" verwart="d" typ="e" gldart="PARA" gldsort="70" gldnr="81" ursprung="p">§ 81</rvolink>) einschließlich allfälliger Kinderzulagen,</listelem>
<listelem>
<symbol stellen="2">2.</symbol>die Witwen(Witwer)pension (
<rvolink abkrvo="DO.A 2005" verwart="d" typ="e" gldart="PARA" gldsort="70" gldnr="82" ursprung="p">§ 82</rvolink>),</listelem>
<listelem>
<symbol stellen="2">3.</symbol>die Waisenpension (
<rvolink abkrvo="DO.A 2005" verwart="d" typ="e" gldart="PARA" gldsort="70" gldnr="83" ursprung="p">§ 83</rvolink>),</listelem>
<listelem>
<symbol stellen="2">4.</symbol>die Abfindung (
<rvolink abkrvo="DO.A 2005" verwart="d" typ="e" gldart="PARA" gldsort="70" gldnr="84" ursprung="p">§ 84</rvolink>).</listelem>
</ziffernliste>
</liste>
<absatz typ="abs" widowctrl="1" keepwithnext="0" halign="j">(2) Leistungen gemäß Abs. 1 Z 2 bis 4 sind vom Anspruchsberechtigten oder seinem gesetzlichen Vertreter zu beantragen.</absatz>
<absatz typ="abs" widowctrl="1" keepwithnext="0" halign="j">(3) (aufgehoben)</absatz>
<absatz typ="abs" widowctrl="1" keepwithnext="0" halign="j">(4) (aufgehoben)</absatz>
<absatz typ="abs" widowctrl="1" keepwithnext="0" halign="j">(5) (aufgehoben)</absatz>
</abschnitt>
