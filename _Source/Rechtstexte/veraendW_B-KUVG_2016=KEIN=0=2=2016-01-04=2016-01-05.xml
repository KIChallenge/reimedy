        <anm>Rechtsgrundlage: §§ 19 Abs. 6 und 26a Abs. 3 B-KUVG</anm><puborgane><puborgan puborg="BGBl." gldpuborg="II" nrpuborg="2" begseite="1" jahrgang="2016">BGBl. II  Nr. 2/2016 , S.1</puborgan>
          
        </puborgane>
