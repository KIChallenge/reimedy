<nutzdaten>
<abschnitt>
<ueberschrift widowctrl="1" keepwithnext="0" halign="c" level="1" typ="g1">ABSCHNITT II 
<br/>ANWENDUNG DER BESTIMMUNGEN ÜBER DIE ANZUWENDENDEN RECHTSVORSCHRIFTEN </ueberschrift>
<ueberschrift widowctrl="1" keepwithnext="0" halign="c" level="2" typ="para">Entsendungen </ueberschrift>
<absatz typ="abs" widowctrl="1" keepwithnext="0" halign="j">
<gldsym>Artikel 4</gldsym>
</absatz>
<absatz typ="abs" widowctrl="1" keepwithnext="0" halign="j">In den Fällen des Artikels 7 Absatz 1 des Abkommens ist die Weitergeltung der Rechtsvorschriften des Entsendestaates zu bescheinigen. Die Bescheinigung ist </absatz>
<absatz typ="abs" widowctrl="1" keepwithnext="0" halign="j">in Österreich</absatz>
<absatz typ="abs" widowctrl="1" keepwithnext="0" halign="j">  vom zuständigen Träger der Krankenversicherung,</absatz>
<absatz typ="abs" widowctrl="1" keepwithnext="0" halign="j">in Dänemark</absatz>
<absatz typ="abs" widowctrl="1" keepwithnext="0" halign="j">  von der Staatlichen Anstalt für Soziale Sicherheit</absatz>
<absatz typ="abs" widowctrl="1" keepwithnext="0" halign="j">auszustellen. </absatz>
</abschnitt>
</nutzdaten>
