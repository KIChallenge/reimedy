<durchfv><textelem>§ 54 Abs. 2:</textelem><rvolink ursprung="u" abkrvo="Fest 54 2006" verwart="d" typ="e">Fest 54 2006</rvolink><rvolink ursprung="u" abkrvo="Fest 54 2005" verwart="d" typ="e">Fest 54 2005</rvolink></durchfv><uebrecht><aenlink ursprung="u" abkaen="MaiNov 66/2017" gldart="ZIFF" art="2" ziff="3c" pubdat="2017-05-22" ikra="2017-05-23" puborg="BGBl." gldpuborg="I" nrpuborg="66" jahrgang="2017">Art. 2 Z 3c BGBl. I Nr. 66/2017 </aenlink><textelem>(§ 689 Abs. 2);</textelem><aenlink ursprung="u" abkaen="SRÄG 2015" gldart="ZIFF" art="1 Teil 1" ziff="22a" pubdat="2015-12-28" ikra="2016-01-01" puborg="BGBl." gldpuborg="I" nrpuborg="162" jahrgang="2015">Art. 1 Teil 1  Z 22a BGBl. I Nr. 162/2015 </aenlink><textelem>(§ 689 Abs. 2);</textelem></uebrecht><puborgane><puborgan puborg="BGBl." gldpuborg="I" nrpuborg="66" begseite="12" jahrgang="2017">BGBl. I  Nr. 66/2017 , S.12</puborgan><puborgan puborg="BGBl." gldpuborg="I" nrpuborg="162" begseite="1" jahrgang="2015"/></puborgane></metadaten>
