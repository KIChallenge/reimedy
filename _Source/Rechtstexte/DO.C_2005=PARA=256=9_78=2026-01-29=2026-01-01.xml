<metadaten gldart="PARA" gldsort="70" titrvo="Dienstordnung C für die Arbeiter bei den Sozialversicherungsträgern Österreichs 2005" abkrvo="DO.C 2005" dokart="DO" titaen="99. Änderung der Dienstordnung C für die Arbeiter bei den Sozialversicherungsträgern Österreichs 2005 idF avsv Nr. 9/2026" abkaen="99. Änd DO.C 2005 idF avsv Nr. 9/2026" urheber="DVSV" beschdat="2025-12-18" pubdat="2026-01-29" ikra="2026-01-01" sichtbarkeit="p" gldnr="256" nichtanzeigen="n">

