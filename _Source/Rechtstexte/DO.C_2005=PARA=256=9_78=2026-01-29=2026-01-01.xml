<abschnitt endnhier="true" nr="1" paperf="h" typ="ns">
					<ueberschrift typ="para" halign="c" level="2">Übergangsbestimmung zu <rvolink abkrvo="DO.C 2005" verwart="d" typ="e" gldart="PARA" gldsort="50" gldnr="20" abs="1" ursprung="u">§ 20 Abs. 1</rvolink></ueberschrift>
					
					
					
					
					
					
					
				
          <absatz typ="abs" halign="j">
            <gldsym>§ 256.</gldsym> (1) <rvolink abkrvo="DO.C 2005" verwart="d" typ="e" gldart="PARA" gldsort="50" gldnr="20" abs="1" ursprung="u">§ 20 Abs. 1</rvolink> ist auf Arbeiter, die in einem Dienstverhältnis stehen und zuletzt vor dem 1. Jänner 2026 in den Dienst eines österreichischen Sozialversicherungsträgers eingetreten sind, nicht anzuwenden. Für diese Arbeiter besteht ein erhöhter Kündigungsschutz, wenn der Arbeiter</absatz>
          
          
          
          
          
          
          
          
          
          
          
          <liste>
            <aufzaehlung ebene="1" art="normal">
              <listelem>
                <symbol stellen="2">1.</symbol>die österreichische Staatsbürgerschaft oder die Unionsbürgerschaft (im Sinne des <rvolink abkrvo="DO.C 2005" verwart="d" typ="e" gldart="PARA" gldsort="50" gldnr="1b" ursprung="u">§ 1b</rvolink><nolink> DO.C</nolink>) besitzt,</listelem>
              <listelem>
                <symbol stellen="2">2.</symbol>seit zwei Jahren eine auf mindestens „befriedigend“ lautende Gesamtbeurteilung der Dienstbeschreibung hat,</listelem>
              <listelem>
                <symbol stellen="2">3.</symbol>zehn Dienstjahre gemäß <rvolink abkrvo="DO.C 2005" verwart="d" typ="e" gldart="PARA" gldsort="50" gldnr="15" ursprung="u">§ 15</rvolink> zurückgelegt hat.</listelem>
            </aufzaehlung>
          </liste>
          <absatz typ="abs" halign="j">(2) <rvolink abkrvo="DO.C 2005" verwart="d" typ="e" gldart="PARA" gldsort="50" gldnr="20" abs="2" ursprung="u">§ 20 Abs. 2</rvolink> sowie die damit verbundenen Bestimmungen treten mit 31. Dezember 2030 außer Kraft.</absatz></abschnitt></nutzdaten>
