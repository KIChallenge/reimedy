<ueberschrift level="1" halign="c" typ="para"> </ueberschrift>
<absatz typ="abs" halign="j">
<gldsym>§ 1.</gldsym> Der Zuständigkeitssprengel der für die Besorgung behördlicher Aufgaben zuständigen Organe des Arbeitsmarktservice (<rvolink abkrvo="AMSG" verwart="d" typ="e" gldart="PARA" gldsort="70" gldnr="24" abs="2" ursprung="u">§ 24 Abs. 2</rvolink> und <rvolink abkrvo="AMSG" verwart="d" typ="e" gldart="PARA" gldsort="70" gldnr="24" abs="3" ursprung="u">3</rvolink><nolink> AMSG</nolink>),</absatz>
<liste>
            <ziffernliste ebene="1">
              <listelem>
                <symbol stellen="2">1.</symbol>des Leiters der regionalen Geschäftsstelle und</listelem>
              <listelem>
                <symbol stellen="2">2.</symbol>des Landesgeschäftsführers,</listelem>
            </ziffernliste>
            <schluss typ="Abs">umfasst den im Folgenden festgelegten Zuständigkeitsbereich der jeweiligen regionalen Geschäftsstelle (Z 1) und der jeweiligen Landesgeschäftsstelle (Z 2) des Arbeitsmarktservice.</schluss>
          </liste>

</abschnitt>
