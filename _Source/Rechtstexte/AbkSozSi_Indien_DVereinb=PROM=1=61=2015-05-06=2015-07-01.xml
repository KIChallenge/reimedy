        <abschnitt nr="1" typ="ns" paperf="h" endnhier="true">
          <ueberschrift typ="art" halign="c" widowctrl="1" keepwithnext="0">V E R W A L T U N G S V E R E I N B A R U N G</ueberschrift><ueberschrift typ="para" halign="c" widowctrl="1" keepwithnext="0">ZUR DURCHFÜHRUNG DES ABKOMMENS ZWISCHEN DER</ueberschrift><ueberschrift typ="para" halign="c" widowctrl="1" keepwithnext="0">REPUBLIK ÖSTERREICH UND DER REPUBLIK INDIEN</ueberschrift><ueberschrift typ="para" halign="c" widowctrl="1" keepwithnext="0">IM BEREICH DER SOZIALEN SICHERHEIT</ueberschrift>
          <abstand halign="l"/>
          <abstand halign="l"/>
          <absatz typ="satz" halign="j">Auf Grund des <rvolink ursprung="u" abkrvo="AbkSozSi Indien" verwart="d" gldart="ART" gldsort="80" gldnr="15" abs="1" typ="e">Artikels 15 Absatz 1</rvolink> des Abkommens zwischen der Republik Österreich und der Republik Indien im Bereich der Sozialen Sicherheit, unterzeichnet in Wien am 4. Februar 2013 – im Folgenden als Abkommen bezeichnet – haben die zuständigen Behörden, und zwar:</absatz>
          <abstand/><absatz typ="satz" halign="j">- für die Republik Österreich</absatz>
          <absatz typ="satz" halign="j">der Bundesminister für Arbeit, Soziales und Konsumentenschutz</absatz>
          <abstand/><absatz typ="satz" halign="j">- für die Republik Indien</absatz>
          <absatz typ="satz" halign="j">der Minister für Angelegenheiten von Auslandsindern (Minister of Overseas Indian Affairs),</absatz>
          <abstand/><absatz typ="satz" halign="j">zur Durchführung des Abkommens Folgendes vereinbart:</absatz>
          
        </abschnitt>
