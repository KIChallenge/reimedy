<metadaten gldart="ART" gldsort="80" titrvo="Abkommen zwischen der Republik Österreich und Rumänien über soziale Sicherheit" abkrvo="AbkSozSi Rumänien" dokart="SVAbk" titaen="Abkommen zwischen der Republik Österreich und Rumänien über soziale Sicherheit StF" abkaen="AbkSozSi Rumänien StF" urheber="Bund" beschdat="2006-03-01" pubdat="2006-11-16" ikra="2006-12-01" sichtbarkeit="p" gldnr="1" nichtanzeigen="n"><schlagw><textelem>Rumänien</textelem></schlagw>
