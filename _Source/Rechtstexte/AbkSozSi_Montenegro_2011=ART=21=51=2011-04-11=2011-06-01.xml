      <nutzdaten>
        <abschnitt nr="1" typ="ns" paperf="h" endnhier="true">
          <ueberschrift typ="para" halign="c" level="3" widowctrl="1">Artikel 21 <br/>Feststellung der Leistungen</ueberschrift>
          <absatz typ="abs" halign="j">
            <gldsym>Art. 21</gldsym>
          </absatz><absatz typ="abs" halign="j">(1) Besteht nach den Rechtsvorschriften eines Vertragsstaates auch ohne Anwendung des <rvolink ursprung="u" abkrvo="AbkSozSi Montenegro 2011" verwart="d" gldart="ART" gldsort="80" gldnr="19" typ="e">Artikels 19</rvolink> ein Leistungsanspruch, so hat der zuständige Träger dieses Vertragsstaates die Leistung ausschließlich auf Grund der nach diesen Rechtsvorschriften zu berücksichtigenden Versicherungszeiten festzustellen.</absatz>
          <absatz typ="abs" halign="j">(2) Besteht nach den Rechtsvorschriften eines Vertragsstaates nur unter Anwendung des <rvolink ursprung="u" abkrvo="AbkSozSi Montenegro 2011" verwart="d" gldart="ART" gldsort="80" gldnr="19" typ="e">Artikels 19</rvolink> ein Leistungsanspruch, so hat der zuständige Träger dieses Vertragsstaates die Leistung nach <rvolink ursprung="u" abkrvo="AbkSozSi Montenegro 2011" verwart="d" gldart="ART" gldsort="80" gldnr="22" typ="e">Artikel 22</rvolink> oder <rvolink ursprung="u" abkrvo="AbkSozSi Montenegro 2011" verwart="d" gldart="ART" gldsort="80" gldnr="23" typ="e">Artikel 23</rvolink> festzustellen.</absatz>
          
        </abschnitt>
