        <abschnitt nr="1" typ="ns" paperf="h" endnhier="true">
          <ueberschrift typ="para" halign="c" level="1">Obliegenheiten, die dem Obmann übertragen werden</ueberschrift>
          <absatz typ="abs" halign="j">
            <gldsym>§ 3.</gldsym> Der Vorstand überträgt dem Obmann nachstehende Obliegenheiten:</absatz>
          <liste>
            <ziffernliste ebene="1">
              <listelem>
                <symbol stellen="2">1.</symbol>Bei Nichtgewährung durch das Büro die Bewilligung von außerordentlichem Urlaub für Bedienstete bis zu einer Woche</listelem>
              <listelem>
                <symbol stellen="2">2.</symbol>Vertretung der Tiroler Gebietskrankenkasse nach außen.</listelem>
            </ziffernliste>
          </liste>
        </abschnitt>
