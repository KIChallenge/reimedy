      <nutzdaten>
        <abschnitt nr="1" typ="ns" paperf="h" endnhier="true">
          <ueberschrift typ="para" halign="c" level="2">Artikel 3 <br/>Persönlicher Geltungsbereich</ueberschrift>
          
          <absatz typ="abs" halign="j">
            <gldsym>Art. 3</gldsym>
          </absatz>
          <absatz typ="abs" halign="j">Dieses Abkommen gilt:</absatz>
          <absatz typ="abs" halign="j">a) für Personen, für die die Rechtsvorschriften eines oder beider Vertragsstaaten gelten oder galten;</absatz>
          <absatz typ="abs" halign="j">b) für andere Personen soweit diese ihre Rechte von den in Buchstaben a bezeichneten Personen ableiten.</absatz>
        </abschnitt>
