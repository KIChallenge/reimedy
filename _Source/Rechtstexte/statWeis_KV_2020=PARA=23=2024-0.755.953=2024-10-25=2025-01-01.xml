      <nutzdaten>
        <abschnitt nr="1" typ="ns" paperf="h" endnhier="true">
          <ueberschrift typ="para" halign="c" level="2">Wirtschaftszweige-Morbiditäts-Statistik</ueberschrift>
          <absatz typ="abs" halign="j">
            <gldsym>§ 23.</gldsym> (1) Für die Erstellung der Wirtschaftszweige-Morbiditäts-Statistik sind die <wwwlink ursprung="u" url="/fs/Formular_KL52_ab_2025.pdf" gldart="KEIN" typ="e">Formulare KL52</wwwlink>, <wwwlink ursprung="u" url="/fs/Formular_KL521_ab_2025.pdf" gldart="KEIN" typ="e">KL521</wwwlink> und <wwwlink ursprung="u" url="/fs/Formular_KL522_ab_2025.pdf" gldart="KEIN" typ="e">KL522</wwwlink> zu verwenden.</absatz>
          <absatz typ="abs" halign="j">(2) Das <wwwlink ursprung="u" url="/fs/Formular_KL52_ab_2025.pdf" gldart="KEIN" typ="e">Formular KL52</wwwlink> ist für versicherungspflichtige Erwerbstätige insgesamt, das <wwwlink ursprung="u" url="/fs/Formular_KL521_ab_2025.pdf" gldart="KEIN" typ="e">Formular KL521</wwwlink> für Arbeiter und das <wwwlink ursprung="u" url="/fs/Formular_KL522_ab_2025.pdf" gldart="KEIN" typ="e">Formular KL522</wwwlink> für Angestellte zu erstellen.</absatz>
          <absatz typ="abs" halign="j">(3) Maßgebend für die Darstellung der Krankenstandsfälle und -tage nach Wirtschaftszweigen ist die ÖNACE 2025 Klassifiktion.</absatz>
        </abschnitt>
