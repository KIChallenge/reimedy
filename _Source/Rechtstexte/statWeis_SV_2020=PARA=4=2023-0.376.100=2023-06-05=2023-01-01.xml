          <absatz typ="abs" halign="j">
            <gldsym>§ 4.</gldsym> (1) Im Rahmen der Beitragsgrundlagenstatistik sind aus der Versicherungsdatei des Dachverbandes folgende Statistiken zu erstellen:</absatz>
          <liste>
            <aufzaehlung ebene="1" art="normal">
              <listelem>
                <symbol stellen="2">1.</symbol>Beitragsgrundlagenstatistik nach Lohnstufen und Alter (<rvolink abkrvo="statWeis SV 2020" verwart="d" typ="e" gldart="PARA" gldsort="80" gldnr="5" ursprung="u">§ 5</rvolink>)</listelem>
              <listelem>
                <symbol stellen="2">2.</symbol>Beitragspflichtiges Einkommen nach Wirtschaftszweigen und Altersgruppen (<rvolink abkrvo="statWeis SV 2020" verwart="d" typ="e" gldart="PARA" gldsort="80" gldnr="6" ursprung="u">§ 6</rvolink>)</listelem>
            </aufzaehlung>
            <schlussteil ebene="0" art="normal">Die Daten sind so aufzubereiten, dass regionale Auswertungen möglich sind.</schlussteil>
          </liste>
          <absatz typ="abs" halign="j">(2) <i>(aufgehoben durch Erlass Nr. 2023-0.376.100)</i></absatz>
