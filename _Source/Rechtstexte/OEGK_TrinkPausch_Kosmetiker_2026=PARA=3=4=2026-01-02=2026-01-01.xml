              </td>
              <td style="vertical-align:top;border:none windowtext 0pt;padding:0pt 5.4pt 0pt 5.4pt" h-xval="5379">
                <absatz typ="satz" halign="j">€ 65,00</absatz>
              </td>
            </tr>
            <tr h-start="787">
              <td style="vertical-align:top;border:none windowtext 0pt;padding:0pt 5.4pt 0pt 5.4pt" h-xval="3083">
                <absatz typ="satz" halign="j">b) 2027:</absatz>
