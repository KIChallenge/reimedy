      <metadaten nichtanzeigen="n" titrvo="NachtschwerarbeitsG" abkrvo="NSchG" dokart="BG" titaen="Gesamtstand NSchG idF 3/2013 (SRÄG 2012)" abkaen="Gesamtstand NSchG idF 3/2013" urheber="Bund" pubdat="2013-01-10" ikra="2013-01-01" sichtbarkeit="p" gldart="ART" gldnr="IX" gldsort="80">
        <puborgane>
          <puborgan puborg="BGBl." gldpuborg="I" nrpuborg="3" jahrgang="2013" begseite="21">BGBl. I  Nr. 3/2013 , S.21</puborgan>
        </puborgane>
