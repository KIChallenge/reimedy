      <nutzdaten>
        <abschnitt nr="1" typ="ns" paperf="h" endnhier="true">
          <ueberschrift typ="para" halign="c" level="2">Artikel 20 <br/>Zahlungsverkehr</ueberschrift>
          <absatz typ="abs" halign="j">
            <gldsym>Art. 20</gldsym>
          </absatz>
          <absatz typ="abs" halign="j">(1) Die nach diesem Abkommen leistungspflichtigen Träger können die Leistungen für den Berechtigten, der seinen Wohn- oder Aufenthaltsort im anderen Vertragsstaat hat, in der für sie innerstaatlich maßgebenden Währung auszahlen.</absatz>
          <absatz typ="abs" halign="j">(2) Die in diesem Abkommen vorgesehenen Erstattungen haben in der Währung des Vertragsstaates zu erfolgen, in dem der Träger, der die Leistungen gewährt oder Schadenersatz nach Artikel <rvolink ursprung="u" abkrvo="AbkSozSi Moldau" verwart="d" gldart="ART" gldsort="80" gldnr="18" abs="1" ziff="7" typ="e">18 Absatz 1 Ziffer 7</rvolink> leistet, seinen Sitz hat.</absatz>
        </abschnitt>
      </nutzdaten>
