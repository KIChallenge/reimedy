      <nutzdaten>
        <abschnitt nr="1" typ="ns" paperf="h" endnhier="true">
          <ueberschrift typ="para" halign="c">Obliegenheiten, die dem Obmann übertragen werden</ueberschrift>
          <absatz typ="abs" halign="j">
            <gldsym>§ 3.</gldsym> Der Vorstand überträgt dem Obmann nachstehende Obliegenheiten:</absatz>
          <liste>
            <ziffernliste ebene="1">
              <listelem>
                <symbol stellen="2">1.</symbol>Gewährung einmaliger Unterstützungen nach den Richtlinien für die Gewährung von Zuschüssen aus dem Unterstützungsfonds, unbeschadet der Bestimmung des <rvolink abkrvo="GKK Tirol Anh GOVorst 2003/2" verwart="d" typ="e" gldart="PARA" gldsort="70" gldnr="4" ursprung="u">§ 4</rvolink></listelem>
              <listelem>
                <symbol stellen="2">2.</symbol>Bei Nichtgewährung durch das Büro die Bewilligung von außerordentlichem Urlaub für Bedienstete bis zu einer Woche</listelem>
              <listelem>
                <symbol stellen="2">3.</symbol>Vertretung der Tiroler Gebietskrankenkasse nach außen.</listelem>
            </ziffernliste>
          </liste>
        </abschnitt>
      </nutzdaten>
