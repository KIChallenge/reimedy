      <metadaten titrvo="Mustergeschäftsordnung für den Verwaltungsrat" abkrvo="MGOV" dokart="MusterR" urheber="BMASGK" pubdat="2019-03-29" ikra="2019-04-01" sichtbarkeit="p" nichtanzeigen="n" titaen="Mustergeschäftsordnung für den Verwaltungsrat StF" abkaen="MGOV StF" gldart="PARA" gldnr="24" gldsort="80">
