        <abschnitt nr="1" typ="ns" paperf="h" endnhier="true">
          <ueberschrift typ="para" halign="c" level="1"> Pflegegeldstatistik - Ergänzende Auswertungen zu den Anspruchsberechtigten </ueberschrift><absatz typ="abs" halign="j">
            <gldsym>§ 16.</gldsym> (1) Die Anspruchsberechtigten sind je Bundesland nach Pflgeggeldstufe und Geschlecht auszuwerten. </absatz>
          <absatz typ="abs" halign="j">(2) Die Anspruchsberechtigten der unten angeführten Gruppen sind nach Entscheidungsträger, Pflegegeldstufe und Geschlecht auszuwerten:</absatz>
          <liste>
            <aufzaehlung ebene="1" art="normal">
              <listelem>
                <symbol stellen="2">1.</symbol>Anrechenbare Geldleistung gemäß <rvolink abkrvo="BPGG" verwart="d" typ="e" gldart="PARA" gldsort="80" gldnr="7" ursprung="u">§ 7</rvolink><nolink> BPGG</nolink></listelem>
              <listelem>
                <symbol stellen="2">2.</symbol>Ruhen des Pflegegeldanspruches gemäß <rvolink abkrvo="BPGG" verwart="d" typ="e" gldart="PARA" gldsort="80" gldnr="12" ursprung="u">§ 12</rvolink><nolink> BPGG</nolink></listelem>
              <listelem>
                <symbol stellen="2">3.</symbol>Übergang des Pflegegeldanspruches gem. <rvolink abkrvo="BPGG" verwart="d" typ="e" gldart="PARA" gldsort="80" gldnr="13" ursprung="u">§ 13</rvolink><nolink> BPGG</nolink></listelem>
              <listelem>
                <symbol stellen="2">4.</symbol>Ausgleichszahlung</listelem>
              <listelem>
                <symbol stellen="2">5.</symbol><i>(aufgehoben durch Erlass 2023-0.376.100)</i></listelem>
            </aufzaehlung>
          </liste>
        </abschnitt>
