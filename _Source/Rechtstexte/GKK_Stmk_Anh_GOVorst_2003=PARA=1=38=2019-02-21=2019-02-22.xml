      <metadaten titrvo="Anhang zur Geschäftsordnung des Vorstandes der Steiermärkischen Gebietskrankenkasse 2003" abkrvo="GKK Stmk Anh GOVorst 2003" dokart="AnhGO" urheber="GKK Stmk" beschdat="2019-02-15" pubdat="2019-02-21" ikra="2019-02-22" sichtbarkeit="p" nichtanzeigen="n" titaen="3. Änderung des Anhanges zur Geschäftsordnung des Vorstandes der Steiermärkischen Gebietskrankenkasse 2003" abkaen="3. Änd GKK Stmk Anh GOVorst 2003" gldart="PARA" gldnr="1" gldsort="80">
        <puborgane><puborgan puborg="avsv" nrpuborg="38" jahrgang="2019">avsv   Nr. 38/2019 </puborgan>
          
        </puborgane>
      </metadaten>
      <nutzdaten>
        <abschnitt nr="1" typ="ns" paperf="h" endnhier="true">
          <ueberschrift typ="para" halign="c" level="1">Delegierungsbeschlüsse des Vorstandes</ueberschrift>
          <absatz typ="abs" halign="j">
            <gldsym>§ 1.</gldsym> Dieser Anhang enthält Zeitpunkt und Wortlaut aller Beschlüsse des Vorstandes der Steiermärkischen Gebietskrankenkasse, mit denen gemäß <rvolink abkrvo="ASVG" verwart="d" typ="e" gldart="PARA" gldsort="80" gldnr="434" abs="1" ursprung="u">§ 434 Abs. 1</rvolink><nolink> ASVG</nolink></absatz>
          <liste>
            <ziffernliste ebene="1">
              <listelem>
                <symbol stellen="2">1.</symbol>einzelne Obliegenheiten</listelem>
            </ziffernliste>
            <strichliste ebene="1">
              <listelem>
                <symbol stellen="1">-</symbol>Ausschüssen aus Mitgliedern der Generalversammlung</listelem>
              <listelem>
                <symbol stellen="1">-</symbol>dem Obmann</listelem>
            </strichliste>
            <ziffernliste ebene="1">
              <listelem>
                <symbol stellen="2">2.</symbol>bestimmte laufende Angelegenheiten</listelem>
            </ziffernliste>
            <strichliste ebene="1">
              <listelem>
                <symbol stellen="1">-</symbol>dem Büro</listelem>
            </strichliste>
            <schluss typ="Abs">übertragen werden. Die Zuständigkeit des Vorstandes in Angelegenheiten des <rvolink abkrvo="ASVG" verwart="d" typ="e" gldart="PARA" gldsort="80" gldnr="437" abs="1" ursprung="u">§ 437 Abs. 1</rvolink><nolink> ASVG</nolink>, die der Zustimmung der Kontrollversammlung bedürfen, wird durch den Anhang zur Geschäftsordnung des Vorstandes nicht berührt. Können Zahlungsverpflichtungen der Kasse durch die Aufnahme von Refinanzierungen (Barvorlagen) nicht überbrückt werden und müssen Darlehen und Kredite am Geldmarkt aufgenommen werden, so ist – soweit im Folgenden nichts anderes bestimmt – damit jedenfalls der Vorstand zu befassen.</schluss>
          </liste>
        </abschnitt>
      </nutzdaten>
