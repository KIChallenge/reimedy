<uebrecht><rvolink ursprung="u" abkrvo="ASVG" verwart="s" gldart="PARA" gldsort="70" gldnr="669" abs="5" pubdat="2015-01-13" ikra="2015-01-14" puborg="BGBl." gldpuborg="I" nrpuborg="2" jahrgang="2015" typ="e">§ 669 Abs. 5 ASVG idF 2/2015</rvolink><rvolink ursprung="u" abkrvo="ASVG" verwart="s" gldart="PARA" gldsort="70" gldnr="669" abs="5" pubdat="2013-01-10" ikra="2013-01-11" puborg="BGBl." gldpuborg="I" nrpuborg="3" jahrgang="2013" typ="e">§ 669 Abs. 5 ASVG idF 3/2013</rvolink></uebrecht><puborgane><puborgan puborg="BGBl." gldpuborg="I" nrpuborg="38" begseite="1" jahrgang="2017"/></puborgane></metadaten>
