<abschnitt>
<ueberschrift widowctrl="1" keepwithnext="1" halign="c" level="2" typ="g2">Kapitel 2 
<br/>Arbeitsunfälle und Berufskrankheiten</ueberschrift>
<ueberschrift widowctrl="1" keepwithnext="1" halign="c" level="3" typ="para">Zuständigkeiten</ueberschrift>
<absatz typ="satz" widowctrl="1" keepwithnext="0" halign="j">
<gldsym>Artikel 15</gldsym>
</absatz>
<absatz typ="abs" widowctrl="1" keepwithnext="0" halign="j">Soweit <rvolink ursprung="u" abkrvo="AbkSozSi Bulgarien" verwart="d" gldart="ART" gldsort="80" gldnr="19" typ="e">Artikel 19</rvolink> nichts anderes bestimmt, ist für Leistungen bei Arbeitsunfällen und Berufskrankheiten jener Vertragsstaat zuständig, dessen Rechtsvorschriften bei Eintritt des Arbeitsunfalls oder während der Ausübung jener Beschäftigung, die geeignet ist, die Berufskrankheit zu verursachen, gegolten haben.</absatz>
</abschnitt>
