      <nutzdaten>
        <abschnitt nr="1" typ="ns" paperf="h" endnhier="true">
          <ueberschrift typ="g1min" halign="c" level="2">Abschnitt II <br/>Verwaltung der Versorgungsanstalt </ueberschrift>
          
          <ueberschrift typ="para" halign="c" level="3">Träger der Verwaltung</ueberschrift>
          <absatz typ="abs" halign="j">
            <gldsym>§ 77.</gldsym> (1) Die Verwaltung der Versorgungsanstalt obliegt den Verwaltungskörpern und den Rechnungsprüfer/inne/n.</absatz>
          <absatz typ="abs" halign="j">(2) Die Verwaltungskörper sind die Hauptversammlung und der Vorstand.</absatz>
          <absatz typ="abs" halign="j">(3) Die Verwaltungskörper und die Rechnungsprüfer/innen haben sich zur Durchführung ihrer Aufgaben der am Sitz der Versorgungsanstalt zu errichtenden Geschäftsstelle zu bedienen.</absatz>
        </abschnitt>
      </nutzdaten>
