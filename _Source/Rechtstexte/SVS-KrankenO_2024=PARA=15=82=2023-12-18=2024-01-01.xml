      <metadaten nichtanzeigen="n" titrvo="SVS-Krankenordnung 2024" abkrvo="SVS-KrankenO 2024" dokart="KrankenO" titaen="SVS-Krankenordnung 2024 StF" abkaen="SVS-KrankenO 2024 StF" urheber="SVS" beschdat="2023-12-12" pubdat="2023-12-18" ikra="2024-01-01" sichtbarkeit="p" gldart="PARA" gldnr="15" gldsort="50">
