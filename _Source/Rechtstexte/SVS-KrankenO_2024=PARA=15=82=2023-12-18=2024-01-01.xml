      <nutzdaten>
        <abschnitt nr="1" typ="ns" paperf="h" endnhier="true">
          <ueberschrift typ="para" halign="c" level="4">Physiotherapie</ueberschrift>
          <absatz typ="abs" halign="j">
            <gldsym>§ 15.</gldsym> (1) Physiotherapeutische Behandlungen können bei den Vertragspartnern (eigenen Einrichtungen) der SVS, die zur Durchführung dieser Behandlungen berechtigt sind, über Verordnung (Zuweisung) durch</absatz>
          <liste>
            <aufzaehlung ebene="1" art="normal">
              <listelem>
                <symbol stellen="2">1.</symbol>einen (Vertrags-)Arzt, eine (Vertrags-)Gruppenpraxis oder</listelem>
              <listelem>
                <symbol stellen="2">2.</symbol>eine eigene Einrichtung, eine (Vertrags-)Einrichtung</listelem>
            </aufzaehlung>
          </liste>
          <absatz typ="abs" halign="j">als Sachleistung auf Rechnung der SVS in Anspruch genommen werden.</absatz>
          <absatz typ="abs" halign="j">(2) Wird die Behandlung durch eine gemäß <rvolink abkrvo="GSVG" verwart="d" typ="e" gldart="PARA" gldsort="50" gldnr="91" abs="1" ziff="1" ursprung="u">§ 91 Abs. 1 Z 1</rvolink><nolink> GSVG</nolink> bzw. <rvolink abkrvo="BSVG" verwart="d" typ="e" gldart="PARA" gldsort="50" gldnr="85" abs="1" ziff="1" ursprung="u">§ 85 Abs. 1 Z 1</rvolink><nolink> BSVG</nolink> zur Durchführung berechtigte Person nicht als Sachleistung in Anspruch genommen, werden Kosten nach den Bestimmungen von Teil 1, 2. Abschnitt, 16. Unterabschnitt vergütet, sofern eine ärztliche Verordnung nach Abs. 1 vorliegt.</absatz>
        </abschnitt>
      </nutzdaten>
