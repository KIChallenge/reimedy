          <ueberschrift typ="para" halign="c" level="2" widowctrl="1">Artikel 3 <br/>Persönlicher Geltungsbereich</ueberschrift>
          <absatz typ="abs" halign="j">
            <gldsym>Art. 3</gldsym>
          </absatz><absatz typ="abs" halign="j">Dieses Abkommen gilt</absatz>
          <liste>
            <literaliste ebene="3">
              <listelem>
                <symbol stellen="2">a)</symbol>für Personen, für die die Rechtsvorschriften eines oder beider Vertragsstaaten gelten oder galten;</listelem>
              <listelem>
                <symbol stellen="2">b)</symbol>für andere Personen, soweit diese ihre Rechte von den im Buchstaben a bezeichneten Personen ableiten.</listelem>
            </literaliste>
          </liste>
