<abschnitt nr="1" typ="ns" paperf="h" endnhier="true">
<ueberschrift typ="para" halign="c" level="3">Anpassung der Leistungen aus der Unfallversicherung und der Ausgleichszulagenrichtsätze für das Kalenderjahr 2009</ueberschrift>
<absatz typ="abs" halign="j">
<gldsym>§ 314.</gldsym> Abweichend von den <rvolink abkrvo="BSVG" verwart="d" typ="e" gldart="PARA" gldsort="70" gldnr="45" ursprung="u">§§ 45</rvolink> und <rvolink abkrvo="BSVG" verwart="d" typ="e" gldart="PARA" gldsort="70" gldnr="141" abs="2" ursprung="u">141 Abs. 2</rvolink> sind die Renten aus der Unfallversicherung, die Bemessungsgrundlagen nach <rvolink abkrvo="BSVG" verwart="d" typ="e" gldart="PARA" gldsort="70" gldnr="148f" abs="1" ursprung="u">§ 148f Abs. 1</rvolink> und <rvolink abkrvo="BSVG" verwart="d" typ="e" gldart="PARA" gldsort="70" gldnr="148f" abs="3" ursprung="u">3</rvolink> sowie der Betrag nach <rvolink abkrvo="BSVG" verwart="d" typ="e" gldart="PARA" gldsort="70" gldnr="149g" abs="2" ursprung="u">§ 149g Abs. 2</rvolink> und die Ausgleichszulagenrichtsätze für das Kalenderjahr 2009 nicht mit dem <rvolink abkrvo="verändW" verwart="d" typ="e" gldart="ZAHL" gldsort="130" gldnr="16" ursprung="u">Anpassungsfaktor</rvolink>, sondern mit dem Faktor 1,034 zu vervielfachen.</absatz>
</abschnitt>
