<ueberschrift typ="para" halign="c">Inhalt</ueberschrift><absatz typ="abs" halign="j">
            <gldsym>§ 8.</gldsym> (1) Die Führungskräfteausbildung II besteht aus folgenden verpflichtenden Teilen:</absatz>
<liste>
            <aufzaehlung ebene="3" art="normal">
              <listelem>
                <symbol stellen="1">-</symbol>einem Kickoff</listelem>
              <listelem>
                <symbol stellen="1">-</symbol>Fachhochschul-Lehrveranstaltungen im Ausmaß von mind. 8-ECTS-Punkten</listelem>
              <listelem>
                <symbol stellen="1">-</symbol>einer Abschlussveranstaltung</listelem>
            </aufzaehlung>
          </liste><absatz typ="abs" halign="j">(2) Die im Rahmen der Führungskräfteausbildung II zu absolvierenden Lehrveranstaltungen müssen folgenden Themenbereichen zuzuordnen sein:</absatz><liste>
            <aufzaehlung ebene="3" art="normal">
              <listelem>
                <symbol stellen="1">-</symbol>Strategisches Management</listelem>
              <listelem>
                <symbol stellen="1">-</symbol>Komplexitätsmanagement</listelem>
              <listelem>
                <symbol stellen="1">-</symbol>Gesundheitsökonomie <amp/> Politik</listelem>
              <listelem>
                <symbol stellen="1">-</symbol>Finanzierung des österr. Gesundheitswesens</listelem>
              <listelem>
                <symbol stellen="1">-</symbol>Public Management</listelem>
            </aufzaehlung>
          </liste></abschnitt>
</nutzdaten>
