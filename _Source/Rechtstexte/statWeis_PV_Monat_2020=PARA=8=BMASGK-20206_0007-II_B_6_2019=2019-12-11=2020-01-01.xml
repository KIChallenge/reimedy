      <metadaten nichtanzeigen="n" titrvo="Monatsstatistik StatistikWeis PV 2020" abkrvo="statWeis PV Monat 2020" dokart="Weisung" titaen="Monatsstatistik StatistikWeis PV 2020 StF" abkaen="statWeis PV Monat 2020 StF" urheber="BMASGK" pubdat="2019-12-11" ikra="2020-01-01" sichtbarkeit="p" gldart="PARA" gldnr="8" gldsort="80">
        <puborgane><puborgan puborg="Erlass" nrpuborg="BMASGK-20206/0007-II/B/6/2019">Erlass   Nr. BMASGK-20206/0007-II/B/6/2019</puborgan>
        
          </puborgane>
