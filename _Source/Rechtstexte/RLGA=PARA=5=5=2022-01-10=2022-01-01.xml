          <ueberschrift typ="para" halign="c" level="2">Aufgaben der Fachexpert:innen</ueberschrift>
          <absatz typ="abs" halign="j">
            <gldsym>§ 5.</gldsym> Der:die Fachexperte:-expertin hat folgende Aufgaben:</absatz>
          <liste>
            <aufzaehlung ebene="1" art="normal">
              <listelem>
                <symbol stellen="2">1.</symbol>die Durchführung der Abschlussbeurteilung;</listelem>
              <listelem>
                <symbol stellen="2">2.</symbol>die aktenmäßige Feststellung des Nichterscheinens eines:einer Kandidaten:Kandidatin zur Abschlussbeurteilung;</listelem>
              <listelem>
                <symbol stellen="2">3.</symbol>die Feststellung des Ergebnisses der Abschlussbeurteilung;</listelem>
              <listelem>
                <symbol stellen="2">4.</symbol>die Unterfertigung des Zeugnisses;</listelem>
              <listelem>
                <symbol stellen="2">5.</symbol>die mündliche Bekanntgabe des Ergebnisses.</listelem>
            </aufzaehlung>
          </liste>
        </abschnitt>
