<uebrecht><rvolink ursprung="u" abkrvo="Nov BGBl. Nr. 67/1967" verwart="s" gldart="ART" gldsort="80" gldnr="II" abs="1" pubdat="1967-03-03" ikra="1967-01-01" puborg="BGBl." nrpuborg="67" jahrgang="1967" typ="e">Art. II Abs. 1 Nov BGBl. Nr. 67/1967</rvolink><rvolink ursprung="u" abkrvo="Nov BGBl. Nr. 168/1966" verwart="s" gldart="ART" gldsort="80" gldnr="II" pubdat="1966-08-12" ikra="1966-07-01" puborg="BGBl." nrpuborg="168" jahrgang="1966" typ="e">Art. II Nov BGBl. Nr. 168/1966</rvolink></uebrecht><puborgane><puborgan puborg="BGBl." gldpuborg="I" nrpuborg="162" begseite="1" jahrgang="2015"/></puborgane></metadaten>
