      <nutzdaten>
        <abschnitt nr="1" typ="ns" paperf="h" endnhier="true">
          <ueberschrift typ="para" halign="c" level="2">Rentenneuzugang-Statistik</ueberschrift>
          <absatz typ="abs" halign="j">
            <gldsym>§ 20.</gldsym> (1) Im Rahmen der Rentenneuzugang-Statistik sind folgende Statistiken zu erstellen:</absatz>
          <liste>
            <aufzaehlung ebene="1" art="normal">
              <listelem>
                <symbol stellen="2">1.</symbol>Rentenneuzugang nach Rentenarten und Versichertenkategorien (<rvolink abkrvo="statWeis UV 2020" verwart="d" typ="e" gldart="PARA" gldsort="80" gldnr="21" ursprung="u">§ 21</rvolink>)</listelem>
              <listelem>
                <symbol stellen="2">2.</symbol>Neuzugang an Versehrtenrenten nach Altersgruppen und Minderung der Erwerbsfähigkeit (<rvolink abkrvo="statWeis UV 2020" verwart="d" typ="e" gldart="PARA" gldsort="80" gldnr="22" ursprung="u">§ 22</rvolink>)</listelem>
            </aufzaehlung>
          </liste>
          <absatz typ="abs" halign="j">(2) Die Nachweisungen haben alle im <wwwlink ursprung="u" url="/fs/Formular_UL20_1_ab_2020.pdf" gldart="KEIN" typ="e">Formular UL20/2</wwwlink> nachgewiesenen Neuzuerkennungen (Spalte 4) zu umfassen.</absatz>
        </abschnitt>
      </nutzdaten>
