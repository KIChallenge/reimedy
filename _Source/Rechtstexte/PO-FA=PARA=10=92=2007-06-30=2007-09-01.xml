<absatz typ="abs" widowctrl="1" keepwithnext="0" halign="j">
<gldsym>§ 10.</gldsym> Dem Verbandsvorstand obliegt:
</absatz>
<liste>
<ziffernliste ebene="1">
<listelem>
<symbol stellen="2">1.</symbol>die Anberaumung der Prüfungen (
<rvolink abkrvo="PO-FA" verwart="d" typ="e" gldart="PARA" gldsort="70" gldnr="15" abs="1" ursprung="p">§ 15 Abs. 1</rvolink>);</listelem>
<listelem>
<symbol stellen="2">2.</symbol>die Entscheidung über die Zulassung;</listelem>
<listelem>
<symbol stellen="2">3.</symbol>die Bestellung des Vorsitzenden der Prüfungskommission (
<rvolink abkrvo="PO-FA" verwart="d" typ="e" gldart="PARA" gldsort="70" gldnr="2" abs="5" ursprung="u">§ 2 Abs. 5</rvolink>);</listelem>
<listelem>
<symbol stellen="2">4.</symbol>die Bestellung der Prüfer (
<rvolink abkrvo="PO-FA" verwart="d" typ="e" gldart="PARA" gldsort="70" gldnr="2" abs="6" ursprung="p">§ 2 Abs. 6</rvolink>) und der Berichterstatter (
<rvolink abkrvo="PO-FA" verwart="d" typ="e" gldart="PARA" gldsort="70" gldnr="13" abs="1" ursprung="u">§ 13 Abs. 1</rvolink>, 
<rvolink abkrvo="PO-FA" verwart="d" typ="e" gldart="PARA" gldsort="70" gldnr="13" abs="2" ursprung="u">2</rvolink> und 
<rvolink abkrvo="PO-FA" verwart="d" typ="e" gldart="PARA" gldsort="70" gldnr="13" abs="3" ursprung="u">3</rvolink>);</listelem>
<listelem>
<symbol stellen="2">5.</symbol>die Zuordnung der Prüfungsgegenstände an die Prüfer (
<rvolink abkrvo="PO-FA" verwart="d" typ="e" gldart="PARA" gldsort="70" gldnr="21" abs="3" ursprung="u">§ 21 Abs. 3</rvolink>);</listelem>
<listelem>
<symbol stellen="2">6.</symbol>die Entscheidung über Ansuchen gemäß 
<rvolink abkrvo="PO-FA" verwart="d" typ="e" gldart="PARA" gldsort="70" gldnr="18" abs="2" ursprung="u">§ 18 Abs. 2</rvolink> und 
<rvolink abkrvo="PO-FA" verwart="d" typ="e" gldart="PARA" gldsort="70" gldnr="18" abs="4" ursprung="u">4</rvolink>.</listelem>
</ziffernliste>
