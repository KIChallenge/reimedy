<schlagw><textelem>Tschechien, Tschechische Republik</textelem></schlagw><aendprot>
<dfeintrag perskz="polzer" zeitpunkt="2002-07-12"/>
</aendprot>
<puborgane>
<puborgan puborg="BGBl." gldpuborg="III" nrpuborg="95" begseite="579" jahrgang="2001"/>
</puborgane>
