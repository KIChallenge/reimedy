<nutzdaten>
<abschnitt>
<ueberschrift level="2" halign="c" typ="para">Artikel 2 
<br/>Sachlicher Geltungsbereich</ueberschrift>
<absatz typ="abs" halign="j">(1) Dieses Abkommen bezieht sich</absatz>
<liste>
<ziffernliste ebene="1">
<listelem>
<symbol stellen="2">1.</symbol>auf die tschechischen Rechtsvorschriften über</listelem>
</ziffernliste>
<literaliste ebene="2">
<listelem>
<symbol stellen="2">a)</symbol>die Krankenversicherung,</listelem>
<listelem>
<symbol stellen="2">b)</symbol>die Gesundheitsversicherung,</listelem>
<listelem>
<symbol stellen="2">c)</symbol>die Pensionsversicherung und die Pensionserhöhung wegen Hilflosigkeit,</listelem>
<listelem>
<symbol stellen="2">d)</symbol>die Leistungen bei Arbeitslosigkeit;</listelem>
</literaliste>
<ziffernliste ebene="1">
<listelem>
<symbol stellen="2">2.</symbol>auf die österreichischen Rechtsvorschriften über</listelem>
</ziffernliste>
<literaliste ebene="2">
<listelem>
<symbol stellen="2">a)</symbol>die Krankenversicherung,</listelem>
<listelem>
<symbol stellen="2">b)</symbol>die Unfallversicherung,</listelem>
<listelem>
<symbol stellen="2">c)</symbol>die Pensionsversicherung mit Ausnahme der Sonderversicherung für das Notariat,</listelem>
<listelem>
<symbol stellen="2">d)</symbol>das Arbeitslosengeld.</listelem>
</literaliste>
</liste>
<absatz typ="abs" halign="j">(2) Dieses Abkommen bezieht sich auch auf alle Rechtsvorschriften, welche die in Absatz 1 bezeichneten Rechtsvorschriften zusammenfassen, ändern oder ergänzen.</absatz>
</abschnitt>
</nutzdaten>
