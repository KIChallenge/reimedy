<uebrecht><rvolink ursprung="u" abkrvo="AlVG" verwart="d" gldart="PARA" gldsort="80" gldnr="79" typ="e">§ 79 AlVG</rvolink></uebrecht><puborgane><puborgan puborg="BGBl." gldpuborg="I" nrpuborg="71" begseite="1" jahrgang="2020"/></puborgane></metadaten>
