      <metadaten gldart="PARA" gldsort="70" nichtanzeigen="n" titrvo="Prüfungsordnung 2014" abkrvo="PO 2014" dokart="PO" titaen="Prüfungsordnung 2014 StF" abkaen="PO 2014 StF" urheber="Hauptverband" beschdat="2014-09-23" pubdat="2014-11-11" ikra="2015-09-01" sichtbarkeit="p" gldnr="41">
