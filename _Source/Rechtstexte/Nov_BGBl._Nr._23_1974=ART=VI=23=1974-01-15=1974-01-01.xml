          <ueberschrift typ="para" halign="c" widowctrl="1" keepwithnext="0" level="1">Artikel VI <br/>Vollziehung</ueberschrift><absatz typ="abs"><gldsym>Art.  VI</gldsym></absatz>
        <absatz typ="abs" halign="j">Mit der Vollziehung dieses Bundesgesetzes ist betraut:</absatz>
          <liste>
            <literaliste ebene="1">
              <listelem>
                <symbol stellen="2">a)</symbol>hinsichtlich der Bestimmungen der §§ 396 und 401 des Allgemeinen Sozialversicherungsgesetzes in der Fassung des Art. I Z 47 und 48 der Bundesminister für Justiz im Einvernehmen mit dem Bundesminister für soziale Verwaltung;</listelem>
              <listelem>
                <symbol stellen="2">b)</symbol>hinsichtlich der Bestimmung des Art. III Abs. 2 der Bundesminister für soziale Verwaltung im Einvernehmen mit dem Bundesminister für Justiz;</listelem>
              <listelem>
                <symbol stellen="2">c)</symbol>hinsichtlich aller übrigen Bestimmungen der Bundesminister für soziale Verwaltung.</listelem>
            </literaliste>
          </liste></abschnitt></nutzdaten>
