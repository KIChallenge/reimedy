<uebrecht><rvolink ursprung="u" abkrvo="BUAG" verwart="s" gldart="PARA" gldsort="70" gldnr="40" abs="32" pubdat="2016-08-01" ikra="2016-08-02" puborg="BGBl." gldpuborg="I" nrpuborg="72" jahrgang="2016" typ="e">§ 40 Abs. 32 BUAG idF 72/2016</rvolink></uebrecht><puborgane><puborgan puborg="BGBl." gldpuborg="I" nrpuborg="72" begseite="1" jahrgang="2016"/></puborgane></metadaten>
