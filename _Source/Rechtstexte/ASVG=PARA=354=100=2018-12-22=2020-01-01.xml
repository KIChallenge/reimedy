<metadaten gldsort="70" indbr="66.01.01" gldart="PARA" berkz="KVL; UVL; PVL; VMB; OV; REGR; VPAR; KA; AN; AG; SELB; " beschdat="2018-12-13" urheber="Bund" titrvo="Allgemeines Sozialversicherungsgesetz" gldnr="354" fassung="51" ikra="2020-01-01" sichtbarkeit="p" abkrvo="ASVG" titaen="Sozialversicherungs-OrganisationsG - 89. Novelle" dokart="BG" abkaen="SV-OG" pubdat="2018-12-22" nichtanzeigen="n">


