      <metadaten titrvo="Titel der Rechtsvorschrift: Datenschutzverordnung für die gesetzliche Sozialversicherung 2025" abkrvo="SV-DSV 2025" dokart="DSV" urheber="DVSV" beschdat="2025-09-24" pubdat="2025-09-25" ikra="2025-09-26" sichtbarkeit="p" nichtanzeigen="n" titaen=" Datenschutzverordnung für die gesetzliche Sozialversicherung 2025 StF" abkaen="SV-DSV 2025 StF" gldart="PARA" gldnr="20" gldsort="50">
        <puborgane><puborgan puborg="avsv" nrpuborg="54" jahrgang="2025">avsv   Nr. 54/2025 </puborgan>
          
        </puborgane>
      </metadaten>
      <nutzdaten>
        <abschnitt nr="1" typ="ns" paperf="h" endnhier="true">
          <ueberschrift typ="para" halign="c" level="2">Andere Auskunftsvorschriften</ueberschrift>
          <absatz typ="abs" halign="j">
            <gldsym>§ 20.</gldsym> (1) Die Auskunftsbestimmungen des <nolink>DSG</nolink> und der <wwwlink ursprung="u" url="https://eur-lex.europa.eu/legal-content/DE/TXT/PDF/?uri=OJ:L:2016:119:FULL&amp; from=DE" gldart="KEIN" typ="e">DSGVO</wwwlink> sind nicht anzuwenden, wenn Auskunftsbegehren auf einer anderen Grundlage als dem <nolink>Datenschutzgesetz</nolink> beruhen. Insbesondere werden die Vorschriften über Aufklärung und Information (<rvolink abkrvo="ASVG" verwart="d" typ="e" gldart="PARA" gldsort="50" gldnr="81" ursprung="u">§§ 81</rvolink>, <rvolink abkrvo="ASVG" verwart="d" typ="e" gldart="PARA" gldsort="50" gldnr="81a" ursprung="u">81a</rvolink><nolink> ASVG</nolink>, <rvolink abkrvo="B-KUVG" verwart="d" typ="e" gldart="PARA" gldsort="50" gldnr="27" ursprung="u">§§ 27</rvolink>, <rvolink abkrvo="B-KUVG" verwart="d" typ="e" gldart="PARA" gldsort="50" gldnr="27a" ursprung="u">27a</rvolink><nolink> B-KUVG</nolink>, <rvolink abkrvo="SVSG" verwart="d" typ="e" gldart="PARA" gldsort="50" gldnr="7" ursprung="u">§§ 7</rvolink>, <rvolink abkrvo="SVSG" verwart="d" typ="e" gldart="PARA" gldsort="50" gldnr="8" ursprung="u">8</rvolink> SVSG, <rvolink abkrvo="SV-DSV 2025" verwart="d" typ="e" gldart="PARA" gldsort="50" gldnr="19" ursprung="u">§§ 19</rvolink>) nicht berührt.</absatz>
          <absatz typ="abs" halign="j">(2) Auch bei sonstigen Auskünften über personenbezogene Daten können die Bestimmungen des <rvolink abkrvo="SV-DSV 2025" verwart="d" typ="e" gldart="PARA" gldsort="50" gldnr="19" abs="2" ursprung="u">§ 19 Abs. 2</rvolink> <nolink>sowie </nolink><rvolink abkrvo="SV-DSV 2025" verwart="d" typ="e" gldart="PARA" gldsort="50" gldnr="19" abs="4" ursprung="u">Abs. 4</rvolink> abhängig von den jeweiligen Umständen des Einzelfalles sinngemäß angewendet werden. </absatz>
        </abschnitt>
      </nutzdaten>
