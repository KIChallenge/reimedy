<metadaten gldart="PARA" gldsort="70" titrvo="Dienstordnung A für die Angestellten bei den Sozialversicherungsträgern Österreichs 2005" abkrvo="DO.A 2005" dokart="DO" titaen="107. Änderung der Dienstordnung A für die Angestellten bei den Sozialversicherungsträgern Österreichs 2005" abkaen="107. Änd DO.A 2005" urheber="Hauptverband" beschdat="2021-12-23" pubdat="2022-01-10" ikra="2022-01-01" sichtbarkeit="p" gldnr="99">
