<nutzdaten>
<abschnitt>
<ueberschrift level="3" halign="c" typ="para">Leistungen </ueberschrift>
<absatz typ="abs" halign="j">
<gldsym>§ 117.</gldsym> Als Leistungen der Krankenversicherung werden nach Maßgabe der Bestimmungen dieses Bundesgesetzes gewährt: </absatz>
<liste>
<ziffernliste ebene="1">
<listelem>
<symbol>1.</symbol>Zur Früherkennung von Krankheiten: Jugendlichenuntersuchungen und Vorsorge(Gesunden)untersuchungen (<rvolink verwart="d" gldart="PARA" ursprung="p" gldnr="132a" abkrvo="ASVG">§§ 132a</rvolink> und <rvolink verwart="d" gldart="PARA" ursprung="p" gldnr="132b" abkrvo="ASVG">132b</rvolink>); </listelem>
<listelem>
<symbol>2.</symbol>aus dem Versicherungsfall der Krankheit: Krankenbehandlung einschließlich jener im Rahmen der Hospiz- und Palliativversorgung (<rvolink verwart="d" gldart="PARA" ursprung="u" gldnr="133" abkrvo="ASVG" gldsort="70" typ="e" bereich="BIS" bis="137">§§ 133 bis 137</rvolink>), erforderlichenfalls medizinische Hauskrankenpflege (<rvolink verwart="d" gldart="PARA" ursprung="p" gldnr="151" abkrvo="ASVG">§ 151</rvolink>) oder Anstaltspflege (<rvolink verwart="d" gldart="PARA" ursprung="u" gldnr="144" abkrvo="ASVG" gldsort="70" typ="e" bereich="BIS" bis="150">§§ 144 bis 150</rvolink>); </listelem>
<listelem>
                <symbol stellen="3">3.</symbol>aus dem Versicherungsfall der Arbeitsunfähigkeit infolge Krankheit oder der geminderten Arbeitsfähigkeit: Krankengeld (<rvolink abkrvo="ASVG" verwart="d" typ="e" gldart="PARA" gldsort="70" gldnr="138" bereich="BIS" bis="143" ursprung="u">§§ 138 bis 143</rvolink>) oder Rehabilitationsgeld (<rvolink abkrvo="ASVG" verwart="d" typ="e" gldart="PARA" gldsort="70" gldnr="143a" ursprung="u">§ 143a</rvolink>);</listelem>
<listelem>
                <symbol stellen="4">3a.</symbol>aus dem Versicherungsfall der Wiedereingliederung nach langem Krankenstand: Wiedereingliederungsgeld (<rvolink abkrvo="ASVG" verwart="d" typ="e" gldart="PARA" gldsort="70" gldnr="143d" ursprung="u">§ 143d</rvolink>);</listelem><listelem>
<symbol>4.</symbol>aus dem Versicherungsfall der Mutterschaft: </listelem>
</ziffernliste>
<literaliste ebene="2">
<listelem>
                <symbol stellen="3">a)</symbol>ärztlicher Beistand, Hebammenbeistand sowie Beistand durch Angehörige des gehobenen Dienstes für Gesundheits- und Krankenpflege (<rvolink abkrvo="ASVG" verwart="d" typ="e" gldart="PARA" gldsort="50" gldnr="159" ursprung="u">§ 159</rvolink>);</listelem>
<listelem>
<symbol>b)</symbol>Heilmittel und Heilbehelfe (<rvolink verwart="d" gldart="PARA" ursprung="p" gldnr="160" abkrvo="ASVG">§ 160</rvolink>); </listelem>
<listelem>
<symbol>c)</symbol>Pflege in einer Krankenanstalt (<rvolink verwart="d" gldart="PARA" ursprung="p" gldnr="161" abkrvo="ASVG">§ 161</rvolink>); </listelem>
<listelem>
<symbol>d)</symbol>Wochengeld (<rvolink verwart="d" gldart="PARA" ursprung="p" gldnr="162" abkrvo="ASVG">§ 162</rvolink>). </listelem>
<listelem>
<symbol>e)</symbol>Aufgehoben. </listelem>
</literaliste>
<ziffernliste ebene="1">
<listelem>
<symbol>5.</symbol>Aufgehoben. </listelem>
</ziffernliste>
</liste>
