<abschnitt nr="1" typ="ns" paperf="h" endnhier="true">
          <ueberschrift typ="para" halign="c" widowctrl="1" keepwithnext="0" level="1">Artikel IV <br/>Vollziehung</ueberschrift><absatz typ="abs"><gldsym>Art. IV</gldsym></absatz>
        
          
          
          
          <absatz typ="abs" halign="j">Mit der Vollziehung dieses Bundesgesetzes ist betraut</absatz>
          <liste>
            <literaliste ebene="1">
              <listelem>
                <symbol stellen="2">a)</symbol>hinsichtlich der Bestimmungen der §§ 22a, 26c und 55 Abs. 3 des Beamten-Kranken- und Unfallversicherungsgesetzes in der Fassung des Art. I Z 11, 15 und 28 der Bundesminister für soziale Verwaltung im Einvernehmen mit dem Bundesminister für Landesverteidigung;</listelem>
              <listelem>
                <symbol stellen="2">b)</symbol>hinsichtlich der Bestimmungen des Art. II Abs. 1 und 2 der Bundesminister für Justiz im Einvernehmen mit dem Bundesminister für soziale Verwaltung;</listelem>
              <listelem>
                <symbol stellen="2">c)</symbol>hinsichtlich aller übrigen Bestimmungen der Bundesminister für soziale Verwaltung.</listelem>
            </literaliste>
          </liste></abschnitt></nutzdaten>
