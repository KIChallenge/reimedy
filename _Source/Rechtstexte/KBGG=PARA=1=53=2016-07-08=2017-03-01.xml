<nutzdaten>
<abschnitt>
<ueberschrift widowctrl="1" keepwithnext="1" halign="c" level="1" typ="g1">Abschnitt 1 </ueberschrift>
<ueberschrift widowctrl="1" keepwithnext="0" halign="c" level="2" typ="para">Leistungsarten </ueberschrift>

          <absatz typ="abs" halign="j"><gldsym>§ 1.</gldsym> Als Leistungen werden nach Maßgabe dieses Bundesgesetzes gewährt:</absatz>
          <liste>
            <ziffernliste ebene="1">
              <listelem>
                <symbol stellen="2">1.</symbol>das pauschale Kinderbetreuungsgeld als Konto;</listelem>
              <listelem>
                <symbol stellen="2">2.</symbol>das Kinderbetreuungsgeld als Ersatz des Erwerbseinkommens;</listelem>
              <listelem>
                <symbol stellen="2">3.</symbol>die Beihilfe zum pauschalen Kinderbetreuungsgeld;</listelem>
              <listelem>
                <symbol stellen="2">4.</symbol>der Partnerschaftsbonus.</listelem>
            </ziffernliste>
            <schluss typ="Abs">Der Bezug von pauschalem Kinderbetreuungsgeld als Konto schließt einen Bezug von Kinderbetreuungsgeld als Ersatz des Erwerbseinkommens aus und umgekehrt.</schluss>
          </liste>
</abschnitt>
