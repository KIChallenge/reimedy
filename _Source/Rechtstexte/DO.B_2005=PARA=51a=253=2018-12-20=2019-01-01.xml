<metadaten gldart="PARA" gldsort="70" titrvo="Dienstordnung B für die Ärzte und Dentisten bei den Sozialversicherungsträgern Österreichs 2005" abkrvo="DO.B 2005" dokart="DO" titaen="94. Änderung der Dienstordnung B für die Ärzte bei den Sozialversicherungsträgern Österreichs 2005" abkaen="94. Änd DO.B 2005" urheber="Hauptverband" beschdat="2018-12-11" pubdat="2018-12-20" ikra="2019-01-01" sichtbarkeit="p" gldnr="51a">
