<?xml version="1.0" encoding="UTF-8"?>
<sozdok xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="Sozdok.xsd" dokid="GKK_Bgld_Anh_GOVorst_2015=PARA=3=57=2015-04-22=2015-04-28"><rvo dokidCms="GKK_Bgld_Anh_GOVorst_2015=PARA=3=57=2015-04-22=2015-04-28">
      <metadaten gldart="PARA" gldsort="70" titrvo="Anhänge zur Geschäftsordnung des Vorstandes der Burgenländischen Gebietskrankenkasse 2015" abkrvo="GKK Bgld Anh GOVorst 2015" dokart="AnhGO" urheber="GKK Bgl" beschdat="2014-09-02" pubdat="2015-04-22" ikra="2015-04-28" sichtbarkeit="p" nichtanzeigen="n" titaen="Anhänge zur Geschäftsordnung des Vorstandes der Burgenländischen Gebietskrankenkasse 2015 Stammfassung" abkaen="GKK Bgld Anh GOVorst 2015 StF" gldnr="3">
        <puborgane><puborgan puborg="avsv" nrpuborg="57" jahrgang="2015">avsv   Nr. 57/2015 </puborgan>
				
					</puborgane>
      </metadaten>
      <nutzdaten>
        <abschnitt endnhier="true" nr="1" paperf="h" typ="ns">
          <ueberschrift halign="c" typ="para" level="1">Laufende Angelegenheiten, die dem Büro der Burgenländischen <br/>Gebietskrankenkasse übertragen wurden</ueberschrift>
          <absatz halign="j" typ="abs">
            <gldsym>§ 3.</gldsym> Folgende Beschlüsse wurden gefasst:</absatz>
          <abstand halign="l"/>
          <liste>
            <ziffernliste ebene="1">
              <listelem>
                <symbol stellen="2">1.</symbol>Beschluss-Nr. 162 vom 29. Juni 1989:</listelem>
            </ziffernliste>
          </liste>
          <absatz halign="j" typ="abs">„Ab sofort wird dem Büro die Aussonderung von Altinventar übertragen.“</absatz>
          <abstand halign="l"/>
          <liste>
            <ziffernliste ebene="1">
              <listelem>
                <symbol stellen="2">2.</symbol>Beschluss-Nr. 97 vom 22. März 1994:</listelem>
            </ziffernliste>
          </liste>
          <absatz halign="j" typ="abs">„Ab sofort wird dem Büro die Anschaffung von Investitionsgütern, die bereits im Rahmen des jährlichen Investitionsplanes beschlossen worden sind, übertragen.“</absatz>
          <abstand halign="l"/>
          <liste>
            <ziffernliste ebene="1">
              <listelem>
                <symbol stellen="2">3.</symbol>Beschluss-Nr. 332 vom 15. Dezember 1994:</listelem>
            </ziffernliste>
          </liste>
          <absatz halign="j" typ="abs">„Ab sofort wird dem Büro die Anschaffung von Wirtschaftsgütern übertragen, soferne deren Wert das 6-fache der monatlichen Höchstbeitragsgrundlage nicht übersteigt.“</absatz>
          <abstand halign="l"/>
          <liste>
            <ziffernliste ebene="1">
              <listelem>
                <symbol stellen="2">4.</symbol>Beschluss-Nr. 178 vom 4. Juli 1995:</listelem>
            </ziffernliste>
          </liste>
          <absatz halign="j" typ="abs">„Ab 1. August 1995 wird der Ausgleich von Beitragskonten dem Büro übertragen, wenn der Betrag von € 15,92 für Rückstände bzw. € 10,68 für Guthaben (die Beträge sind zu valorisieren) nicht überschritten sind.“</absatz>
          <abstand halign="l"/>
          <liste>
            <ziffernliste ebene="1">
              <listelem>
                <symbol stellen="2">5.</symbol>Beschluss-Nr. 198 vom 27. August 1996:</listelem>
            </ziffernliste>
          </liste>
          <absatz halign="j" typ="abs">„Das Büro wird ermächtigt, Beitragsrückstände, die bereits vorläufig abgeschrieben worden sind, bei erwiesener Uneinbringlichkeit endgültig aus der außerbuchhalterischen und Bearbeitungsevidenz zu nehmen.“</absatz>
          <abstand halign="l"/>
          <liste>
            <ziffernliste ebene="1">
              <listelem>
                <symbol stellen="2">6.</symbol>Beschluss-Nr. 85 vom 8. April 1997:</listelem>
            </ziffernliste>
          </liste>
          <absatz halign="j" typ="abs">„Ab sofort wird dem Büro die Erledigung von Anfechtungen im Konkursverfahren übertragen.“</absatz>
          <abstand halign="l"/>
          <liste>
            <ziffernliste ebene="1">
              <listelem>
                <symbol stellen="2">7.</symbol>Beschluss-Nr. 162 vom 1. Juli 1997:</listelem>
            </ziffernliste>
          </liste>
          <absatz halign="j" typ="abs">„Ab sofort wird der Verzicht auf die gerichtliche Geltendmachung von geringwertigen Regress- und sonstigen Forderungen, die den Betrag, der der täglichen Geringfügigkeitsgrenze entspricht, nicht überschreiten, dem Büro übertragen.“</absatz>
          <abstand halign="l"/>
          <liste>
            <ziffernliste ebene="1">
              <listelem>
                <symbol stellen="2">8.</symbol>Beschluss-Nr. 67 vom 2. April 1998:</listelem>
            </ziffernliste>
          </liste>
          <absatz halign="j" typ="abs">„Ab sofort wird der Abschluss von Raten- und Stundungsvereinbarungen dem Büro übertragen.“</absatz>
          <abstand halign="l"/>
          <liste>
            <ziffernliste ebene="1">
              <listelem>
                <symbol stellen="2">9.</symbol>Beschluss-Nr. 235 vom 15. Dezember 1998:</listelem>
            </ziffernliste>
          </liste>
          <absatz halign="j" typ="abs">„Neufassung der Richtlinien für den Verzicht auf Rückforderung zu Unrecht erbrachter Leistungen nach dem <nolink>ASVG</nolink> bzw. <nolink>EFZG</nolink> durch das Büro, sofern das Ausmaß der Rückforderung das 10-fache der täglichen Höchstbeitragsgrundlage nicht überschreitet.“</absatz>
          <abstand halign="l"/>
          <liste>
            <ziffernliste ebene="1">
              <listelem>
                <symbol stellen="3">10.</symbol>Beschluss-Nr. 40 vom 3. März 1999:</listelem>
            </ziffernliste>
          </liste>
          <absatz halign="j" typ="abs">„Neufassung der Richtlinien für die Gewährung von Maßnahmen zur Festigung der Gesundheit und Krankheitsverhütung.“</absatz>
          <abstand halign="l"/>
          <liste>
            <ziffernliste ebene="1">
              <listelem>
                <symbol stellen="3">11.</symbol>Beschluss-Nr. 21 vom 10. Feber 2000:</listelem>
            </ziffernliste>
          </liste>
          <absatz halign="j" typ="abs">„Änderung der Richtlinien für die Gewährung von Gehaltsvorschüssen.“</absatz>
          <abstand halign="l"/>
          <liste>
            <ziffernliste ebene="1">
              <listelem>
                <symbol stellen="3">12.</symbol>Beschluss-Nr. 150 vom 28. August 2001:</listelem>
            </ziffernliste>
          </liste>
          <absatz halign="j" typ="abs">„Anpassung der Richtlinien des Vorstandes infolge EURO-Umstellung betreffend:</absatz>
          <liste>
            <strichliste ebene="1">
              <listelem>
                <symbol stellen="1">-</symbol>Vorschreibung von Beitragszuschlägen gemäß <rvolink abkrvo="ASVG" verwart="d" typ="e" gldart="PARA" gldsort="70" gldnr="113" abs="1" ursprung="u">§ 113 Abs. 1</rvolink> <nolink>und </nolink><rvolink abkrvo="ASVG" verwart="d" typ="e" gldart="PARA" gldsort="70" gldnr="113" abs="2" ursprung="u">Abs. 2</rvolink><nolink> ASVG</nolink></listelem>
              <listelem>
                <symbol stellen="1">-</symbol>Vorgangsweise bei Anfechtungen</listelem>
              <listelem>
                <symbol stellen="1">-</symbol>Ausgleich von Beitragskonten</listelem>
              <listelem>
                <symbol stellen="1">-</symbol>Abschluss von Raten- und Stundungsvereinbarungen.“</listelem>
            </strichliste>
          </liste>
          <abstand halign="l"/>
          <liste>
            <ziffernliste ebene="1">
              <listelem>
                <symbol stellen="3">13.</symbol>Beschluss-Nr. 182 vom 9. Oktober 2001:</listelem>
            </ziffernliste>
          </liste>
          <absatz halign="j" typ="abs">„Anpassung der Richtlinien für die Gewährung von Gehaltsvorschüssen.“</absatz>
          <abstand halign="l"/>
          <liste>
            <ziffernliste ebene="1">
              <listelem>
                <symbol stellen="3">14.</symbol>Beschluss-Nr. 74 vom 23. April 2002:</listelem>
            </ziffernliste>
          </liste>
          <absatz halign="j" typ="abs">„Das Büro wird zur Erteilung der Rezepturbefugnis für Wahlärzte unter der Voraussetzung der Bindung an die Richtlinien für die ökonomische Verschreibweise für Heilmittel und Heilbehelfe ab 1.5.2002 ermächtigt.“</absatz>
          <abstand halign="l"/>
          <liste>
            <ziffernliste ebene="1">
              <listelem>
                <symbol stellen="3">15.</symbol>Beschluss-Nr. 101 vom 6. Juni 2002:</listelem>
            </ziffernliste>
          </liste>
          <absatz halign="j" typ="abs">„Richtlinien über den Ausgleich von Beitragskonten im Bagatellbereich mit künftiger Anpassung an die jeweilige Portogebühr.“</absatz>
          <abstand halign="l"/>
          <liste>
            <ziffernliste ebene="1">
              <listelem>
                <symbol stellen="3">16.</symbol>Beschluss-Nr. 120 vom 6. Juni 2002:</listelem>
            </ziffernliste>
          </liste>
          <absatz halign="j" typ="abs">„Das Büro wird ermächtigt, Beitragsforderungen unterjährig abzuschreiben – mindestens halbjährliche Berichtspflicht an den Vorstand.“</absatz>
          <abstand halign="l"/>
          <liste>
            <ziffernliste ebene="1">
              <listelem>
                <symbol stellen="3">17.</symbol>Beschluss-Nr. 113 vom 6. Juni 2002:</listelem>
            </ziffernliste>
          </liste>
          <absatz halign="j" typ="abs">„Anpassung der gültigen Richtlinien (Nr. 21 vom 10.2.2000) für die Gewährung von Gehaltsvorschüssen.“</absatz>
          <abstand halign="l"/>
          <liste>
            <ziffernliste ebene="1">
              <listelem>
                <symbol stellen="3">18.</symbol>Beschluss-Nr. 60 vom 17. April 2003:</listelem>
            </ziffernliste>
          </liste>
          <absatz halign="j" typ="abs">„Anpassung der gültigen Richtlinien (Nr. 40 vom 3.3.1999) für die Gewährung von Maßnahmen zur Festigung der Gesundheit und Krankheitsverhütung.“</absatz>
          <abstand halign="l"/>
          <liste>
            <ziffernliste ebene="1">
              <listelem>
                <symbol stellen="3">19.</symbol>Beschluss-Nr. 102 vom 13. April 2004:</listelem>
            </ziffernliste>
          </liste>
          <absatz halign="j" typ="abs">„Übertragung diverser Aufgaben des Regresswesens an das Büro.“</absatz>
          <abstand halign="l"/>
          <liste>
            <ziffernliste ebene="1">
              <listelem>
                <symbol stellen="3">20.</symbol>Beschluss-Nr. 237 vom 30. August 2005:</listelem>
            </ziffernliste>
          </liste>
          <absatz halign="j" typ="abs">„Im Falle der Entscheidung über die Vergabe einer Vertragsarztplanstelle durch den Zulassungsausschuss wird dessen einstimmige Entscheidung für rechtsverbindlich erklärt.“</absatz>
          <abstand halign="l"/>
          <liste>
            <ziffernliste ebene="1">
              <listelem>
                <symbol stellen="3">21.</symbol>Beschluss-Nr. 55 vom 2. März 2006:</listelem>
            </ziffernliste>
          </liste>
          <absatz halign="j" typ="abs">„Bis zur Höhe der halben monatlichen Höchstbeitragsgrundlage wird die Nachsicht von Verzugszinsen dem Büro übertragen.“</absatz>
          <abstand halign="l"/>
          <liste>
            <ziffernliste ebene="1">
              <listelem>
                <symbol stellen="3">22.</symbol>Beschluss-Nr. 182 vom 27. Juni 2006:</listelem>
            </ziffernliste>
          </liste>
          <absatz halign="j" typ="abs">„Grundsätze für die Einreihung und Umreihung von MitarbeiterInnen im Verwaltungsdienst.“</absatz>
          <abstand halign="l"/>
          <liste>
            <ziffernliste ebene="1">
              <listelem>
                <symbol stellen="3">23.</symbol>Beschluss-Nr. 223 vom 29. August 2006:</listelem>
            </ziffernliste>
          </liste>
          <absatz halign="j" typ="abs">„Neufassung der Richtlinien über die Ausübung der Vertretungsvollmacht in Strafverfahren gemäß <rvolink abkrvo="StGB" verwart="d" typ="e" gldart="PARA" gldsort="70" gldnr="153c" ursprung="u">§ 153c</rvolink><nolink> StGB</nolink>.“</absatz>
          <abstand halign="l"/>
          <liste>
            <ziffernliste ebene="1">
              <listelem>
                <symbol stellen="3">24.</symbol>Beschluss-Nr. 274 vom 6. November 2007:</listelem>
            </ziffernliste>
          </liste>
          <absatz halign="j" typ="abs">„Grundsätze für die Genehmigung von Studienurlauben für ÄrztInnen.“</absatz>
          <abstand halign="l"/>
          <liste>
            <ziffernliste ebene="1">
              <listelem>
                <symbol stellen="3">25.</symbol>Beschluss-Nr. 292 vom 18. Dezember 2007:</listelem>
            </ziffernliste>
          </liste>
          <absatz halign="j" typ="abs">„Neufassung der Richtlinien über die Anwendung der Bestimmungen der <rvolink abkrvo="ASVG" verwart="d" typ="e" gldart="PARA" gldsort="70" gldnr="56" ursprung="u">§§ 56</rvolink>, <rvolink abkrvo="ASVG" verwart="d" typ="e" gldart="PARA" gldsort="70" gldnr="111" ursprung="u">111</rvolink> und <rvolink abkrvo="ASVG" verwart="d" typ="e" gldart="PARA" gldsort="70" gldnr="113" ursprung="u">113</rvolink><nolink> ASVG</nolink> sowie über die Nachsicht von Ordnungsbeiträgen gemäß <rvolink abkrvo="ASVG" verwart="d" typ="e" gldart="PARA" gldsort="70" gldnr="56" ursprung="u">§ 56</rvolink><nolink> ASVG</nolink>.“</absatz>
          <abstand halign="l"/>
          <liste>
            <ziffernliste ebene="1">
              <listelem>
                <symbol stellen="3">26.</symbol>Beschluss-Nr. 256 vom 1. Oktober 2009:</listelem>
            </ziffernliste>
          </liste>
          <absatz halign="j" typ="abs">„Freizeitgewährung sowie Kostenersätze an Bedienstete bei externer Ablegung von Dienstprüfungen.“</absatz>
          <abstand halign="l"/>
          <liste>
            <ziffernliste ebene="1">
              <listelem>
                <symbol stellen="3">27.</symbol>Beschluss-Nr. 74 vom 26. April 2011:</listelem>
            </ziffernliste>
          </liste>
          <absatz halign="j" typ="abs">„Gewährung von Leistungen aus dem Unterstützungsfonds bis zur Höhe der täglichen Höchstbeitragsgrundlage sowie Ablehnungen auf Grund der Richtlinien gemäß <rvolink abkrvo="ASVG" verwart="d" typ="e" gldart="PARA" gldsort="70" gldnr="84" abs="6" ursprung="u">§ 84 Abs. 6</rvolink><nolink> ASVG</nolink>.“</absatz>
          <abstand halign="l"/>
          <liste>
            <ziffernliste ebene="1">
              <listelem>
                <symbol stellen="3">28.</symbol>Beschluss-Nr. 198 vom 30. August 2011:</listelem>
            </ziffernliste>
          </liste>
          <absatz halign="j" typ="abs">„Neufassung der Richtlinien für Zahnersatz und Kieferregulierungen.“</absatz>
          <abstand halign="l"/>
          <liste>
            <ziffernliste ebene="1">
              <listelem>
                <symbol stellen="3">29.</symbol>Beschluss-Nr. 247 vom 6. Oktober 2011:</listelem>
            </ziffernliste>
          </liste>
          <absatz halign="j" typ="abs">„Neufassung der Richtlinien über die Zustimmung zu Ausgleichs (Zwangsausgleichs)quoten und der Richtlinien über das Abstimmungsverhalten von Kassenbediensteten bei Schuldenregulierungsverfahren.“</absatz>
          <abstand halign="l"/>
          <liste>
            <ziffernliste ebene="1">
              <listelem>
                <symbol stellen="3">30.</symbol>Beschluss-Nr. 174 vom 27. Juni 2012:</listelem>
            </ziffernliste>
          </liste>
          <absatz halign="j" typ="abs">„Neufassung der Richtlinien über die Vorgansweise bei vorläufig abgeschriebenen Beitragsforderungen, deren endgültige Uneinbringlichkeit sich herausstellt.“</absatz>
          <abstand halign="l"/>
          <liste>
            <ziffernliste ebene="1">
              <listelem>
                <symbol stellen="3">31.</symbol>Beschluss-Nr. 302 vom 6. November 2012:</listelem>
            </ziffernliste>
          </liste>
          <absatz halign="j" typ="abs">„Neufassung der Richtlinien über den Ausgleich von Beitragskonten.“</absatz>
          <abstand halign="l"/>
          <liste>
            <ziffernliste ebene="1">
              <listelem>
                <symbol stellen="3">32.</symbol>Beschluss-Nr. 303 vom 6. November 2012:</listelem>
            </ziffernliste>
          </liste>
          <absatz halign="j" typ="abs">„Änderung der Bagatellgrenzen für EDV-mäßige Mahnungen und Exekutionen.“</absatz>
          <abstand halign="l"/>
          <liste>
            <ziffernliste ebene="1">
              <listelem>
                <symbol stellen="3">33.</symbol>Beschluss-Nr. 344 vom 11. Dezember 2012:</listelem>
            </ziffernliste>
          </liste>
          <absatz halign="j" typ="abs">„Richtlinien für die Vorschreibung von Beitragszuschlägen und Ordnungsbeiträgen bzw. deren Nachsicht.“</absatz>
          <abstand halign="l"/>
          <liste>
            <ziffernliste ebene="1">
              <listelem>
                <symbol stellen="3">34.</symbol>Beschluss-Nr. 263 vom 2. September 2014:</listelem>
            </ziffernliste>
          </liste>
          <absatz halign="j" typ="abs">„Richtlinien über die Vorgangsweise bei offenen Forderungen aus Service-Entgelt, Transportkostenanteilen und zahnmedizinischen Leistungen.“</absatz>
          
          
        </abschnitt>
      </nutzdaten>
