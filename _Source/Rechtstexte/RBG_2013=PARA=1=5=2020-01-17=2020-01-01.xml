      <metadaten gldart="PARA" gldsort="70" nichtanzeigen="n" titrvo="Richtlinien für die Grundsätze der Erstellung von Gutachten in Angelegenheiten der beruflichen Maßnahmen der Rehabilitation 2013" abkrvo="RBG 2013" dokart="RL DVSV" titaen="SV-OG Anpassungsverlautbarung" abkaen="SV-OG AnpVerl" urheber="DVSV" beschdat="2020-01-14" pubdat="2020-01-17" ikra="2020-01-01" sichtbarkeit="p" gldnr="1">
        
      <puborgane><puborgan puborg="avsv" nrpuborg="5" jahrgang="2020" begseite="5"/></puborgane></metadaten>
      <nutzdaten>
        <abschnitt endnhier="true" nr="1" paperf="h" typ="ns">
          <ueberschrift halign="c" typ="g1" level="1">ABSCHNITT 1 <br/>Allgemeines</ueberschrift>
          <ueberschrift halign="c" typ="para" level="2">Inhalt und Geltungsbereich</ueberschrift>
          <absatz halign="j" typ="abs">
            <gldsym>§ 1.</gldsym> (1) Rechtsgrundlage dieser Richtlinien ist <rvolink abkrvo="ASVG" verwart="d" typ="e" gldart="PARA" gldsort="80" gldnr="30a" abs="1" ziff="35" ursprung="u">§ 30a Abs. 1 Z 35</rvolink><nolink> ASVG</nolink>.</absatz>
          <absatz halign="j" typ="abs">(2) Die Richtlinien regeln nach Maßgabe der gesetzlichen Bestimmungen die Grundsätze für die Gutachtenserstellung in Angelegenheiten der beruflichen Rehabilitation im Kompetenzzentrum Begutachtung (<rvolink abkrvo="ASVG" verwart="d" typ="e" gldart="PARA" gldsort="70" gldnr="307g" ursprung="u">§ 307g</rvolink><nolink> ASVG</nolink>, <rvolink abkrvo="GSVG" verwart="d" typ="e" gldart="PARA" gldsort="70" gldnr="171a" ursprung="u">§ 171a</rvolink><nolink> GSVG</nolink>, <rvolink abkrvo="BSVG" verwart="d" typ="e" gldart="PARA" gldsort="70" gldnr="163a" ursprung="u">§ 163a</rvolink><nolink> BSVG</nolink>) oder der Begutachtungsstelle der Versicherungsanstalt für Eisenbahnen und Bergbau in Zusammenhang mit den Versicherungsfällen der geminderten Arbeitsfähigkeit und der Erwerbsunfähigkeit.</absatz>
          <absatz halign="j" typ="abs">(3) Diese Richtlinien gelten für alle Pensionsversicherungsträger, die dem Dachverband der Sozialversicherungsträger angehören.</absatz>
        </abschnitt>
      </nutzdaten>
