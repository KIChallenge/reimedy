<metadaten gldart="PARA" gldsort="70" titrvo="Dienstordnung A für die Angestellten bei den Sozialversicherungsträgern Österreichs 2005" abkrvo="DO.A 2005" dokart="DO" titaen="100. Änderung der Dienstordnung A für die Angestellten bei den Sozialversicherungsträgern Österreichs 2005" abkaen="100. Änd DO.A 2005" urheber="Hauptverband" beschdat="2019-04-09" pubdat="2019-04-16" ikra="2020-01-01" sichtbarkeit="p" gldnr="201">


