<metadaten gldart="PARA" gldsort="70" titrvo="Dienstordnung A für die Angestellten bei den Sozialversicherungsträgern Österreichs 2005" abkrvo="DO.A 2005" dokart="DO" titaen="87. Änderung der Dienstordnung A für die Angestellten bei den Sozialversicherungsträgern Österreichs 2005" abkaen="87. Änd DO.A 2005" urheber="Hauptverband" beschdat="2014-10-07" pubdat="2014-10-22" ikra="2014-07-01" sichtbarkeit="p" gldnr="257" nichtanzeigen="n">

