      <metadaten gldart="PARA" gldsort="70" nichtanzeigen="n" titrvo="Richtlinien für die Durchführung und Auswertung der Jugendlichenuntersuchungen 2016" abkrvo="RJU 2016" dokart="RL DVSV" titaen="SV-OG Anpassungsverlautbarung" abkaen="SV-OG AnpVerl" urheber="Hauptverband" beschdat="2020-01-14" pubdat="2020-01-17" ikra="2020-01-01" sichtbarkeit="p" gldnr="6">
        
