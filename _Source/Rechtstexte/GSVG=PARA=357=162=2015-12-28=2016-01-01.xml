<abschnitt nr="1" typ="ns" paperf="h" endnhier="true">
          
          <ueberschrift typ="para" halign="c" level="3">Schlussbestimmung zu Art. 2 des Bundesgesetzes BGBl. I Nr. 79/2015</ueberschrift>
          <absatz typ="abs" halign="j">
            <gldsym>§ 357.</gldsym> (1) Es treten in der Fassung des Bundesgesetzes BGBl. I Nr. 79/2015 in Kraft:</absatz>
          
        
          
          
          
          
          
          
          <liste>
            <ziffernliste ebene="1">
              <listelem>
                <symbol stellen="2">1.</symbol>mit 1. Jänner 2016 § 35 Abs. 2a, 5b und 6;</listelem>
              <listelem>
                <symbol stellen="2">2.</symbol>mit 1. Jänner 2017 § 35 Abs. 5.</listelem>
            </ziffernliste>
          </liste>
          <absatz typ="abs" halign="j">(2) § 132 Abs. 5 in der Fassung des Bundesgesetzes BGBl. I Nr. 79/2015 tritt gleichzeitig mit den in § 689 Abs. 1a ASVG genannten Bestimmungen in Kraft.</absatz></abschnitt></nutzdaten>
