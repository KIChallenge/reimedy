      <nutzdaten>
        <abschnitt nr="1" typ="ns" paperf="h" endnhier="true">
          <ueberschrift typ="para" halign="c" level="1">Inhalt der Berichte</ueberschrift>
          <absatz typ="abs" halign="j">
            <gldsym>§ 3.</gldsym> (1) Die schriftlichen Berichte über den Umsetzungsstand haben jedenfalls nachstehende Bereiche zu umfassen:</absatz>
          <liste>
            <ziffernliste ebene="1">
              <listelem>
                <symbol stellen="2">1.</symbol>Meilensteinpläne,</listelem>
              <listelem>
                <symbol stellen="2">2.</symbol>Programmstruktur,</listelem>
              <listelem>
                <symbol stellen="2">3.</symbol>Statusreporting zu den Arbeitspaketen,</listelem>
              <listelem>
                <symbol stellen="2">4.</symbol>Überblick über Programmrisiken.</listelem>
            </ziffernliste>
          </liste>
          <absatz typ="abs" halign="j">(2) Die schriftlichen Berichte haben insbesondere das Erreichen der nach Abs. 1 Z 1 festgelegten Meilensteine sowie allenfalls</absatz>
          <liste>
            <ziffernliste ebene="1">
              <listelem>
                <symbol stellen="2">1.</symbol>eine Darstellung möglicher Zielverfehlungen,</listelem>
              <listelem>
                <symbol stellen="2">2.</symbol>die Analyse der Ursachen der Zielverfehlungen,</listelem>
              <listelem>
                <symbol stellen="2">3.</symbol>eine Feststellung, welchem Wirkungsbereich die Zielverfehlung zuzurechnen ist und</listelem>
              <listelem>
                <symbol stellen="2">4.</symbol>die zur Gegensteuerung bereits gesetzten oder geplanten Maßnahmen</listelem>
            </ziffernliste>
            <schluss typ="Abs">zu beinhalten.</schluss>
          </liste>
        </abschnitt>
      </nutzdaten>
