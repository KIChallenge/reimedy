<nutzdaten>
<abschnitt>
<ueberschrift widowctrl="1" keepwithnext="1" halign="c" level="2" typ="para">Aufgaben des Büros</ueberschrift>
<absatz typ="abs" widowctrl="1" keepwithnext="0" halign="j">
<gldsym>§ 5.</gldsym> (1) Dem leitenden Angestellten bzw. einem von ihm betrauten Angestellten obliegen:
</absatz>
<liste>
<ziffernliste ebene="1">
<listelem>
<symbol stellen="2">1.</symbol>dem Obmann Vorschläge für die in 
<rvolink abkrvo="Prüfungsordnung Grundausbildung" verwart="d" typ="e" gldart="PARA" gldsort="70" gldnr="4" abs="1" ursprung="u">§ 4 Abs. 1</rvolink> angeführten Angelegenheiten zu erstatten,</listelem>
<listelem>
<symbol stellen="2">2.</symbol>die Angestellten von der Anberaumung der Prüfung in Kenntnis zu setzen (
<rvolink abkrvo="Prüfungsordnung Grundausbildung" verwart="d" typ="e" gldart="PARA" gldsort="70" gldnr="8" abs="2" ursprung="u">§ 8 Abs. 2</rvolink>),</listelem>
<listelem>
<symbol stellen="2">3.</symbol>die Prüfungskandidaten den Prüfungskommissionen zuzuweisen (
<rvolink abkrvo="Prüfungsordnung Grundausbildung" verwart="d" typ="e" gldart="PARA" gldsort="70" gldnr="10" abs="1" ursprung="u">§ 10 Abs. 1</rvolink>),</listelem>
<listelem>
<symbol stellen="2">4.</symbol>die Termine der schriftlichen Tests (
<rvolink abkrvo="Prüfungsordnung Grundausbildung" verwart="d" typ="e" gldart="PARA" gldsort="70" gldnr="13" abs="1" ursprung="u">§ 13 Abs. 1</rvolink>), die dafür notwendigen Aufsichtsführenden (
<rvolink abkrvo="Prüfungsordnung Grundausbildung" verwart="d" typ="e" gldart="PARA" gldsort="70" gldnr="13" abs="3" ursprung="u">§ 13 Abs. 3</rvolink> erster Satz) sowie die Begutachter (
<rvolink abkrvo="Prüfungsordnung Grundausbildung" verwart="d" typ="e" gldart="PARA" gldsort="70" gldnr="13" abs="4" ursprung="u">§ 13 Abs. 4</rvolink>) zu bestimmen,</listelem>
<listelem>
<symbol stellen="2">5.</symbol>die schriftlichen Prüfungsfragen zu bestimmen,</listelem>
<listelem>
<symbol stellen="2">6.</symbol>die Prüfungskandidaten von der Zulassung zur Prüfung, sowie die Kommissionsvorsitzenden und Prüfer von der Festsetzung der Prüfungstermine und der Kommissionseinteilung zu verständigen,</listelem>
<listelem>
<symbol stellen="2">7.</symbol>den Hauptverband im Sinne des 
<rvolink abkrvo="Prüfungsordnung Grundausbildung" verwart="d" typ="e" gldart="PARA" gldsort="70" gldnr="10" abs="2" ursprung="u">§ 10 Abs. 2</rvolink> zu verständigen,</listelem>
<listelem>
<symbol stellen="2">8.</symbol>die Ausfertigung der Prüfungsakten zu veranlassen (
<rvolink abkrvo="Prüfungsordnung Grundausbildung" verwart="d" typ="e" gldart="PARA" gldsort="70" gldnr="16" abs="2" ursprung="u">§ 16 Abs. 2</rvolink>).</listelem>
</ziffernliste>
</liste>
</abschnitt>
