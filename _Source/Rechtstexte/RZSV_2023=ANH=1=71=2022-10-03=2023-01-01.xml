<sozdok xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" dokid="RZSV_2023=ANH=1=71=2022-10-03=2023-01-01" xsi:noNamespaceSchemaLocation="Sozdok.xsd"><rvo dokidCms="RZSV_2023=ANH=1=71=2022-10-03=2023-01-01">
      <metadaten nichtanzeigen="n" titrvo="Richtlinien für die einheitliche Anwendung der Verordnungen der Europäischen Union und der zwischenstaatlichen Abkommen im Bereich der Sozialen Sicherheit gemäß § 30a Abs. 1 Z 26 ASVG - RZSV 2023" abkrvo="RZSV 2023" dokart="RL DVSV" titaen="Richtlinien für die einheitliche Anwendung der Verordnungen der EU und der zwischenstaatlichen Abkommen im Bereich der sozialen Sicherheit 2023 StF" abkaen="RZSV 2023 StF" urheber="DVSV" beschdat="2022-09-21" pubdat="2022-10-03" ikra="2023-01-01" sichtbarkeit="p" gldart="ANH" gldnr="1" gldsort="150">
        <puborgane><puborgan puborg="avsv" nrpuborg="71" jahrgang="2022">avsv   Nr. 71/2022 </puborgan>
          
        </puborgane>
      </metadaten>
      <nutzdaten>
        <abschnitt nr="1" typ="ns" paperf="h" endnhier="true">
          <ueberschrift typ="anlage" halign="r" level="1"><gldsym>Anhang</gldsym> zu den RZSV 2023</ueberschrift>
          <ueberschrift typ="g1" halign="c">Grenzüberschreitende Beitreibung</ueberschrift>
          
        <ueberschrift typ="para" halign="c">Grundsätze der Zuständigkeitsverteilung</ueberschrift>
          <absatz typ="satz" halign="j">Den nachfolgenden Festlegungen für den „zuständigen“ Träger in Österreich für die grenzüberschreitende Beitreibung (<i>ersuchte Partei/bezeichneter Träger</i>) liegen <b>folgende Annahmen</b> zugrunde:</absatz>
          <liste>
            <aufzaehlung ebene="1" art="normal">
              <listelem>
                <symbol stellen="1">-</symbol>Die Zuständigkeit orientiert sich vorrangig am <b>Bestehen eines Versicherungsverhältnisses</b> und ist <b>unabhängig</b> davon, ob ein <b>Geldleistungsbezug</b> vorliegt oder nicht.</listelem>
              <listelem>
                <symbol stellen="1">-</symbol>Sie ist <b>unabhängig</b> von der <b>Form</b> der Ersuchen (Auskunftsverlangen, Zustellung, Beitreibung) und <b>unabhängig</b> davon, ob die Beitreibungsmaßnahmen <b>Beitragsforderungen</b> oder Forderungen in Zusammenhang mit <b>nicht geschuldeten Leistungen</b> betreffen.</listelem>
              <listelem>
                <symbol stellen="1">-</symbol>„Ersuchte Partei“ ist jeweils der <b>Krankenversicherungsträger</b>, der für die Einhebung der Beiträge zuständig ist/wäre. Bei mehreren Versicherungsverhältnissen wird die Zuständigkeit in Anlehnung an <rvolink abkrvo="MKO 2016" verwart="d" typ="e" gldart="PARA" gldsort="50" gldnr="4" abs="1" ursprung="u">§ 4 Abs. 1</rvolink><nolink> MKO</nolink> 2016 (Reihenfolge der Zuständigkeit für die Ausstellung von EKVKs) geregelt.</listelem>
              <listelem>
                <symbol stellen="1">-</symbol>Als einzige Ausnahme gilt: Liegt <b>kein</b> Versicherungsverhältnis und <b>kein</b> Wohnsitz in Österreich vor, aber <b>ein Geldleistungsbezug aus der Pensionsversicherung</b>, dann soll der jeweilige <b>Pensionsversicherungsträger</b> „ersuchte Partei“ sein.</listelem>
              <listelem>
                <symbol stellen="1">-</symbol>Auf die <b>Verjährungsbestimmungen</b> nach <nolink>Art. 83</nolink> Durchführungsverordnung ist hinzuweisen: Die Verjährung bezüglich <b>Forderung und Vollstreckungstitel</b> richtet sich nach den Rechtsvorschriften des Mitgliedstaates der <b>ersuchenden</b><b>Partei</b>, Verjährungsfragen in Bezug auf <b>Vollstreckungsmaßnahmen</b> nach den Rechtsvorschriften im <b>ersuchten Mitgliedstaat</b>.</listelem>
            </aufzaehlung>
          </liste>
          <abstand halign="l"/>
          <table id="Tabelle1" cellspacing="0" style="border-collapse:collapse;margin-left:-6pt;margin-right:-6pt">
            <tr style="height:19.9pt;" h-start="-120">
              <td colspan="3" style="vertical-align:top;border:solid windowtext 0.5pt;padding:0pt 5.4pt 0pt 5.4pt" h-xval="8600">
                <ueberschrift typ="g1" halign="c">Ersuchen um: Auskunftsverlangen, Zustellung, Beitreibung (<nolink>Art. 76</nolink>, <nolink>77</nolink>, <nolink>78</nolink> Durchführungsverordnung)</ueberschrift>
              </td>
            </tr>
            <tr style="height:21.05pt;" h-start="-120">
              <td colspan="3" style="vertical-align:top;border:solid windowtext 0.5pt;padding:0pt 5.4pt 0pt 5.4pt" h-xval="8600">
                <ueberschrift typ="g2" halign="c">
                  <n>Forderungen: Beiträge oder nicht geschuldete Leistungen</n>
                </ueberschrift>
              </td>
            </tr>
            <tr style="height:22.6pt;" h-start="-120">
              <td colspan="3" style="vertical-align:middle;border:solid windowtext 0.5pt;padding:0pt 5.4pt 0pt 5.4pt" h-xval="8600">
                <ueberschrift typ="g2" halign="c">
                  <n>Verjährungsbestimmung: <nolink>Art. 83</nolink> Durchführungsverordnung</n>
                </ueberschrift>
              </td>
            </tr>
            <tr style="height:34.65pt;" h-start="-120">
              <td style="vertical-align:middle;border:solid windowtext 0.5pt;padding:0pt 5.4pt 0pt 5.4pt" h-xval="4225">
                <ueberschrift typ="para" halign="c">Versicherungsverhältnis in Österreich </ueberschrift>
              </td>
              <td colspan="2" style="vertical-align:middle;border:solid windowtext 0.5pt;padding:0pt 5.4pt 0pt 5.4pt" h-xval="8600">
                <ueberschrift typ="para" halign="c">Zuständiger „ersuchter Träger“ in Österreich </ueberschrift>
              </td>
            </tr>
            <tr style="height:34.65pt;" h-start="-120">
              <td style="vertical-align:middle;border:solid windowtext 0.5pt;padding:0pt 5.4pt 0pt 5.4pt" h-xval="4225">
                <absatz typ="tabtext" halign="l">Bestehen <b>eines</b><u>Krankenversicherungsverhältnisses</u> in <br/>Österreich (mit/ohne weitere Zweige)</absatz>
              </td>
              <td colspan="2" style="vertical-align:middle;border:solid windowtext 0.5pt;padding:0pt 5.4pt 0pt 5.4pt" h-xval="8600">
                <absatz typ="tabtext" halign="l">Zuständiger <b>Krankenversicherungsträger</b></absatz>
              </td>
            </tr>
            <tr style="height:35.15pt;" h-start="-120">
              <td style="vertical-align:middle;border:solid windowtext 0.5pt;padding:0pt 5.4pt 0pt 5.4pt" h-xval="4225">
                <absatz typ="tabtext" halign="l">Bestehen von <b>zwei oder mehreren</b><u>Krankenversicherungsverhältnissen</u> in Österreich (mit/ohne weitere Zweige)</absatz>
              </td>
              <td style="vertical-align:middle;border:solid windowtext 0.5pt;padding:0pt 5.4pt 0pt 5.4pt" h-xval="7666">
                <absatz typ="tabtext" halign="l">Ein <b>Krankenversicherungsträger</b>: Zuständigkeit analog von <rvolink abkrvo="MKO 2016" verwart="d" typ="e" gldart="PARA" gldsort="50" gldnr="4" abs="1" ursprung="u">§ 4 Abs. 1</rvolink><nolink> MKO</nolink> 2016</absatz>
              </td>
              <td style="vertical-align:top;border:solid windowtext 0.5pt;padding:0pt 5.4pt 0pt 5.4pt" h-xval="8600">
                <absatz typ="tabtext" halign="l">BVAEB<br/>SVS<br/>ÖGK</absatz>
              </td>
            </tr>
            <tr style="height:62.6pt;" h-start="-120">
              <td style="vertical-align:middle;border:solid windowtext 0.5pt;padding:0pt 5.4pt 0pt 5.4pt" h-xval="4225">
                <absatz typ="tabtext" halign="l">
                  <b>Kein</b>
                  <u>Krankenversicherungsverhältnis</u>, aber:</absatz>
                <absatz typ="tabtext" halign="l">Bestehen einer <u>Teilversicherung</u> in der <u>Unfallversicherung <b>und</b> der Pensionsversicherung</u> nach dem <nolink>ASVG</nolink> bzw. Bestehen einer Teilversicherung in der Unfallversicherung nach <rvolink abkrvo="ASVG" verwart="d" typ="e" gldart="PARA" gldsort="50" gldnr="7" ziff="3" lit="a" ursprung="u">§ 7 Z 3 lit. a</rvolink><nolink> ASVG</nolink> (geringfügig Beschäftigte) (mit/ohne weitere Teilversicherungen)</absatz>
              </td>
              <td colspan="2" style="vertical-align:middle;border:solid windowtext 0.5pt;padding:0pt 5.4pt 0pt 5.4pt" h-xval="8600">
                <absatz typ="tabtext" halign="l">Der für die Beitragseinbringung zuständige <b>Krankenversicherungsträger</b> (jener Krankenversicherungsträger, der bei Bestehen einer Krankenversicherung zuständig wäre) nach dem <nolink>ASVG</nolink></absatz>
              </td>
            </tr>
            <tr style="height:52.5pt;" h-start="-120">
              <td style="vertical-align:middle;border:solid windowtext 0.5pt;padding:0pt 5.4pt 0pt 5.4pt" h-xval="4225">
                <absatz typ="tabtext" halign="l">Bestehen <b>einer</b><u>Teilversicherung</u> in der <u>Pensionsversicherung</u></absatz>
              </td>
              <td colspan="2" style="vertical-align:middle;border:solid windowtext 0.5pt;padding:0pt 5.4pt 0pt 5.4pt" h-xval="8600">
                <absatz typ="tabtext" halign="l">Der <b>Krankenversicherungsträger</b>, der für den Pensionsversicherungsträger die Beiträge einhebt bzw. erhält.</absatz>
                <absatz typ="tabtext" halign="l">(Das ist in der Regel die ÖGK, bei den Sonderversicherungsträgern diese selbst.)</absatz>
              </td>
            </tr>
            <tr style="height:42.6pt;" h-start="-120">
              <td style="vertical-align:middle;border:solid windowtext 0.5pt;padding:0pt 5.4pt 0pt 5.4pt" h-xval="4225">
                <absatz typ="tabtext" halign="l">Bestehen von <b>zwei</b><b>oder</b><b>mehreren</b><u>Teilversicherungen</u> in der <u>Pensionsversicherung</u></absatz>
              </td>
              <td style="vertical-align:middle;border:solid windowtext 0.5pt;padding:0pt 5.4pt 0pt 5.4pt" h-xval="7666">
                <absatz typ="tabtext" halign="l">Ein <b>Krankenversicherungsträger</b>, der für den Pensionsversicherungsträger die Beiträge einhebt bzw. erhält; Reihenfolge in Anlehnung an <rvolink abkrvo="MKO 2016" verwart="d" typ="e" gldart="PARA" gldsort="50" gldnr="4" abs="1" ursprung="u">§ 4 Abs. 1</rvolink><nolink> MKO</nolink> 2016</absatz>
              </td>
              <td style="vertical-align:top;border:solid windowtext 0.5pt;padding:0pt 5.4pt 0pt 5.4pt" h-xval="8600">
                <absatz typ="tabtext" halign="l">BVAEB<br/>SVS<br/>ÖGK</absatz>
              </td>
            </tr>
            <tr style="height:27.6pt;" h-start="-120">
              <td style="vertical-align:middle;border:solid windowtext 0.5pt;padding:0pt 5.4pt 0pt 5.4pt" h-xval="4225">
                <absatz typ="tabtext" halign="l">Bestehen <b>einer</b><u>Teilversicherung</u> in der <u>Unfallversicherung</u></absatz>
              </td>
              <td colspan="2" style="vertical-align:middle;border:solid windowtext 0.5pt;padding:0pt 5.4pt 0pt 5.4pt" h-xval="8600">
                <absatz typ="tabtext" halign="l">Jener <b>Krankenversicherungsträger</b>, der bei Bestehen einer Krankenversicherung für die Beitragseinhebung zuständig wäre</absatz>
              </td>
            </tr>
            <tr style="height:3pt;" h-start="-120">
              <td style="vertical-align:middle;border:solid windowtext 0.5pt;padding:0pt 5.4pt 0pt 5.4pt" h-xval="4225">
                <absatz typ="tabtext" halign="l">Bestehen von <b>zwei oder mehreren</b><u>Teilversicherungen</u> in der <u>Unfallversicherung</u></absatz>
              </td>
              <td style="vertical-align:middle;border:solid windowtext 0.5pt;padding:0pt 5.4pt 0pt 5.4pt" h-xval="7666">
                <absatz typ="tabtext" halign="l">Jener <b>Krankenversicherungsträger</b>, der bei Bestehen einer <br/>Krankenversicherung für die Beitragseinhebung zuständig wäre, Reihenfolge in Anlehnung an <rvolink abkrvo="MKO 2016" verwart="d" typ="e" gldart="PARA" gldsort="50" gldnr="4" abs="1" ursprung="u">§ 4 Abs. 1</rvolink><nolink> MKO</nolink> 2016</absatz>
              </td>
              <td style="vertical-align:top;border:solid windowtext 0.5pt;padding:0pt 5.4pt 0pt 5.4pt" h-xval="8600">
                <absatz typ="tabtext" halign="l">BVAEB<br/>SVS<br/>ÖGK</absatz>
              </td>
            </tr>
            <tr style="height:29.55pt;" h-start="-120">
              <td style="vertical-align:middle;border:solid windowtext 0.5pt;padding:0pt 5.4pt 0pt 5.4pt" h-xval="4225">
                <absatz typ="tabtext" halign="l">
                  <b>Kein aufrechtes</b>
                  <u>Versicherungsverhältnis</u>, <br/><b>aber</b><u>Wohnsitz oder Sitz des Dienstgebers in Österreich</u></absatz>
              </td>
              <td colspan="2" style="vertical-align:middle;border:solid windowtext 0.5pt;padding:0pt 5.4pt 0pt 5.4pt" h-xval="8600">
                <absatz typ="tabtext" halign="l">
                  <b>ÖGK</b>
                </absatz>
              </td>
            </tr>
            <tr style="height:33.95pt;" h-start="-120">
              <td style="vertical-align:middle;border:solid windowtext 0.5pt;padding:0pt 5.4pt 0pt 5.4pt" h-xval="4225">
                <absatz typ="tabtext" halign="l">
                  <b>Kein aufrechtes</b>
                  <u>Versicherungsverhältnis</u>, <b>kein</b> Wohnsitz, <b>aber</b><u>Geldleistungsbezug aus der Pensionsversicherung</u></absatz>
              </td>
              <td colspan="2" style="vertical-align:middle;border:solid windowtext 0.5pt;padding:0pt 5.4pt 0pt 5.4pt" h-xval="8600">
                <absatz typ="tabtext" halign="l">Jener <b>Pensionsversicherungsträger</b>, der gegenüber der betreffenden Person zu Leistungen verpflichtet ist.</absatz>
              </td>
            </tr>
            <tr style="height:34.45pt;" h-start="-120">
              <td style="vertical-align:middle;border:solid windowtext 0.5pt;padding:0pt 5.4pt 0pt 5.4pt" h-xval="4225">
                <absatz typ="tabtext" halign="l">
                  <b>Kein aufrechtes</b>
                  <u>Versicherungsverhältnis</u>, <b>kein</b><u>Wohnsitz</u>, <b>kein</b><u>Geldleistungsbezug</u> aus der <u>Pensionsversicherung</u></absatz>
              </td>
              <td colspan="2" style="vertical-align:middle;border:solid windowtext 0.5pt;padding:0pt 5.4pt 0pt 5.4pt" h-xval="8600">
                <absatz typ="tabtext" halign="l">
                  <b>Keine feststellbare Zuständigkeit</b> der SV.</absatz>
                <absatz typ="tabtext" halign="l">Beitreibungsersuchen ist mangels Anknüpfungspunkt <b>abzulehnen</b>.</absatz>
              </td>
            </tr>
