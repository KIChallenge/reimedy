      <metadaten nichtanzeigen="n" titrvo="Sozialversicherungsabkommen Serbien" abkrvo="AbkSozSi Serbien" dokart="SVAbk" titaen="Abkommen zwischen der Republik Österreich und der Republik Serbien über Soziale Sicherheit StF" abkaen="AbkSozSi Serbien StF" urheber="Bund" beschdat="2012-07-04" pubdat="2012-11-12" ikra="2012-12-01" sichtbarkeit="p" gldart="ART" gldnr="22" gldsort="80">
