      <nutzdaten>
        <abschnitt nr="3" typ="ns" paperf="h" endnhier="true">
          <ueberschrift typ="para" halign="c" level="2">Artikel 17</ueberschrift>
          <absatz typ="abs" halign="j">
            <gldsym>Art. 17</gldsym>
          </absatz>
          <absatz typ="abs" halign="j">Für Angestellte, die im Zeitpunkt des In-Kraft-Tretens dieses Abkommens bei der UNIDO beschäftigt sind und innerhalb von fünf Jahren nach diesem Zeitpunkt aus dem Beschäftigungsverhältnis bei der UNIDO ausscheiden, ist <rvolink ursprung="u" abkrvo="AbkSozSi UNIDO 2010" verwart="d" gldart="ART" gldsort="80" gldnr="7" abs="2" typ="e">Artikel 7 Absatz 2 </rvolink>mit der Maßgabe anzuwenden, dass an Stelle des danach in Betracht kommenden Hundertsatzes ein Hundertsatz von 7 % gilt.</absatz>
        </abschnitt>
      </nutzdaten>
