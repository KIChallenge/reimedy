      <metadaten nichtanzeigen="n" titrvo="Musterkrankenordnung 2016" abkrvo="MKO 2016" dokart="MusterR" titaen="7. Änderung der Musterkrankenordnung 2016" abkaen="7. Änd MKO 2016" urheber="Hauptverband" beschdat="2019-10-22" pubdat="2019-12-09" ikra="2020-01-01" sichtbarkeit="p" gldart="PARA" gldnr="68" gldsort="70">
        
