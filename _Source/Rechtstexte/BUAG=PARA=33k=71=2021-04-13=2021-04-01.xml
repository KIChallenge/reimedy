<metadaten gldart="PARA" gldsort="70" titrvo="Bauarbeiter-Urlaubs- und Abfertigungsgesetz" abkrvo="BUAG" dokart="BG" titaen="Aprilnovelle 71/2021" abkaen="AprilNov 71/2021" urheber="Bund" pubdat="2021-04-13" ikra="2021-04-01" sichtbarkeit="p" gldnr="33k" beschdat="2021-03-25" nichtanzeigen="n">


