              <td colspan="2" style="vertical-align:top;padding:0pt 3.5pt 0pt 3.5pt" h-xval="8455">
                <absatz typ="tabtext" halign="l">Ärztliche Hilfe und gleichgestellte Leistungen (<rvolink abkrvo="KrankenO BVAEB 2026" verwart="d" typ="e" gldart="PARA" gldsort="50" gldnr="14" bereich="BIS" bis="19" ursprung="u">§§ 14 bis 19</rvolink>)</absatz>
              </td>
            </tr>
