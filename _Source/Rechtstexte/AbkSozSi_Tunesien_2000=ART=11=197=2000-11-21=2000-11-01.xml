<ueberschrift level="4" halign="c" typ="para">Träger des Wohnortes</ueberschrift>
<absatz typ="abs" halign="j">Die nach Artikel 10 Absatz 2 in Betracht kommenden Sachleistungen werden gewährt</absatz>
<absatz typ="satz" halign="j">in Österreich</absatz>
<absatz typ="satz" halign="j">von der für den Wohnort der betreffenden Person in Betracht kommenden Gebietskrankenkasse,</absatz>
<absatz typ="satz" halign="j">in Tunesien</absatz>
<absatz typ="satz" halign="j">von der Staatlichen Kasse für soziale Sicherheit.</absatz>
</abschnitt>
