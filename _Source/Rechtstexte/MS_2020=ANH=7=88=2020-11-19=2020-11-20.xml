                <symbol stellen="2">a)</symbol>… …</listelem>
              <listelem>
                <symbol stellen="2">b)</symbol>… …</listelem>
              <listelem>
                <symbol stellen="2">c)</symbol>… …</listelem>
            </literaliste>
          </liste>
