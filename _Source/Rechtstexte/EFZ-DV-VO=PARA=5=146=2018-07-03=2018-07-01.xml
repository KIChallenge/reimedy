      <nutzdaten>
        <abschnitt nr="1" typ="ns" paperf="h" endnhier="true">
          <ueberschrift typ="para" halign="c" level="1">Höhe der Zuschüsse für Unternehmen, in denen durchschnittlich nicht mehr als zehn Dienstnehmer/innen beschäftigt werden</ueberschrift>
          <absatz typ="abs" halign="j">
            <gldsym>§ 5.</gldsym> Für Unternehmen nach <rvolink abkrvo="EFZ-DV-VO" verwart="d" typ="e" gldart="PARA" gldsort="80" gldnr="2" abs="3" ursprung="u">§ 2 Abs. 3</rvolink> ist <rvolink abkrvo="EFZ-DV-VO" verwart="d" typ="e" gldart="PARA" gldsort="80" gldnr="4" ursprung="u">§ 4</rvolink> mit der Maßgabe anzuwenden, dass die Zuschüsse nach <rvolink abkrvo="ASVG" verwart="d" typ="e" gldart="PARA" gldsort="80" gldnr="53b" abs="2" ziff="3" ursprung="u">§ 53b Abs. 2 Z 3</rvolink><nolink> ASVG</nolink> 75% zuzüglich eines Zuschlages für die Sonderzahlungen in der Höhe von 12,51% des jeweils tatsächlich fortgezahlten Entgelts (mit Ausnahme der Sonderzahlungen) betragen.</absatz>
        </abschnitt>
