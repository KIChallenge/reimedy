<metadaten titrvo="Allgemeines Pensionsgesetz" abkrvo="APG" dokart="BG" titaen="Oktobernovelle 145/2024" abkaen="OktoberNov 145/2024" urheber="Bund" beschdat="2024-09-18" pubdat="2024-10-09" ikra="2024-10-10" sichtbarkeit="p" gldart="PARA" gldnr="37" gldsort="70" berkz="KVL; UVL; PVL; VMB; PFLEGE; ALLE; OV; REGR; VPAR; KA; RSP; AN; AG; SELB; BEA; " nichtanzeigen="n">


