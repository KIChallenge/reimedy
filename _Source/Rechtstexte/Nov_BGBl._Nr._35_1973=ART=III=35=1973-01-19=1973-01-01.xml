<abschnitt nr="1" typ="ns" paperf="h" endnhier="true">
          <ueberschrift typ="para" halign="c" widowctrl="1" keepwithnext="0" level="1">Artikel III <br/>Wirksamkeitsbeginn</ueberschrift><absatz typ="abs"><gldsym>Art. III</gldsym></absatz>
        
          
          
          
          <absatz typ="abs" halign="j">(1) Dieses Bundesgesetz tritt, soweit im folgenden nichts anderes bestimmt wird, am 1. Jänner 1973 in Kraft.</absatz>
          <absatz typ="abs" halign="j">(2) Es treten in Kraft</absatz>
          <liste>
            <literaliste ebene="1">
              <listelem>
                <symbol stellen="2">a)</symbol>rückwirkend mit 1. Jänner 1972 die Bestimmungen des Art. I Z 6 lit. a und b, 13 und 47 lit. a;</listelem>
              <listelem>
                <symbol stellen="2">b)</symbol>mit 1. Juli 1973 die Bestimmungen des Art. I Z 6 lit. c, 9 lit. a und 10 lit. b;</listelem>
              <listelem>
                <symbol stellen="2">c)</symbol>mit 1. Jänner 1974 die Bestimmungen des Art. I Z 24, 26, 30, 54 und 57 lit. a sowie § 52 Abs. 1 Z 1 des Beamten-Kranken- und Unfallversicherungsgesetzes in der Fassung des Art. I Z 25;</listelem>
              <listelem>
                <symbol stellen="2">d)</symbol>mit 1. Juli 1977 die Bestimmungen des Art. I Z 7.</listelem>
            </literaliste>
          </liste></abschnitt></nutzdaten>
