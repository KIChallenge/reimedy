<abschnitt>
<ueberschrift level="2" halign="c" typ="para">GLIEDERUNG DER ERFOLGSRECHNUNG</ueberschrift>
<absatz typ="abs" halign="j">
<gldsym>§ 72.</gldsym> (1) In der Erfolgsrechnung nach dem <nolink>Bundespflegegeldgesetz</nolink> sind folgende Posten gesondert auszuweisen:</absatz>
<absatz typ="satz" halign="j">ERTRÄGE</absatz>
          <liste>
            <ziffernliste ebene="1">
              <listelem>
                <symbol stellen="2">1.</symbol>Ersatzleistung des Bundes;</listelem>
              <listelem>
                <symbol stellen="3">1a.</symbol>Ersatzleistung der AUVA;</listelem>
              <listelem>
                <symbol stellen="3">1b.</symbol>Selbstbehalt der ÖBB gem. <rvolink ursprung="u" abkrvo="BPGG" verwart="d" gldart="PARA" gldsort="70" gldnr="23" abs="3" typ="e">§ 23 Abs. 3</rvolink> BPGG;</listelem>
              <listelem>
                <symbol stellen="2">2.</symbol>Ersätze für Leistungsaufwendungen;</listelem>
              <listelem>
                <symbol stellen="2">3.</symbol>sonstige betriebliche Erträge.</listelem>
            </ziffernliste>
          </liste>
          <absatz typ="satz" halign="j">AUFWENDUNGEN</absatz>
          <liste>
            <ziffernliste ebene="1">
              <listelem>
                <symbol stellen="2">1.</symbol>Pflegegeld;</listelem>
              <listelem><symbol stellen="3">2.</symbol>Angehörigenbonus gemäß <rvolink abkrvo="BPGG" verwart="d" typ="e" gldart="PARA" gldsort="50" gldnr="21g" ursprung="u">§§ 21g</rvolink> und <rvolink abkrvo="BPGG" verwart="d" typ="e" gldart="PARA" gldsort="50" gldnr="21h" ursprung="u">21h</rvolink><nolink> BPGG</nolink>;</listelem><listelem>
                <symbol stellen="2">3.</symbol>Sachleistungen;</listelem>
              <listelem>
                <symbol stellen="2">4.</symbol>Fahrtspesen und Transportkosten;</listelem>
              <listelem>
                <symbol stellen="2">5.</symbol>Sozialgerichtskosten;</listelem><listelem>
                <symbol stellen="2">6.</symbol>vertrauensärztlicher Dienst und sonstige Betreuung;</listelem>
              <listelem>
                <symbol stellen="2">7.</symbol>Verwaltungsaufwand;</listelem>
              <listelem>
                <symbol stellen="2">8.</symbol>sonstige betriebliche Aufwendungen.</listelem>
            </ziffernliste>
          </liste>
          <absatz typ="satz" halign="j">Die Träger der Unfallversicherung, in ihrem nach <rvolink ursprung="u" abkrvo="RechnVorschr SV" verwart="d" gldart="PARA" gldsort="70" gldnr="70" abs="1" typ="e">§ 70 Abs. 1 </rvolink>RV übernommenen Aufgabenbereich, haben die aufgrund akausaler Behinderungen erbrachten Aufwendungen nach der obigen Gliederung in einem Beiblatt zur Erfolgsrechnung gesondert darzustellen.</absatz>
<absatz typ="abs" halign="j">(2) In der Erfolgsrechnung nach dem Sonderunterstützungsgesetz sind folgende Posten gesondert auszuweisen:</absatz>
          <absatz typ="satz" halign="j">ERTRÄGE</absatz>
          <liste>
            <ziffernliste ebene="1">
              <listelem>
                <symbol stellen="2">1.</symbol>Ersatzleistung des Bundes;</listelem>
              <listelem>
                <symbol stellen="2">2.</symbol>sonstige betriebliche Erträge;</listelem>
              <listelem>
                <symbol stellen="2">3.</symbol>Deckung des Fehlbetrages für Verwaltungsaufwendungen aus der</listelem>
            </ziffernliste>
            <schluss typ="Abs">Pensionsversicherung.</schluss>
          </liste>
          <absatz typ="satz" halign="j">AUFWENDUNGEN</absatz>
          <liste>
            <ziffernliste ebene="1">
              <listelem>
                <symbol stellen="2">1.</symbol>Sonderunterstützung;</listelem>
              <listelem>
                <symbol stellen="2">2.</symbol>Beiträge zur Krankenversicherung der SU-Bezieher;</listelem>
              <listelem>
                <symbol stellen="2">3.</symbol>Verwaltungsaufwand;</listelem>
              <listelem>
                <symbol stellen="2">4.</symbol>Abschreibungen;</listelem>
              <listelem>
                <symbol stellen="2">5.</symbol>sonstige betriebliche Aufwendungen.</listelem>
            </ziffernliste>
          </liste>
