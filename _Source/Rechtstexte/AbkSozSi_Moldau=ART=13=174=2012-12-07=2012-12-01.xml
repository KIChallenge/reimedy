      <metadaten titrvo="Sozialversicherungsabkommen Moldau" abkrvo="AbkSozSi Moldau" dokart="SVAbk" urheber="Bund" beschdat="2011-10-20" pubdat="2012-12-07" ikra="2012-12-01" sichtbarkeit="p" nichtanzeigen="n" titaen="Abkommen zwischen der Republik Österreich und der Republik Moldau über soziale Sicherheit StF" abkaen="AbkSozSi Moldau StF" gldart="ART" gldnr="13" gldsort="80">
        <schlagw>
          <textelem>Moldau</textelem></schlagw><puborgane>
          <puborgan puborg="BGBl." gldpuborg="III" nrpuborg="174" jahrgang="2012">BGBl. III  Nr. 174/2012 </puborgan>
        </puborgane>
