<abschnitt nr="1" typ="f" paperf="h" endnhier="true">
<ueberschrift typ="art" halign="c" level="3">Artikel 41 <br/>Besondere Durchführungsvorschriften</ueberschrift>
<absatz typ="abs" halign="j" widowctrl="1" keepwithnext="0">
<gldsym>Art. 41</gldsym></absatz><absatz typ="abs" halign="j">(1) Im Hinblick auf die in <rvolink abkrvo="EG-Koord-DurchfV 987/2009" verwart="d" typ="e" gldart="ANH" gldsort="140" gldnr="2" ursprung="u">Anhang 2</rvolink> genannten Mitgliedstaaten gelten die Vorschriften des Titels III Kapitel 2 der Grundverordnung, die sich auf Sachleistungen beziehen, für Personen, die ausschließlich aufgrund eines Sondersystems für Beamte Anspruch auf Sachleistungen haben, nur in dem dort genannten Umfang.</absatz>
<absatz typ="abs" halign="j">(2) Artikel 32 Absatz 2 Unterabsatz 2 und Artikel 32 Absatz 3 der Durchführungsverordnung gilt entsprechend.</absatz>

</abschnitt>
