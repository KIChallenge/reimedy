<ueberschrift widowctrl="1" keepwithnext="1" halign="c" level="1" typ="g1">ABSCHNITT III 
<br/>BESONDERE BESTIMMUNGEN</ueberschrift>
<ueberschrift widowctrl="1" keepwithnext="1" halign="c" level="2" typ="g2">Kapitel 1 
<br/>Krankheit und Mutterschaft</ueberschrift>
<ueberschrift widowctrl="1" keepwithnext="1" halign="c" level="3" typ="para">Zusammenrechnung der Versicherungszeiten</ueberschrift>
<absatz typ="satz" widowctrl="1" keepwithnext="0" halign="j">
<gldsym>Artikel 10</gldsym>
</absatz>
<absatz typ="abs" widowctrl="1" keepwithnext="0" halign="j">Hat eine Person nach den Rechtsvorschriften beider Vertragsstaaten Versicherungszeiten erworben, so sind diese für den Erwerb eines Leistungsanspruches und die Dauer der Leistungsgewährung zusammenzurechnen, soweit sie nicht auf dieselbe Zeit entfallen.</absatz>
</abschnitt>
