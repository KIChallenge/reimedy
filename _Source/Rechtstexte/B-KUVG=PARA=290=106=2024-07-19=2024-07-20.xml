<abschnitt nr="1" typ="ns" paperf="h" endnhier="true">
          
          
          
        <ueberschrift typ="para" halign="c" level="3">Schlussbestimmungen zu Art. 4 des Bundesgesetzes BGBl. I Nr. 106/2024 (44. Novelle)</ueberschrift>
          <absatz typ="abs" halign="j">
            <gldsym>§ 290.</gldsym> (1) Es treten in der Fassung des Bundesgesetzes BGBl. I Nr. 106/2024 in Kraft:</absatz>
          
          
          
          
          
          
          
          
          
          
          <liste>
            <aufzaehlung ebene="1" art="normal">
              <listelem>
                <symbol stellen="2">1.</symbol>mit dem der Kundmachung folgenden Tag die §§ 3 Z 3, 52 Z 3 lit. a, 64 Abs. 2 letzter Satz, 68 Abs. 3, 76 samt Überschrift, 114 Abs. 1, 114a letzter Satz, 140 samt Überschrift, 153 Abs. 2a und 154 Abs. 1a;</listelem>
              <listelem>
                <symbol stellen="2">2.</symbol>rückwirkend mit 14. Oktober 2023 § 139 Abs. 2a;</listelem>
              <listelem>
                <symbol stellen="2">3.</symbol>rückwirkend mit 1. Jänner 2020 die §§ 1 Abs. 1 Z 6, 2 Abs. 1 Z 4 und 26a Abs. 2 Z 1.</listelem>
            </aufzaehlung>
          </liste>
          <absatz typ="abs" halign="j">(2) § 153 Abs. 3 tritt mit Ablauf des Tages der Kundmachung außer Kraft.</absatz></abschnitt>
