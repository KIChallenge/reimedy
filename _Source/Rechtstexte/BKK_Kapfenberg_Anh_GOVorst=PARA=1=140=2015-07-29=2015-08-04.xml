      <nutzdaten>
        <abschnitt endnhier="true" nr="1" paperf="h" typ="ns">
          <ueberschrift halign="c" typ="para" level="1">§ 1 <br/>Delegierungsbeschlüsse des Vorstandes</ueberschrift>
          
          <absatz halign="j" typ="abs">Dieser Anhang enthält Zeitpunkt und Wortlaut aller Beschlüsse des Vorstandes der Betriebskrankenkasse Kapfenberg mit denen gemäß <rvolink abkrvo="ASVG" verwart="d" typ="e" gldart="PARA" gldsort="70" gldnr="434" abs="1" ursprung="u">§ 434 Abs. 1</rvolink><nolink> ASVG</nolink></absatz>
          <liste>
            <ziffernliste ebene="1">
              <listelem>
                <symbol stellen="2">1.</symbol>einzelne Obliegenheiten</listelem>
              <listelem>
                <symbol stellen="1">-</symbol>dem Obmann</listelem>
              <listelem>
                <symbol stellen="2">2.</symbol>bestimmte laufende Angelegenheiten</listelem>
              <listelem>
                <symbol stellen="1">-</symbol>dem Büro</listelem>
            </ziffernliste>
          </liste>
          <absatz halign="j" typ="abs">übertragen werden. Die Zuständigkeit des Vorstandes in Angelegenheiten des <rvolink abkrvo="ASVG" verwart="d" typ="e" gldart="PARA" gldsort="70" gldnr="437" abs="1" ursprung="u">§ 437 Abs. 1</rvolink><nolink> ASVG</nolink>, die der Zustimmung der Kontrollversammlung bedürfen, wird durch den Anhang zur Geschäftsordnung des Vorstandes nicht berührt.</absatz>
        </abschnitt>
      </nutzdaten>
