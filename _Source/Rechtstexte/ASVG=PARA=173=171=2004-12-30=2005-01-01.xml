<metadaten pubdat="2004-12-30" abkaen="3. SVÄG 2004" dokart="BG" titaen="3. Sozialversicherungs-ÄnderungsG 2004 - 63. Novelle" abkrvo="ASVG" sichtbarkeit="p" ikra="2005-01-01" fassung="48" gldnr="173" titrvo="Allgemeines Sozialversicherungsgesetz" urheber="Bund" beschdat="2004-12-10" berkz="KVL; UVL; PVL; VMB; OV; REGR; VPAR; KA; AN; AG; SELB; " gldart="PARA" indbr="66.01.01" gldsort="70" nichtanzeigen="n">

