      <nutzdaten>
        <abschnitt nr="1" typ="ns" paperf="h" endnhier="true">
          <ueberschrift typ="para" halign="c" level="2">Leistungen vor dem 1. Jänner 2003</ueberschrift>
          <absatz typ="abs" halign="j">
            <gldsym>§ 83.</gldsym> Leistungen, deren Stichtag vor dem 1. Jänner 2003 liegt, werden folgendermaßen weiter gewährt:</absatz>
          <liste>
            <aufzaehlung ebene="1" art="normal">
              <listelem>
                <symbol stellen="2">1.</symbol>Ruhegenüsse wegen Erreichung der Altersgrenze sowie vorzeitige Ruhegenüsse wegen Erreichung der Altersgrenze bei langer Versicherungsdauer als Alterspensionen im Sinne des <rvolink abkrvo="Satzung PI Linz AG 2024" verwart="d" typ="e" gldart="PARA" gldsort="50" gldnr="49" ursprung="u">§ 49</rvolink>,</listelem>
              <listelem>
                <symbol stellen="2">2.</symbol>vorzeitige Ruhegenüsse wegen geminderter Arbeitsfähigkeit sowie Ruhegenüsse wegen Dienstunfähigkeit als Berufsunfähigkeitspensionen im Sinne des <rvolink abkrvo="Satzung PI Linz AG 2024" verwart="d" typ="e" gldart="PARA" gldsort="50" gldnr="51" ursprung="u">§ 51</rvolink> und</listelem>
              <listelem>
                <symbol stellen="2">3.</symbol>Hinterbliebenenpensionen als Witwen(Witwer)pensionen im Sinne des <rvolink abkrvo="Satzung PI Linz AG 2024" verwart="d" typ="e" gldart="PARA" gldsort="50" gldnr="53" ursprung="u">§ 53</rvolink> bzw. Waisenpensionen im Sinne des <rvolink abkrvo="Satzung PI Linz AG 2024" verwart="d" typ="e" gldart="PARA" gldsort="50" gldnr="55" ursprung="u">§ 55</rvolink>.</listelem>
            </aufzaehlung>
          </liste>
        </abschnitt>
