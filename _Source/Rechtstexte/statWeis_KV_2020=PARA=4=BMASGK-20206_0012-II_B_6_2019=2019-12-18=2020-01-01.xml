      <nutzdaten>
        <abschnitt nr="1" typ="ns" paperf="h" endnhier="true">
          <ueberschrift typ="para" halign="c" level="2">Leistungsstatistik</ueberschrift>
          <absatz typ="abs" halign="j">
            <gldsym>§ 4.</gldsym> (1) Im Rahmen der Leistungsstatistik sind jene Statistiken zu erstellen, die der Erfassung der Leistungen dienen. Die Leistungsstatistik beinhaltet folgende Gruppen von Statistiken:</absatz>
          <liste>
            <aufzaehlung ebene="1" art="normal">
              <listelem>
                <symbol stellen="2">1.</symbol>Ärztekosten-Statistik (<rvolink abkrvo="statWeis KV 2020" verwart="d" typ="e" gldart="PARA" gldsort="80" gldnr="5" bereich="BIS" bis="11" ursprung="u">§§ 5 bis 11</rvolink>)</listelem>
              <listelem>
                <symbol stellen="2">2.</symbol>Zahnhilfe-Statistik (<rvolink abkrvo="statWeis KV 2020" verwart="d" typ="e" gldart="PARA" gldsort="80" gldnr="12" bereich="BIS" bis="15" ursprung="u">§§ 12 bis 15</rvolink>)</listelem>
              <listelem>
                <symbol stellen="2">3.</symbol>Heilmittel-Heilbehelfe-Statistik (<rvolink abkrvo="statWeis KV 2020" verwart="d" typ="e" gldart="PARA" gldsort="80" gldnr="16" bereich="BIS" bis="18" ursprung="u">§§ 16 bis 18</rvolink>)</listelem>
              <listelem>
                <symbol stellen="2">4.</symbol>Spital-Statistik (<rvolink abkrvo="statWeis KV 2020" verwart="d" typ="e" gldart="PARA" gldsort="80" gldnr="19" ursprung="u">§ 19</rvolink>)</listelem>
              <listelem>
                <symbol stellen="2">5.</symbol>Krankenstands-Statistik (<rvolink abkrvo="statWeis KV 2020" verwart="d" typ="e" gldart="PARA" gldsort="80" gldnr="20" bereich="BIS" bis="27" ursprung="u">§§ 20 bis 27</rvolink>)</listelem>
              <listelem>
                <symbol stellen="2">6.</symbol>Sonstige Statistiken (<rvolink abkrvo="statWeis KV 2020" verwart="d" typ="e" gldart="PARA" gldsort="80" gldnr="28" bereich="BIS" bis="31" ursprung="u">§§ 28 bis 31</rvolink>)</listelem>
            </aufzaehlung>
          </liste>
          <absatz typ="abs" halign="j">(2) Sofern in den Leistungsstatistiken Aufwendungen angeführt sind, hat die Erfassung ohne Umsatzsteuer zu erfolgen.</absatz>
        </abschnitt>
      </nutzdaten>
