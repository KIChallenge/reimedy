      <nutzdaten>
        <abschnitt nr="1" typ="ns" paperf="h" endnhier="true">
          <ueberschrift typ="para" halign="c" level="1">Sprachliche Gleichbehandlung</ueberschrift>
          <absatz typ="abs" halign="j">
            <gldsym>§ 2.</gldsym> Soweit in der angeschlossenen Mustergeschäftsordnung personenbezogene Bezeichnungen nur in männlicher Form angeführt sind, beziehen sie sich auf Frauen und Männer in gleicher Weise. Bei der Anwendung auf bestimmte Personen ist die jeweils geschlechtsspezifische Form zu verwenden.</absatz>
        </abschnitt>
      </nutzdaten>
