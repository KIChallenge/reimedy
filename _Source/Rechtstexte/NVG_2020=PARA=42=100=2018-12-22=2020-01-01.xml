      <nutzdaten>
        <abschnitt nr="1" typ="ns" paperf="h" endnhier="true">
          <ueberschrift typ="para" halign="c" level="3">Versorgungsleistungen</ueberschrift>
          <absatz typ="abs" halign="j">
            <gldsym>§ 42.</gldsym> Als Versorgungsleistungen sind zu gewähren:</absatz>
          <liste>
            <ziffernliste ebene="1">
              <listelem>
                <symbol stellen="2">1.</symbol>aus dem Versorgungsfall des Alters</listelem>
            </ziffernliste>
            <literaliste ebene="2">
              <listelem>
                <symbol stellen="2">a)</symbol>die Alterspension;</listelem>
              <listelem>
                <symbol stellen="2">b)</symbol>die vorzeitige Alterspension;</listelem>
            </literaliste>
            <ziffernliste ebene="1">
              <listelem>
                <symbol stellen="2">2.</symbol>aus dem Versorgungsfall der dauernden Berufsunfähigkeit die Berufsunfähigkeitspension;</listelem>
              <listelem>
                <symbol stellen="2">3.</symbol>aus dem Versorgungsfall der vorübergehenden Berufsunfähigkeit das Berufsunfähigkeitsgeld;</listelem>
              <listelem>
                <symbol stellen="2">4.</symbol>aus dem Versorgungsfall des Todes</listelem>
            </ziffernliste>
            <literaliste ebene="2">
              <listelem>
                <symbol stellen="2">a)</symbol>die Hinterbliebenenpensionen,</listelem>
              <listelem>
                <symbol stellen="2">b)</symbol>die Abfindung,</listelem>
              <listelem>
                <symbol stellen="2">c)</symbol>der Bestattungskostenbeitrag.</listelem>
            </literaliste>
          </liste>
        </abschnitt>
      </nutzdaten>
