<abschnitt nr="1" typ="ns" paperf="h" endnhier="true">
          <ueberschrift typ="para" halign="c" level="1" widowctrl="1">Artikel IV <br/>Inkrafttreten</ueberschrift>
          <absatz typ="abs"><gldsym>Art. IV</gldsym></absatz><absatz typ="abs" halign="j">(1) Dieses Bundesgesetz tritt, soweit im folgenden nichts anderes bestimmt wird, am 1. Jänner 1981 in Kraft.</absatz>
          <absatz typ="abs" halign="j">(2) Es treten in Kraft:</absatz>
          <liste>
            <literaliste ebene="1">
              <listelem>
                <symbol stellen="2">a)</symbol>rückwirkend mit dem 1. Jänner 1980 die Bestimmungen des Art. I Z 6, 7 lit. b, 10, 28 und 29;</listelem>
              <listelem>
                <symbol stellen="2">b)</symbol>mit dem 1. Jänner 1987 die Bestimmungen des Art. I Z 26.</listelem>
            </literaliste>
          </liste>
          
        </abschnitt></nutzdaten>
