<abschnitt>
<ueberschrift widowctrl="1" keepwithnext="0" halign="c" level="3" typ="para">Gesundheitsleistungen für Pensionisten</ueberschrift>
<absatz typ="satz" widowctrl="1" keepwithnext="0" halign="j">
<gldsym>Artikel 14</gldsym>
</absatz>
<absatz typ="abs" widowctrl="1" keepwithnext="0" halign="j">Personen, die eine Pension nach den österreichischen Rechtsvorschriften beziehen und in Chile wohnen, können unter denselben Bedingungen wie chilenische Staatsangehörige den chilenischen Gesundheitssystemen beitreten.</absatz>
</abschnitt>
