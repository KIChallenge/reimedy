      <nutzdaten>
        <abschnitt nr="1" typ="ns" paperf="h" endnhier="true">
          <ueberschrift typ="g2" halign="c" level="3">3. Unterabschnitt <br/>Ärztliche Hilfe</ueberschrift>
          <ueberschrift typ="para" halign="c" level="4">Ärztliche Hilfe</ueberschrift>
          <absatz typ="abs" halign="j">
            <gldsym>§ 8.</gldsym> (1) Ärztliche Hilfe wird von der SVS durch</absatz>
          <liste>
            <aufzaehlung ebene="1" art="normal">
              <listelem>
                <symbol stellen="2">1.</symbol>Vertragsärzte</listelem>
              <listelem>
                <symbol stellen="2">2.</symbol>Vertrags-Gruppenpraxen</listelem>
              <listelem>
                <symbol stellen="2">3.</symbol>Vertragseinrichtungen</listelem>
              <listelem>
                <symbol stellen="2">4.</symbol>Eigene Einrichtungen (z. B. Ambulatorien)</listelem>
              <listelem>
                <symbol stellen="2">5.</symbol>Wahlärzte</listelem>
              <listelem>
                <symbol stellen="2">6.</symbol>Wahl-Gruppenpraxen</listelem>
              <listelem>
                <symbol stellen="2">7.</symbol>Wahleinrichtungen</listelem>
            </aufzaehlung>
          </liste>
          <absatz typ="abs" halign="j">geleistet, soweit sie ausreichend und zweckmäßig ist sowie das Maß des Notwendigen nicht überschreitet. </absatz>
          <absatz typ="abs" halign="j">Wahlarzt ist jeder freiberuflich tätige Arzt, Wahl-Gruppenpraxis jede Gruppenpraxis und Wahleinrichtung eine behördlich bewilligte Einrichtung, der bzw. die mit der SVS keinen Vertrag über die Sachleistungsverrechnung abgeschlossen hat.</absatz>
          <absatz typ="abs" halign="j">(2) Ärztliche Hilfe als Sachleistung wird</absatz>
          <liste>
            <aufzaehlung ebene="1" art="normal">
              <listelem>
                <symbol stellen="2">1.</symbol>bei einem Vertragsarzt,</listelem>
              <listelem>
                <symbol stellen="2">2.</symbol>bei einer Vertrags-Gruppenpraxis,</listelem>
              <listelem>
                <symbol stellen="2">3.</symbol>bei einer Vertragseinrichtung, oder</listelem>
              <listelem>
                <symbol stellen="2">4.</symbol>in einer eigenen Einrichtung</listelem>
            </aufzaehlung>
          </liste>
          <absatz typ="abs" halign="j">durch direkte Verrechnung der erbrachten Leistung zwischen dem Vertragspartner (eigener Einrichtung) und der SVS erbracht.</absatz>
          <absatz typ="abs" halign="j">(3) Bei nicht als Sachleistung in Anspruch genommener ärztlicher Hilfe werden die Kosten nach den Bestimmungen von Teil 1, 2. Abschnitt, 16. Unterabschnitt vergütet.</absatz>
        </abschnitt>
      </nutzdaten>
