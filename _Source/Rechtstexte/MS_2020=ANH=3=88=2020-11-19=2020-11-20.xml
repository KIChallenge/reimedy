              <listelem>
                <symbol stellen="2">4.</symbol>Obere Platte, Dehnplatte, Aktivator, Kunststoffplattenschienung (bei Frakturen, Abdeckplatte bei LKG-Spalten)</listelem>
              <listelem>
                <symbol stellen="2">5.</symbol>Kappenschiene, gegossene Greiferschiene</listelem>
