      <nutzdaten>
        <abschnitt nr="1" typ="ns" paperf="h" endnhier="true">
          <ueberschrift typ="para" halign="c" level="2">Heilverfahren in Kuranstalten</ueberschrift>
          <absatz typ="abs" halign="j">
            <gldsym>§ 10.</gldsym>       Kuraufenthalte (Heilverfahren in Kuranstalten) können erbracht werden</absatz>
          <liste>
            <aufzaehlung ebene="2" art="normal">
              <listelem>
                <symbol stellen="2">1.</symbol>durch Unterbringung in den Gesundheitseinrichtungen der Österreichischen Gesundheitskasse (Kostenübernahme);</listelem>
              <listelem>
                <symbol stellen="2">2.</symbol>durch Unterbringung in Vertragseinrichtungen (Kostenübernahme);</listelem>
              <listelem>
                <symbol stellen="2">3.</symbol>durch Unterbringung in Einrichtungen anderer Versicherungsträger (Kostenübernahme);</listelem>
              <listelem>
                <symbol stellen="2">4.</symbol>durch Kurkostenzuschüsse zu einem Heilverfahren für Kinder und Jugendliche bis zur Vollendung des 18. Lebensjahres sowie für gleichgestellte Personen gemäß <rvolink abkrvo="RFG 2020" verwart="d" typ="e" gldart="PARA" gldsort="50" gldnr="20" ursprung="u">§ 20</rvolink>;</listelem>
              <listelem>
                <symbol stellen="2">5.</symbol>durch einen pauschalierten Eltern-Kind-Kurkostenzuschuss (<rvolink abkrvo="RFG 2020" verwart="d" typ="e" gldart="PARA" gldsort="50" gldnr="13" ursprung="u">§ 13</rvolink>).</listelem>
            </aufzaehlung>
          </liste>
        </abschnitt>
      </nutzdaten>
