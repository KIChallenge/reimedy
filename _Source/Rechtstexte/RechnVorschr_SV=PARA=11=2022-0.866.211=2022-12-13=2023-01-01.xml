<nutzdaten>
<abschnitt>
<ueberschrift level="3" halign="c" typ="para">GLIEDERUNG DER ABRECHNUNG FÜR EIGENE EINRICHTUNGEN</ueberschrift>
<absatz typ="abs" halign="j">
<gldsym>§ 11.</gldsym> Die Abrechnungen für Einrichtungen mit ambulanter Behandlung (Ambulatorien, Kuranstalten, physikalische Ambulanzen und dgl.) bzw. mit stationärer Behandlung (Heil-[Kur]anstalten, Erholungs- und Genesungsheime) und gemischter Behandlung (Krankenanstalten, Entbindungsheime) sowie für sonstige Einrichtungen haben folgende Gliederung aufzuweisen (Vordruck A/A-H):</absatz>
<liste>
<ziffernliste ebene="1">
<listelem>
<symbol>I.</symbol>Auf der Seite der Aufwendungen:</listelem>
</ziffernliste>
</liste>
<liste>
<ziffernliste ebene="2">
<listelem>
<symbol>1.</symbol>Personalaufwand:</listelem>
</ziffernliste>
</liste>
<liste>
<literaliste ebene="3">
<listelem>
<symbol>a)</symbol>Bezüge des Verwaltungspersonals,</listelem>
<listelem>
<symbol>b)</symbol>Bezüge der Ärzte, Dentisten und Pharmazeuten,</listelem>
<listelem>
<symbol>c)</symbol>Bezüge des Pflege- und ärztlichen Hilfspersonals,</listelem>
<listelem>
<symbol>d)</symbol>Bezüge des Haus- und sonstigen Personals,</listelem>
<listelem>
<symbol>e)</symbol>Entschädigungen für Mehrarbeiten,</listelem>

<listelem>
<symbol>f)</symbol>Pensionen (inkl. DG-Beiträge für Pensionskassen),</listelem>
<listelem>
<symbol>g)</symbol>Abfertigungen, Beiträge für Mitarbeitervorsorgekassen und Sterbegelder,</listelem>
<listelem>
<symbol>h)</symbol>gesetzliche Lohn- und Gehaltsabgaben,</listelem>
<listelem>
<symbol>i)</symbol>sonstiger;</listelem>
</literaliste>
</liste>
<liste>
<ziffernliste ebene="2">
<listelem>
<symbol>2.</symbol>Sachaufwand:</listelem>
</ziffernliste>
</liste>
<liste>
<literaliste ebene="3">
<listelem>
<symbol>a)</symbol>Miete und Hausaufwendungen,</listelem>
<listelem>
<symbol>b)</symbol>Reinigungsaufwand,</listelem>
<listelem>
<symbol>c)</symbol>Energieaufwand,</listelem>
<listelem>
<symbol>d)</symbol>Inventarinstandhaltung,</listelem>
<listelem>
<symbol>e)</symbol>Büroaufwand,</listelem>
<listelem>
<symbol>f)</symbol>Nachrichtenaufwand,</listelem>
<listelem>
<symbol>g)</symbol>Fahrt- und Reiseaufwand,</listelem>
<listelem>
<symbol>h)</symbol>Aufwand für Fahrzeuge,</listelem>
<listelem>
<symbol>i)</symbol>laufende Nachschaffungen,</listelem>
<listelem>
<symbol>j)</symbol>EDV-Aufwand,  <i>(Anm.: 54. Erg. ÜB: gilt ab der Erstellung des Rechnungsabschlusses 2022)</i>,</listelem>
<listelem>
<symbol>k)</symbol>sonstiger,</listelem>
<listelem>
<symbol>l)</symbol>nicht abziehbare Vorsteuer;</listelem>
</literaliste>
</liste>
<liste>
<ziffernliste ebene="2">
<listelem>
<symbol>3.</symbol>Medizinischer Aufwand und Verpflegung:</listelem>
</ziffernliste>
</liste>
<liste>
<literaliste ebene="3">
<listelem>
<symbol>a)</symbol>Ärztehonorare,</listelem>
<listelem>
<symbol>b)</symbol>Untersuchungs- und Behandlungsmaterial, Heilmittel,</listelem>
<listelem>
<symbol>c)</symbol>Bäder, Trinkkuren, Kurtaxen,</listelem>
<listelem>
<symbol>d)</symbol>Verpflegung,</listelem>
<listelem>
<symbol>e)</symbol>sonstiger,</listelem>
<listelem>
<symbol>f)</symbol>nicht abziehbare Vorsteuer;</listelem>
</literaliste>
</liste>
<liste>
<ziffernliste ebene="2">
<listelem>
<symbol>4.</symbol>Überleitung in die Erfolgsrechnung:</listelem>
</ziffernliste>
<literaliste ebene="3">
<listelem>
<symbol>a)</symbol>Kostenbeteiligungen (Kontengruppe 38; Erträge Position 1b).</listelem>
</literaliste>
</liste>
<liste>
<ziffernliste ebene="1">
<listelem>
<symbol>II.</symbol>Auf der Seite der Erträge:</listelem>
</ziffernliste>
</liste>
<liste>
<ziffernliste ebene="2">
<listelem>
<symbol>1.</symbol>Kostenbeiträge und Kostenersätze:</listelem>
</ziffernliste>
</liste>
<liste>
<literaliste ebene="3">
<listelem>
<symbol>a)</symbol>von Sozialversicherungsträgern,</listelem>
<listelem>
<symbol>b)</symbol>von eigenen Versicherten und deren Angehörigen,</listelem>
<listelem>
<symbol>c)</symbol>von Selbstzahlern,</listelem>
<listelem>
<symbol>d)</symbol>sonstiger Art.</listelem>
</literaliste>
</liste>
<liste>
<ziffernliste ebene="2">
<listelem>
<symbol>2.</symbol>Pensionsbeiträge der Bediensteten und Sicherungsbeiträge für Pensionen;</listelem>
<listelem>
<symbol>3.</symbol>Beihilfe für nicht abziehbare Vorsteuer;</listelem>
<listelem>
<symbol>4.</symbol>sonstige Erträge;</listelem>
<listelem>
<symbol>5.</symbol>Überleitung in die Erfolgsrechnung:</listelem>
</ziffernliste>
</liste>
<liste>
<literaliste ebene="3">
<listelem>
<symbol>a)</symbol>ärztliche Hilfe und gleichgestellte Leistungen,</listelem>
<listelem>
<symbol>b)</symbol>Zahnbehandlung,</listelem>
<listelem>
<symbol>c)</symbol>Zahnersatz,</listelem>
<listelem>
<symbol>d)</symbol>Anstaltspflege,</listelem>
<listelem>
<symbol>e)</symbol>Mutterschaftsleistungen,</listelem>
<listelem>
<symbol>f)</symbol>Gesundheitsfestigung und Krankheitsverhütung,</listelem>
<listelem>
<symbol>g)</symbol>Früherkennung von Krankheiten und Gesundheitsförderung,</listelem>
<listelem>
<symbol>h)</symbol>ambulante Unfallheilbehandlung,</listelem>
<listelem>
<symbol>i)</symbol>stationäre Unfallheilbehandlung,</listelem>
<listelem>
<symbol>j)</symbol>Gesundheitsvorsorge,</listelem>
<listelem>
<symbol>k)</symbol>Rehabilitation,</listelem>
<listelem>
<symbol>l)</symbol>Unfallverhütung.</listelem>
</literaliste>
</liste>
<liste>
<ziffernliste ebene="1">
<listelem>
<symbol>III.</symbol>Auf der Rückseite des Formulars sind anzuführen:</listelem>
</ziffernliste>
<schluss typ="Ziff">Zahl der Verpflegsfälle und Verpflegstage, getrennt nach eigenen und fremden Versicherten, Betriebszeit von - bis, Stand der systemisierten Betten und der Notbetten. Zusätzlich in der Pensionsversicherung die Zahl der Verpflegstage für eigene Versicherte getrennt nach den Leistungen des Abschnittes II Z.5.</schluss>
</liste>
</abschnitt>
