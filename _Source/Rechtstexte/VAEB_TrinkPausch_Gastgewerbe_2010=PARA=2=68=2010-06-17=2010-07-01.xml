				</puborgane></metadaten><nutzdaten><abschnitt endnhier="true" nr="1" paperf="h" typ="ns"><ueberschrift halign="c" typ="para" level="1">Höhe der Trinkgeldpauschalen</ueberschrift>
					<absatz halign="j" typ="abs">
						<gldsym>§ 2.</gldsym> (1) Für DienstnehmerInnen im Portierdienst und das Servicepersonal mit Inkasso beträgt das Trinkgeld pauschal für den Kalendermonat, wobei dieser einheitlich mit 30 Tagen anzunehmen ist:</absatz>
					<liste>
						<betragliste typ="litera">
							<listelem>
								<symbol stellen="2">a)</symbol>Wien:<tab align="r" leader="p" position="333.15"/>€ 37,06</listelem>
							<listelem>
								<symbol stellen="2">b)</symbol> Niederösterreich:<tab align="r" leader="p" position="333.15"/>€ 29,07</listelem>
							<listelem>
								<symbol stellen="2">c)</symbol>Burgenland:<tab align="r" leader="p" position="333.15"/>€ 31,00</listelem>
							<listelem>
								<symbol stellen="2">d)</symbol> Oberösterreich:<tab align="r" leader="p" position="333.15"/>€ 43,60</listelem>
							<listelem>
								<symbol stellen="2">e)</symbol>Salzburg:<tab align="r" leader="p" position="333.15"/>€ 43,60</listelem>
							<listelem>
								<symbol stellen="2">f)</symbol>Steiermark:<tab align="r" leader="p" position="333.15"/>€ 43,60</listelem>
							<listelem>
								<symbol stellen="2">g)</symbol>Kärnten:<tab align="r" leader="p" position="333.15"/>€ 43,60</listelem>
							<listelem>
