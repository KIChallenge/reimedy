							<listelem>
								<symbol stellen="2">i)</symbol>Vorarlberg:<tab align="r" leader="p" position="333.15"/>€ 39,24</listelem>
						</betragliste>
					</liste>
					<absatz halign="j" typ="abs">(2) Für Personal lt. (1) ohne Inkasso und Dienstnehmer, die im Zimmerdienst, als PortiergehilfInnen, SchankgehilfInnen, Animateuere und KinderbetreuerInnen beschäftigt werden, beträgt das Trinkgeld pauschal für den Kalendermonat, wobei dieser einheitlich mit 30 Tagen anzunehmen ist:</absatz>
					<liste>
						<betragliste typ="litera">
							<listelem>
								<symbol stellen="2">a)</symbol>Wien:<tab align="r" leader="p" position="333.15"/>€ 15,26</listelem>
							<listelem>
								<symbol stellen="2">b)</symbol> Niederösterreich:<tab align="r" leader="p" position="333.15"/>€ 14,53</listelem>
							<listelem>
								<symbol stellen="2">c)</symbol>Burgenland:<tab align="r" leader="p" position="333.15"/>€ 15,50</listelem>
							<listelem>
								<symbol stellen="2">d)</symbol> Oberösterreich:<tab align="r" leader="p" position="333.15"/>€ 18,17</listelem>
							<listelem>
								<symbol stellen="2">e)</symbol>Salzburg:<tab align="r" leader="p" position="333.15"/>€ 17,44</listelem>
							<listelem>
								<symbol stellen="2">f)</symbol>Steiermark:<tab align="r" leader="p" position="333.15"/>€ 21,80</listelem>
							<listelem>
