<abschnitt nr="1" typ="ns" paperf="h" endnhier="true">
          <ueberschrift typ="para" halign="c" widowctrl="1" keepwithnext="0" level="1">Artikel X <br/>Inkrafttreten</ueberschrift><absatz typ="abs"><gldsym>Art. X </gldsym></absatz>
        <absatz typ="abs" halign="j">(1) Dieses Bundesgesetz tritt, soweit im folgenden nichts anderes bestimmt wird, am 1. Jänner 1983 in Kraft.</absatz>
          <absatz typ="abs" halign="j">(2) Es treten in Kraft:</absatz>
          <liste>
            <literaliste ebene="2">
              <listelem>
                <symbol stellen="2">a)</symbol>mit dem Beginn des Beitragszeitraumes Jänner 1983 Art. VIII;</listelem>
              <listelem>
                <symbol stellen="2">b)</symbol>mit dem 1. März 1983 Art. V Z 4;</listelem>
              <listelem>
                <symbol stellen="2">c)</symbol>mit dem 1. Jänner 1984 Art. V Z 1a;</listelem>
              <listelem>
                <symbol stellen="2">d)</symbol>mit dem 1. Jänner 1984 Art. VII Abs. 1 Z 1, 2 und 4.</listelem>
            </literaliste>
          </liste></abschnitt></nutzdaten>
