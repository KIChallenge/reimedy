      <nutzdaten>
        <abschnitt nr="1" typ="ns" paperf="h" endnhier="true">
          <ueberschrift typ="para" halign="c" level="4">Vergütung bei Inanspruchnahme Ärztlicher Hilfe</ueberschrift>
          <absatz typ="abs" halign="j">
            <gldsym>§ 37.</gldsym> (1) Zur Vergütung eingereichte Honorarnoten über ärztliche Behandlungen haben insbesondere folgende Angaben über die erbrachten Leistungen zu enthalten:</absatz>
          <liste>
            <aufzaehlung ebene="1" art="normal">
              <listelem>
                <symbol stellen="2">1.</symbol>die Diagnose und Therapie;</listelem>
              <listelem>
                <symbol stellen="2">2.</symbol>die Zahl der Ordinationen, Visiten, Nachtordinationen, Sonn- und Feiertagsordinationen und bei Sonn- und Feiertagsordinationen sowie Nachtvisiten und Nachtordinationen auch eine entsprechende Begründung;</listelem>
              <listelem>
                <symbol stellen="2">3.</symbol>die Sonderleistungen;</listelem>
              <listelem>
                <symbol stellen="2">4.</symbol>bei Röntgenuntersuchungen die Art und Anzahl der Durchleuchtungen, bei Verwendung von Filmen auch deren Anzahl und Größe;</listelem>
              <listelem>
                <symbol stellen="2">5.</symbol>bei Röntgentherapie der Bestrahlungszeitraum, die Bezeichnung der Bestrahlungsstellen, sowie die Anzahl der Sitzungen pro Stelle;</listelem>
              <listelem>
                <symbol stellen="2">6.</symbol>bei Buckybestrahlungen die Anzahl der Sitzungen;</listelem>
              <listelem>
                <symbol stellen="2">7.</symbol>bei Radiumtherapie die Angabe der Dosis und Dauer der einzelnen Bestrahlungen;</listelem>
              <listelem>
                <symbol stellen="2">8.</symbol>bei Laboruntersuchungen die genaue Art und Anzahl der medizinisch-diagnostischen Untersuchungen;</listelem>
              <listelem>
                <symbol stellen="2">9.</symbol>bei ärztlichen Nachtvisiten und Nachtordinationen ist auch die Uhrzeit anzugeben;</listelem>
              <listelem>
                <symbol stellen="3">10.</symbol>bei Inanspruchnahme einer ärztlichen Gruppenpraxis den Namen und das Fachgebiet des behandelnden Arztes der Gruppenpraxis.</listelem>
            </aufzaehlung>
          </liste>
          <absatz typ="abs" halign="j">(2) Die <rvolink abkrvo="SVS-KrankenO 2024" verwart="d" typ="e" gldart="PARA" gldsort="50" gldnr="8" bereich="BIS" bis="11" ursprung="u">§§ 8 bis 11</rvolink> gelten sinngemäß.</absatz>
        </abschnitt>
      </nutzdaten>
