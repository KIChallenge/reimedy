					<absatz halign="j" typ="abs">
						<gldsym>§ 1.</gldsym> (1) Diese Richtlinien regeln die Befreiung von Zuzahlungen zu</absatz>
					<liste>
						<strichliste ebene="2">
							<listelem>
								<symbol stellen="1">-</symbol>Maßnahmen der Festigung der Gesundheit und</listelem>
