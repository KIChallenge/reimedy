<absatz typ="satz" halign="c">
<b>Delegierungsbeschlüsse des Vorstandes</b>
</absatz>
<absatz typ="abs" widowctrl="1" keepwithnext="0" halign="j">
<gldsym>§ 1. </gldsym>Dieser Anhang enthält Zeitpunkt und Wortlaut aller Beschlüsse des Vorstandes der (Name des Versicherungsträgers), mit denen nach § ...</absatz>
<liste>
<ziffernliste ebene="1">
<listelem>
<symbol stellen="2">1.</symbol>einzelne Vorstandsobliegenheiten</listelem>
</ziffernliste>
<strichliste ebene="2">
<listelem>
<symbol stellen="1">-</symbol>Ausschüssen aus Mitgliedern der Generalversammlung</listelem>
<listelem>
<symbol stellen="1">-</symbol>dem Obmann</listelem>
<listelem>
<symbol stellen="1">-</symbol>einem Landesstellenausschuss</listelem>
<listelem>
<symbol stellen="1">-</symbol>dem Vorsitzenden eines Landesstellenausschusses oder</listelem>
</strichliste>
<ziffernliste ebene="1">
<listelem>
<symbol stellen="2">2.</symbol>bestimmte laufende Angelegenheiten</listelem>
</ziffernliste>
<strichliste ebene="2">
<listelem>
<symbol stellen="1">-</symbol>dem Büro</listelem>
</strichliste>
</liste>
<absatz typ="satz" widowctrl="1" keepwithnext="0" halign="j">übertragen wurden, sowie</absatz>
<liste>
<strichliste ebene="2">
<listelem>
<symbol stellen="1">-</symbol>jene Aufgaben, die nach § ... als Obliegenheiten gelten, die der Landesstelle durch den Vorstand übertragen wurden.</listelem>
</strichliste>
</liste>
<absatz typ="satz" halign="c">
