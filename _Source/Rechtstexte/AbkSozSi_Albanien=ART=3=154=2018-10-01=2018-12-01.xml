          <ueberschrift typ="para" halign="c" level="2">Artikel 3 <br/>Persönlicher Geltungsbereich</ueberschrift>
          
          <absatz typ="abs" widowctrl="1" keepwithnext="0" halign="j">
<gldsym>Artikel 3</gldsym>
</absatz><absatz typ="abs" halign="j">Dieses Abkommen gilt</absatz>
          <liste>
            <ziffernliste ebene="1">
              <listelem>
                <symbol stellen="2">1.</symbol>für Personen, für die die Rechtsvorschriften eines oder beider Vertragsstaaten gelten oder galten;</listelem>
              <listelem>
                <symbol stellen="2">2.</symbol>für andere Personen, soweit diese ihre Rechte von den in Ziffer 1 bezeichneten Personen ableiten.</listelem>
            </ziffernliste>
          </liste>
        </abschnitt>
