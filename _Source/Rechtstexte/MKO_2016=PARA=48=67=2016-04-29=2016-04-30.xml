      <nutzdaten>
        <abschnitt nr="1" typ="ns" paperf="h" endnhier="true">
          <ueberschrift typ="para" halign="c" level="3">Kostenzuschuss für Leistungen der medizinischen Hauskrankenpflege</ueberschrift>
          <absatz typ="abs" halign="j">
            <gldsym>§ 48.</gldsym> (1) Stellt der/die Versicherte einen Antrag auf einen Kostenzuschuss für Leistungen der medizinischen Hauskrankenpflege nach <rvolink abkrvo="MS 2016" verwart="d" typ="e" gldart="PARA" gldsort="70" gldnr="38" ziff="2" ursprung="u">§ 38 Z 2</rvolink> der Satzung, so hat er/sie der Kasse folgende Nachweise vorzulegen:</absatz>
          <liste>
            <ziffernliste ebene="1">
              <listelem>
                <symbol stellen="2">1.</symbol>Ärztliche Anordnung der medizinischen Hauskrankenpflege sowie deren Datum,</listelem>
              <listelem>
                <symbol stellen="2">2.</symbol>Diagnose,</listelem>
              <listelem>
                <symbol stellen="2">3.</symbol>Medizinische Begründung für die Durchführung der medizinischen Hauskrankenpflege,</listelem>
              <listelem>
                <symbol stellen="2">4.</symbol>Erbringung durch diplomiertes Pflegepersonal (Name),</listelem>
              <listelem>
                <symbol stellen="2">5.</symbol>Datum, Art und Dauer der durchgeführten medizinischen Leistungen und qualifizierten Pflegeleistungen in Minuten,</listelem>
              <listelem>
                <symbol stellen="2">6.</symbol>Bestätigung der Richtigkeit der Angaben durch das diplomierte Pflegepersonal.</listelem>
            </ziffernliste>
          </liste>
          <absatz typ="abs" halign="j">(2) <rvolink abkrvo="MKO 2016" verwart="d" typ="e" gldart="PARA" gldsort="70" gldnr="37" abs="1" ziff="1" ursprung="u">§§ 37 Abs.  1 Z 1 bis 6</rvolink> und <rvolink abkrvo="MKO 2016" verwart="d" typ="e" gldart="PARA" gldsort="70" gldnr="39" abs="1" ursprung="u">39 Abs. 1</rvolink>, <rvolink abkrvo="MKO 2016" verwart="d" typ="e" gldart="PARA" gldsort="70" gldnr="39" abs="2" ursprung="u">2</rvolink> und <rvolink abkrvo="MKO 2016" verwart="d" typ="e" gldart="PARA" gldsort="70" gldnr="39" abs="4" ursprung="u">4</rvolink> gelten sinngemäß.</absatz>
        </abschnitt>
      </nutzdaten>
