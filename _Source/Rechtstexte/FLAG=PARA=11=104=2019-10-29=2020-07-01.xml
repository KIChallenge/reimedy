<uebrecht><rvolink ursprung="u" abkrvo="FLAG" verwart="s" gldart="PARA" gldsort="70" gldnr="55" abs="28" lit="a" pubdat="2014-06-12" ikra="2014-06-13" puborg="BGBl." gldpuborg="I" nrpuborg="40" jahrgang="2014" typ="e">§ 55 Abs. 28 lit. a FLAG  idF 40/2014</rvolink></uebrecht><puborgane><puborgan puborg="BGBl." gldpuborg="I" nrpuborg="104" begseite="35" jahrgang="2019"/></puborgane></metadaten>
