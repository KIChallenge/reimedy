<nutzdaten>
<abschnitt>
<ueberschrift level="4" halign="c" typ="para">Zusatzrente für Schwerversehrte </ueberschrift>
<absatz typ="abs" halign="j">
<gldsym>§ 149f.</gldsym> (1) Schwerversehrten (<rvolink abkrvo="BSVG" gldnr="149e" abs="3" ursprung="p" gldart="PARA" verwart="d">§ 149e Abs. 3</rvolink>) gebührt eine Zusatzrente 
</absatz>
<liste>
<ziffernliste ebene="1">
<listelem>
<symbol>1.</symbol>bei einer unter 70% verminderten Erwerbsfähigkeit in der Höhe von 20%, 
</listelem>
<listelem>
<symbol>2.</symbol>bei einer um zumindest 70% verminderten Erwerbsfähigkeit in der Höhe von 50%  </listelem>
</ziffernliste>
<schluss typ="Abs">ihrer Betriebsrente.</schluss>
</liste>
<absatz typ="abs" halign="j">(2) Auf die Zusatzrente sind die Bestimmungen über die Betriebsrente entsprechend anzuwenden.  </absatz>
</abschnitt>
