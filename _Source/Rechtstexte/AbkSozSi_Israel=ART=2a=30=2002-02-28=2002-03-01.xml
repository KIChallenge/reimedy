<nutzdaten>
<abschnitt>
<ueberschrift level="2" halign="c" typ="para">Artikel 2a </ueberschrift>
<absatz typ="abs" halign="j">Artikel 2a 
</absatz>
<absatz typ="abs" halign="j">Dieses Abkommen gilt, soweit nichts anderes bestimmt wird,</absatz>
<liste>
<literaliste ebene="1">
<listelem>
<symbol stellen="2">a)</symbol>für Personen, für die die Rechtsvorschriften eines oder beider Vertragsstaaten gelten oder galten;</listelem>
<listelem>
<symbol stellen="2">b)</symbol>für andere Personen, soweit diese ihre Rechte von den in Buchstaben a bezeichneten Personen ableiten.</listelem>
</literaliste>
</liste>
</abschnitt>
