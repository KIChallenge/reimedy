      <nutzdaten>
        <abschnitt nr="1" typ="ns" paperf="h" endnhier="true">
          <ueberschrift typ="g1min" halign="c" level="1">ABSCHNITT I <br/>ALLGEMEINE BESTIMMUNGEN </ueberschrift>
          <ueberschrift typ="para" halign="c" level="2">Artikel 1 <br/>Begriffsbestimmungen</ueberschrift>
          <absatz typ="abs" halign="j">
            <gldsym>Art. 1</gldsym>
          </absatz><absatz typ="satz" halign="j">In dieser Vereinbarung:</absatz>
          <liste>
            <ziffernliste ebene="1">
              <listelem>
                <symbol stellen="2">1.</symbol>ist unter „Abkommen“ das am 5. September 2011 in Chisinau unterzeichnete Abkommen zwischen der Republik Österreich und der Republik Moldau über soziale Sicherheit zu verstehen;</listelem>
              <listelem>
                <symbol stellen="2">2.</symbol>werden die übrigen Ausdrücke in derselben Bedeutung verwendet, die ihnen im Abkommen gegeben wird.</listelem>
            </ziffernliste>
          </liste>
        </abschnitt>
